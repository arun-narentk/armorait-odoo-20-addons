<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dashboard_kpi_list" model="ir.ui.view">
        <field name="name">rn.dashboard.kpi.list</field>
        <field name="model">rn.dashboard.kpi</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key"/>
                <field name="domain"/>
                <field name="unit"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_rn_dashboard_kpi" model="ir.actions.act_window">
        <field name="name">KPI Catalog</field>
        <field name="res_model">rn.dashboard.kpi</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_dashboard_kpi_snapshot" model="ir.actions.act_window">
        <field name="name">KPI Snapshots</field>
        <field name="res_model">rn.dashboard.kpi.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_dashboard_export_form" model="ir.ui.view">
        <field name="name">rn.dashboard.export.wizard.form</field>
        <field name="model">rn.dashboard.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Snapshots">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="limit"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export CSV" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_dashboard_export" model="ir.actions.act_window">
        <field name="name">Export Snapshots</field>
        <field name="res_model">rn.dashboard.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
