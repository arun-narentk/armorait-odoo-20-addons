<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dashboard_filter_list" model="ir.ui.view">
        <field name="name">rn.dashboard.filter.list</field>
        <field name="model">rn.dashboard.filter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_preset"/>
                <field name="shift"/>
                <field name="plant"/>
                <field name="work_center"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_dashboard_filter_form" model="ir.ui.view">
        <field name="name">rn.dashboard.filter.form</field>
        <field name="model">rn.dashboard.filter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_preset"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="shift"/>
                        </group>
                        <group>
                            <field name="plant"/>
                            <field name="warehouse"/>
                            <field name="production_line"/>
                            <field name="work_center"/>
                            <field name="machine"/>
                            <field name="product"/>
                            <field name="category"/>
                            <field name="team"/>
                            <field name="operator"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_dashboard_filter" model="ir.actions.act_window">
        <field name="name">Filters</field>
        <field name="res_model">rn.dashboard.filter</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_dashboard_apply_filter_form" model="ir.ui.view">
        <field name="name">rn.dashboard.apply.filter.wizard.form</field>
        <field name="model">rn.dashboard.apply.filter.wizard</field>
        <field name="arch" type="xml">
            <form string="Open With Filter">
                <group>
                    <field name="dashboard_id"/>
                    <field name="filter_id"/>
                </group>
                <footer>
                    <button name="action_open" type="object" string="Open" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_dashboard_apply_filter" model="ir.actions.act_window">
        <field name="name">Open With Filter</field>
        <field name="res_model">rn.dashboard.apply.filter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
