<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dashboard_list" model="ir.ui.view">
        <field name="name">rn.dashboard.list</field>
        <field name="model">rn.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="dashboard_type"/>
                <field name="theme"/>
                <field name="is_tv_mode"/>
                <field name="refresh_interval"/>
                <field name="is_default"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_dashboard_form" model="ir.ui.view">
        <field name="name">rn.dashboard.form</field>
        <field name="model">rn.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_shell" type="object" string="Open Dashboard" class="btn-primary"/>
                    <button name="action_set_default" type="object" string="Set Default"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Dashboard name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="dashboard_type"/>
                            <field name="theme"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="refresh_interval"/>
                            <field name="is_tv_mode"/>
                            <field name="filter_id"/>
                            <field name="show_logo"/>
                            <field name="show_clock"/>
                            <field name="show_alerts"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Widgets">
                            <field name="widget_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="widget_type"/>
                                    <field name="kpi_key"/>
                                    <field name="size"/>
                                    <field name="color"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alert Rules">
                            <field name="alert_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="kpi_key"/>
                                    <field name="operator"/>
                                    <field name="threshold"/>
                                    <field name="severity"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                            <field name="public_token" groups="rn_dashboard_core.group_rn_dashboard_manager"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">rn.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_dashboard_shell" model="ir.actions.client">
        <field name="name">Live Board</field>
        <field name="tag">rn_dashboard_core.shell</field>
    </record>
</odoo>
