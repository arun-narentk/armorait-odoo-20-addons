<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dashboard_settings_form" model="ir.ui.view">
        <field name="name">rn.dashboard.settings.form</field>
        <field name="model">rn.dashboard.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="default_refresh_seconds"/>
                        <field name="tv_refresh_seconds"/>
                        <field name="cache_ttl_seconds"/>
                        <field name="enable_alerts"/>
                        <field name="enable_public_tv"/>
                        <field name="retention_days"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_dashboard_settings" model="ir.actions.act_window">
        <field name="name">Dashboard Settings</field>
        <field name="res_model">rn.dashboard.settings</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_dashboard_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">rn.dashboard.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_res_config_settings_rn_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="ARMORA Dashboard" name="rn_dashboard_core">
                    <block title="Refresh and Cache">
                        <setting string="Default Refresh (seconds)">
                            <field name="rn_dashboard_default_refresh"/>
                        </setting>
                        <setting string="Cache TTL (seconds)">
                            <field name="rn_dashboard_cache_ttl"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_rn_dashboard_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'rn_dashboard_core'}</field>
    </record>
</odoo>
