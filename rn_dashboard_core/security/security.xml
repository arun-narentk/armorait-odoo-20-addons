<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_dashboard">
        <field name="name">ARMORA Dashboard</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_dashboard_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dashboard_readonly'))]"/>
    </record>
    <record id="group_rn_dashboard_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dashboard_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
