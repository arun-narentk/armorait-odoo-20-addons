<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_rn_dashboard_cleanup" model="ir.cron">
        <field name="name">Dashboard Core: Cleanup KPI Snapshots</field>
        <field name="model_id" ref="model_rn_dashboard_scheduler_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_rn_dashboard_cache" model="ir.cron">
        <field name="name">Dashboard Core: Clear Cache</field>
        <field name="model_id" ref="model_rn_dashboard_scheduler_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_clear_cache()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
