<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_bookmarks.Sidebar">
        <Dropdown>
            <button class="o_rn_bookmarks_systray btn btn-link" title="Universal Bookmark">
                <i class="fa fa-star"/>
            </button>
            <t t-set-slot="content">
                <div class="o_rn_bookmarks_panel p-2" style="min-width: 320px; max-height: 70vh; overflow: auto;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <strong>Bookmarks</strong>
                        <button class="btn btn-sm btn-link" t-on-click="this.openDashboard">Open</button>
                    </div>
                    <input class="form-control form-control-sm mb-2" type="search"
                           placeholder="Search bookmarks"
                           t-model.proxy="this.state.search"
                           t-on-input="this.onSearch"/>
                    <div class="small text-muted mb-2" t-if="!this.state.loading">
                        <span t-out="this.state.stats.total"/> bookmarks |
                        <span t-out="this.state.stats.pinned"/> pinned |
                        <span t-out="this.state.stats.favorites"/> favorites
                    </div>
                    <div t-if="this.state.loading" class="text-muted small">Loading...</div>

                    <section t-if="this.state.pinned.length" class="mb-2">
                        <div class="fw-bold small text-uppercase">Pinned</div>
                        <t t-foreach="this.state.pinned" t-as="item" t-key="item.id">
                            <div t-att-class="this.bookmarkItemClass(item)"
                                 draggable="true"
                                 t-on-dragstart="(ev) => this.onDragStart(item, ev)"
                                 t-on-dragover="(ev) => this.onDragOver(item, ev)"
                                 t-on-dragleave="this.onDragLeave"
                                 t-on-drop="(ev) => this.onDrop(this.state.pinned, item, ev)"
                                 t-on-click="() => this.openBookmark(item.id)">
                                <i class="fa fa-thumb-tack text-warning"/>
                                <span class="flex-grow-1 text-truncate" t-out="item.name"/>
                            </div>
                        </t>
                    </section>

                    <section t-if="this.state.favorites.length" class="mb-2">
                        <div class="fw-bold small text-uppercase">Favorites</div>
                        <t t-foreach="this.state.favorites" t-as="item" t-key="item.id">
                            <div t-att-class="this.bookmarkItemClass(item)"
                                 draggable="true"
                                 t-on-dragstart="(ev) => this.onDragStart(item, ev)"
                                 t-on-dragover="(ev) => this.onDragOver(item, ev)"
                                 t-on-dragleave="this.onDragLeave"
                                 t-on-drop="(ev) => this.onDrop(this.state.favorites, item, ev)"
                                 t-on-click="() => this.openBookmark(item.id)">
                                <i class="fa fa-heart text-danger"/>
                                <span class="flex-grow-1 text-truncate" t-out="item.name"/>
                            </div>
                        </t>
                    </section>

                    <section t-if="this.state.recent.length" class="mb-2">
                        <div class="fw-bold small text-uppercase">Recent</div>
                        <t t-foreach="this.state.recent" t-as="item" t-key="item.id">
                            <div t-att-class="this.bookmarkItemClass(item)"
                                 t-on-click="() => this.openBookmark(item.id)">
                                <i class="fa fa-clock-o text-muted"/>
                                <span class="flex-grow-1 text-truncate" t-out="item.name"/>
                            </div>
                        </t>
                    </section>

                    <section t-foreach="this.state.folders" t-as="folder" t-key="folder.id" class="mb-2">
                        <div class="fw-bold small">
                            <i t-att-class="'fa ' + (folder.icon || 'fa-folder') + ' ' + this.colorClass(folder.color)"/>
                            <span class="ms-1" t-out="folder.name"/>
                        </div>
                        <t t-foreach="folder.bookmarks" t-as="item" t-key="item.id">
                            <div t-att-class="this.bookmarkItemClass(item) + ' ps-3'"
                                 draggable="true"
                                 t-on-dragstart="(ev) => this.onDragStart(item, ev)"
                                 t-on-dragover="(ev) => this.onDragOver(item, ev)"
                                 t-on-dragleave="this.onDragLeave"
                                 t-on-drop="(ev) => this.onDrop(folder.bookmarks, item, ev)"
                                 t-on-click="() => this.openBookmark(item.id)">
                                <i t-att-class="'fa fa-star ' + this.colorClass(item.color)"/>
                                <span class="flex-grow-1 text-truncate" t-out="item.name"/>
                            </div>
                        </t>
                    </section>

                    <section t-if="this.state.unfiled.length" class="mb-2">
                        <div class="fw-bold small text-uppercase">Unfiled</div>
                        <t t-foreach="this.state.unfiled" t-as="item" t-key="item.id">
                            <div t-att-class="this.bookmarkItemClass(item)"
                                 draggable="true"
                                 t-on-dragstart="(ev) => this.onDragStart(item, ev)"
                                 t-on-dragover="(ev) => this.onDragOver(item, ev)"
                                 t-on-dragleave="this.onDragLeave"
                                 t-on-drop="(ev) => this.onDrop(this.state.unfiled, item, ev)"
                                 t-on-click="() => this.openBookmark(item.id)">
                                <i class="fa fa-star-o me-1"/>
                                <span class="flex-grow-1 text-truncate" t-out="item.name"/>
                            </div>
                        </t>
                    </section>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
