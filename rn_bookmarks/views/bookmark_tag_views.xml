<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_bookmark_tag_list" model="ir.ui.view">
        <field name="name">rn.bookmark.tag.list</field>
        <field name="model">rn.bookmark.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="action_rn_bookmark_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">rn.bookmark.tag</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
</odoo>
