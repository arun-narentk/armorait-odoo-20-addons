<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_rn_bookmark" model="ir.ui.view">
        <field name="name">sale.order.form.rn.bookmark</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_rn_bookmarks" type="object" class="oe_stat_button" icon="fa-star"
                        invisible="rn_bookmark_count == 0">
                    <field name="rn_bookmark_count" widget="statinfo" string="Bookmarks"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="rn_is_bookmarked" invisible="1"/>
                <field name="rn_bookmark_count" invisible="1"/>
                <widget name="rn_bookmark_toggle"/>
            </xpath>
        </field>
    </record>

