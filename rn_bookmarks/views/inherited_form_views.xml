                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="rn_is_bookmarked" invisible="1"/>
                <field name="rn_bookmark_count" invisible="1"/>
                <widget name="rn_bookmark_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
