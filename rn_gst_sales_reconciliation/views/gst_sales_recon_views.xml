<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_sales_recon_view_list" model="ir.ui.view">
        <field name="name">rn.gst.sales.recon.list</field>
        <field name="model">rn.gst.sales.recon</field>
        <field name="arch" type="xml">
            <list string="Sales Reconciliations">
                <field name="name"/>
                <field name="gstin"/>
                <field name="financial_year"/>
                <field name="return_period"/>
                <field name="books_tax"/>
                <field name="ledger_tax"/>
                <field name="filed_tax" optional="show"/>
                <field name="error_count"/>
                <field name="open_count"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="rn_gst_sales_recon_view_form" model="ir.ui.view">
        <field name="name">rn.gst.sales.recon.form</field>
        <field name="model">rn.gst.sales.recon</field>
        <field name="arch" type="xml">
            <form string="Sales Reconciliation">
                <header>
                    <button name="action_run" type="object" string="Check Sales" class="btn-primary"/>
                    <button name="action_open_filing" type="object" string="Open Filed GSTR-1" invisible="not filing_ref"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="gstin"/>
                            <field name="financial_year" placeholder="2025-26"/>
                            <field name="return_period" placeholder="04"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="tolerance"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="books_taxable"/>
                            <field name="books_tax"/>
                            <field name="ledger_tax"/>
                            <field name="filing_ref"/>
                            <field name="filed_taxable" invisible="not filing_ref"/>
                            <field name="filed_tax" invisible="not filing_ref"/>
                            <field name="checked_at"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="false" decoration-danger="severity == 'error' and state == 'open'"
                              decoration-warning="severity == 'warning' and state == 'open'" decoration-muted="state != 'open'">
                            <field name="code" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="partner_id" readonly="1" optional="show"/>
                            <field name="message" readonly="1"/>
                            <field name="books_amount" readonly="1" optional="show"/>
                            <field name="other_amount" readonly="1" optional="show"/>
                            <field name="note"/>
                            <field name="severity" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge" readonly="1"/>
                            <button name="action_open_document" type="object" icon="fa-external-link" title="Open document"
                                    invisible="not move_id"/>
                            <button name="action_reviewed" type="object" string="Reviewed" invisible="state != 'open'"/>
                            <button name="action_ignore" type="object" string="Ignore" invisible="state != 'open'"/>
                            <button name="action_reopen" type="object" string="Reopen" invisible="state == 'open'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rn_gst_sales_recon_action" model="ir.actions.act_window">
        <field name="name">Sales Reconciliation</field>
        <field name="res_model">rn.gst.sales.recon</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Check a month of sales</p>
            <p>Pick the financial year and month, then "Check Sales": the ledger, the invoice numbers and the
               filed GSTR-1 are compared with your sales invoices.</p>
        </field>
    </record>
</odoo>
