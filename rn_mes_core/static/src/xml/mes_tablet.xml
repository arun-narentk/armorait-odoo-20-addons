<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_mes_core.Tablet">
        <div class="o_rn_mes_tablet o_action">
            <div class="o_rn_mes_tablet_header p-3 bg-primary text-white">
                <h2 class="mb-0">Shop Floor Tablet</h2>
                <small t-if="this.state.workorder.name">Job: <t t-out="this.state.workorder.name"/></small>
            </div>
            <div class="p-4" t-if="this.state.loading">Loading...</div>
            <div class="p-4" t-else="">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card p-3">
                            <div class="text-muted">Status</div>
                            <div class="fs-4" t-out="this.state.workorder.mes_state || 'pending'"/>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card p-3">
                            <div class="text-muted">Good Qty</div>
                            <div class="fs-4" t-out="this.formatQty(this.state.session.good_qty)"/>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card p-3">
                            <div class="text-muted">Scrap</div>
                            <div class="fs-4" t-out="this.formatQty(this.state.session.scrap_qty)"/>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Barcode</label>
                    <div class="input-group">
                        <input class="form-control form-control-lg" t-model.proxy="this.state.barcode" placeholder="Scan barcode"/>
                        <button class="btn btn-primary btn-lg" t-on-click="this.onScan">Scan</button>
                    </div>
                    <div class="text-success mt-2" t-if="this.state.message" t-out="this.state.message"/>
                </div>
                <h4>Pending Work Orders</h4>
                <ul class="list-group">
                    <li class="list-group-item" t-foreach="this.state.pending" t-as="wo" t-key="wo.id">
                        <strong t-out="wo.name"/> - <t t-out="wo.product"/> (<t t-out="wo.workcenter"/>)
                    </li>
                </ul>
            </div>
        </div>
    </t>
</templates>
