<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_mes_core.Dashboard">
        <div class="o_rn_mes_dashboard o_action p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">MES Plant Dashboard</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-3">
                    <div class="card p-3">
                        <div class="text-muted">Active Sessions</div>
                        <div class="fs-3" t-out="this.state.activeSessions"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card p-3">
                        <div class="text-muted">Open Downtime</div>
                        <div class="fs-3" t-out="this.state.openDowntime"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card p-3">
                        <div class="text-muted">OEE Today</div>
                        <div class="fs-3"><t t-out="this.formatNumber(this.state.oeeAvg)"/>%</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card p-3">
                        <div class="text-muted">Good / Scrap</div>
                        <div class="fs-5">
                            <t t-out="this.formatNumber(this.state.goodQty)"/> /
                            <t t-out="this.formatNumber(this.state.scrapQty)"/>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card p-3">
                        <div class="text-muted mb-2">Production Insight</div>
                        <p class="mb-0" t-out="this.state.aiSummary"/>
                        <small class="text-muted" t-if="this.state.updatedAt">Updated: <t t-out="this.state.updatedAt"/></small>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
