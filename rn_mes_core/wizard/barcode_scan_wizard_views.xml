<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_mes_barcode_wizard_form" model="ir.ui.view">
        <field name="name">rn.mes.barcode.scan.wizard.form</field>
        <field name="model">rn.mes.barcode.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Barcode Scan">
                <group>
                    <field name="barcode"/>
                    <field name="terminal_id"/>
                    <field name="session_id"/>
                    <field name="result_message" readonly="1"/>
                </group>
                <footer>
                    <button name="action_process" type="object" string="Process" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_mes_barcode_wizard" model="ir.actions.act_window">
        <field name="name">Barcode Scan</field>
        <field name="res_model">rn.mes.barcode.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
