<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_mes_downtime_reason_tree" model="ir.ui.view">
        <field name="name">rn.mes.downtime.reason.tree</field>
        <field name="model">rn.mes.downtime.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="loss_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_mes_downtime_event_tree" model="ir.ui.view">
        <field name="name">rn.mes.downtime.event.tree</field>
        <field name="model">rn.mes.downtime.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workcenter_id"/>
                <field name="reason_id"/>
                <field name="start_time"/>
                <field name="duration_minutes"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_mes_downtime_event_form" model="ir.ui.view">
        <field name="name">rn.mes.downtime.event.form</field>
        <field name="model">rn.mes.downtime.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="workcenter_id"/>
                        <field name="machine_id"/>
                        <field name="reason_id"/>
                        <field name="workorder_id"/>
                        <field name="operator_id"/>
                    </group>
                    <group>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="duration_minutes"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_mes_downtime" model="ir.actions.act_window">
        <field name="name">Downtime Events</field>
        <field name="res_model">rn.mes.downtime.event</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_mes_downtime_reason" model="ir.actions.act_window">
        <field name="name">Downtime Reasons</field>
        <field name="res_model">rn.mes.downtime.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
