<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_mes_session_tree" model="ir.ui.view">
        <field name="name">rn.mes.production.session.tree</field>
        <field name="model">rn.mes.production.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="terminal_id"/>
                <field name="operator_id"/>
                <field name="workorder_id"/>
                <field name="state"/>
                <field name="start_time"/>
                <field name="good_qty"/>
                <field name="scrap_qty"/>
            </list>
        </field>
    </record>
    <record id="view_rn_mes_session_form" model="ir.ui.view">
        <field name="name">rn.mes.production.session.form</field>
        <field name="model">rn.mes.production.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="terminal_id"/>
                        <field name="operator_id"/>
                        <field name="workorder_id"/>
                        <field name="workcenter_id"/>
                    </group>
                    <group>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="good_qty"/>
                        <field name="scrap_qty"/>
                        <field name="reject_qty"/>
                    </group>
                    <notebook>
                        <page string="Events">
                            <field name="event_ids">
                                <list>
                                    <field name="event_type"/>
                                    <field name="event_time"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scrap">
                            <field name="scrap_ids">
                                <list>
                                    <field name="scrap_type"/>
                                    <field name="quantity"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_mes_session" model="ir.actions.act_window">
        <field name="name">Production Sessions</field>
        <field name="res_model">rn.mes.production.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
