<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_mes_device_tree" model="ir.ui.view">
        <field name="name">rn.mes.machine.device.tree</field>
        <field name="model">rn.mes.machine.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="workcenter_id"/>
                <field name="protocol"/>
                <field name="status"/>
                <field name="last_signal"/>
            </list>
        </field>
    </record>
    <record id="view_rn_mes_device_form" model="ir.ui.view">
        <field name="name">rn.mes.machine.device.form</field>
        <field name="model">rn.mes.machine.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="workcenter_id"/>
                        <field name="protocol"/>
                        <field name="status"/>
                        <field name="last_signal"/>
                    </group>
                    <group>
                        <field name="gateway_url"/>
                        <field name="topic"/>
                        <field name="active"/>
                    </group>
                    <field name="reading_ids">
                        <list>
                            <field name="metric"/>
                            <field name="value_float"/>
                            <field name="value_text"/>
                            <field name="reading_time"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_mes_device" model="ir.actions.act_window">
        <field name="name">Machine Devices</field>
        <field name="res_model">rn.mes.machine.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
