<?xml version="1.0" encoding="utf-8"?>
<odoo>

<asset id="rn_theme_base.primary_variables_scss" name="Primary variables SCSS">
    <field name="key">rn_theme_base.primary_variables_scss</field>
    <bundle>web._assets_primary_variables</bundle>
    <path>rn_theme_base/static/src/scss/primary_variables.scss</path>
</asset>

<asset id="rn_theme_base.bootstrap_overridden_scss" name="Bootstrap overridden SCSS">
    <field name="key">rn_theme_base.bootstrap_overridden_scss</field>
    <bundle directive="prepend">web._assets_frontend_helpers</bundle>
    <path>rn_theme_base/static/src/scss/bootstrap_overridden.scss</path>
</asset>

<asset id="rn_theme_base.theme_scss" name="Theme SCSS">
    <field name="key">rn_theme_base.theme_scss</field>
    <bundle>web.assets_frontend</bundle>
    <path>rn_theme_base/static/src/scss/theme.scss</path>
</asset>

<asset id="rn_theme_base.theme_base_js" name="Theme Base JS">
    <field name="key">rn_theme_base.theme_base_js</field>
    <bundle>web.assets_frontend</bundle>
    <path>rn_theme_base/static/src/js/rn_theme_base.js</path>
</asset>

<asset id="rn_theme_base.mega_menu_js" name="Mega Menu JS">
    <field name="key">rn_theme_base.mega_menu_js</field>
    <bundle>web.assets_frontend</bundle>
    <path>rn_theme_base/static/src/js/mega_menu.js</path>
</asset>

<asset id="rn_theme_base.animations_js" name="Animations JS">
    <field name="key">rn_theme_base.animations_js</field>
    <bundle>web.assets_frontend</bundle>
    <path>rn_theme_base/static/src/js/animations.js</path>
</asset>

<asset id="rn_theme_base.customizer_js" name="Customizer JS">
    <field name="key">rn_theme_base.customizer_js</field>
    <bundle>web.assets_frontend</bundle>
    <path>rn_theme_base/static/src/js/customizer.js</path>
</asset>

</odoo>
