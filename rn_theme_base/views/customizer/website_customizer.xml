<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="res_config_settings_view_form_theme_base" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.theme_base</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//block[@id='website_info_settings']" position="after">
            <block title="ARMORAIT Theme Base" id="theme_base_settings">
                <setting string="Brand Colors" help="Colors applied as CSS variables on the frontend.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label class="col-lg-3" for="tb_primary_color">Primary</label>
                            <field name="tb_primary_color" widget="color"/>
                        </div>
                        <div class="row mt8">
                            <label class="col-lg-3" for="tb_secondary_color">Secondary</label>
                            <field name="tb_secondary_color" widget="color"/>
                        </div>
                        <div class="row mt8">
                            <label class="col-lg-3" for="tb_accent_color">Accent</label>
                            <field name="tb_accent_color" widget="color"/>
                        </div>
                    </div>
                </setting>
                <setting string="Typography" help="Google Font family names for headings and body text.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label class="col-lg-3" for="tb_heading_font">Heading Font</label>
                            <field name="tb_heading_font"/>
                        </div>
                        <div class="row mt8">
                            <label class="col-lg-3" for="tb_body_font">Body Font</label>
                            <field name="tb_body_font"/>
                        </div>
                    </div>
                </setting>
                <setting string="Layout and Motion">
                    <field name="tb_sticky_header"/>
                    <field name="tb_enable_animations"/>
                </setting>
                <setting string="WhatsApp" help="International number without plus sign.">
                    <field name="tb_whatsapp_number" placeholder="919876543210"/>
                </setting>
                <setting string="Emergency Banner">
                    <field name="tb_show_emergency_banner"/>
                    <field name="tb_emergency_banner_text" invisible="not tb_show_emergency_banner"/>
                </setting>
            </block>
        </xpath>
    </field>
</record>

<record id="view_website_form_theme_base" model="ir.ui.view">
    <field name="name">website.form.inherit.theme_base</field>
    <field name="model">website</field>
    <field name="inherit_id" ref="website.view_website_form"/>
    <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
            <page string="Theme Base" name="rn_theme_base">
                <group>
                    <group string="Colors">
                        <field name="tb_primary_color" widget="color"/>
                        <field name="tb_secondary_color" widget="color"/>
                        <field name="tb_accent_color" widget="color"/>
                    </group>
                    <group string="Fonts">
                        <field name="tb_heading_font"/>
                        <field name="tb_body_font"/>
                    </group>
                </group>
                <group>
                    <group string="Behavior">
                        <field name="tb_sticky_header"/>
                        <field name="tb_enable_animations"/>
                    </group>
                    <group string="Contact">
                        <field name="tb_whatsapp_number"/>
                        <field name="tb_show_emergency_banner"/>
                        <field name="tb_emergency_banner_text" invisible="not tb_show_emergency_banner"/>
                    </group>
                </group>
            </page>
        </xpath>
    </field>
</record>

</odoo>
