<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_tb_contact_form" name="Contact Form">
    <section class="s_tb_contact_form tb-snippet tb-reveal pt64 pb64" data-snippet="s_tb_contact_form">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 tb-reveal">
                    <h2>Contact Us</h2>
                    <p class="lead">We reply within one business day.</p>
                </div>
                <div class="col-lg-6 tb-reveal">
                    <form action="/website/form/" method="post" class="s_website_form" data-model_name="mail.mail">
                        <div class="mb-3"><input type="text" class="form-control" name="name" placeholder="Your Name" required="required"/></div>
                        <div class="mb-3"><input type="email" class="form-control" name="email_from" placeholder="Email" required="required"/></div>
                        <div class="mb-3"><textarea class="form-control" name="description" rows="4" placeholder="Message"/></div>
                        <button type="submit" class="btn btn-primary">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="oe_structure oe_empty"/>
    </section>
</template>

</odoo>
