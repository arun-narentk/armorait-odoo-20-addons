<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_record_share_wizard_form" model="ir.ui.view">
        <field name="name">rn.record.share.wizard.form</field>
        <field name="model">rn.record.share.wizard</field>
        <field name="arch" type="xml">
            <form string="Share Record">
                <group>
                    <field name="label"/>
                    <field name="internal_url" widget="url"/>
                    <field name="hash_url" widget="url"/>
                    <field name="qr_installed" invisible="1"/>
                </group>
                <notebook>
                    <page string="URL">
                        <field name="preview_url" nolabel="1"/>
                    </page>
                    <page string="Markdown">
                        <field name="preview_markdown" nolabel="1"/>
                    </page>
                    <page string="HTML">
                        <field name="preview_html" nolabel="1"/>
                    </page>
                    <page string="JSON">
                        <field name="preview_json" nolabel="1"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_copy_url" type="object" string="Copy URL" class="btn-primary"/>
                    <button name="action_copy_markdown" type="object" string="Copy Markdown"/>
                    <button name="action_copy_html" type="object" string="Copy HTML"/>
                    <button name="action_copy_json" type="object" string="Copy JSON"/>
                    <button name="action_email" type="object" string="Email"/>
                    <button name="action_whatsapp" type="object" string="WhatsApp"/>
                    <button name="action_open_link" type="object" string="Open Link"/>
                    <button name="action_generate_qr" type="object" string="Generate QR"
                            invisible="not qr_installed"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
