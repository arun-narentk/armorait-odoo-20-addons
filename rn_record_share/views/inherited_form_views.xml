<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_record_share" model="ir.ui.view">
        <field name="name">sale.order.form.record.share</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_copy_record_link" type="object"
                        class="oe_stat_button" icon="fa-clipboard"
                        groups="rn_record_share.group_rn_record_share_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Copy Link</span>
                    </div>
                </button>
                <button name="action_open_record_share" type="object"
                        class="oe_stat_button" icon="fa-share-alt"
                        groups="rn_record_share.group_rn_record_share_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Share</span>
                    </div>
                </button>
                <button name="action_open_record_qr" type="object"
                        class="oe_stat_button" icon="fa-qrcode"
                        groups="rn_record_share.group_rn_record_share_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QR</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

