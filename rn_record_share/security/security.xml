<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_record_share">
        <field name="name">ARMORA Record Share</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_record_share_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_record_share"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_record_share_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_record_share"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_record_share_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
