<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_qr_record_list" model="ir.ui.view">
        <field name="name">rn.qr.record.list</field>
        <field name="model">rn.qr.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="token"/>
                <field name="scan_count"/>
                <field name="expiration_datetime"/>
                <field name="is_expired"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_qr_record_form" model="ir.ui.view">
        <field name="name">rn.qr.record.form</field>
        <field name="model">rn.qr.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_document" type="object" string="Open Document" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="token"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="template_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="scan_count" readonly="1"/>
                            <field name="first_scanned_at" readonly="1"/>
                            <field name="last_scanned_at" readonly="1"/>
                            <field name="expiration_datetime"/>
                            <field name="is_expired" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="QR">
                        <field name="qr_url" readonly="1"/>
                        <field name="qr_image" widget="image"/>
                        <field name="qr_svg"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
