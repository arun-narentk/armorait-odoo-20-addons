<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rn_universal_qr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.universal.qr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Universal QR" name="rn_universal_qr" groups="rn_universal_qr.group_rn_universal_qr_manager">
                    <block title="Default QR Settings">
                        <setting string="Default Template">
                            <field name="rn_qr_default_template_id"/>
                        </setting>
                        <setting string="Default Expiration Days">
                            <field name="rn_qr_default_expiration_days"/>
                        </setting>
                        <setting string="Default Scan Action">
                            <field name="rn_qr_default_scan_action"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
