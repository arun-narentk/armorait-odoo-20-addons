<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rn_qr_record" model="ir.actions.act_window">
        <field name="name">QR Records</field>
        <field name="res_model">rn.qr.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_rn_qr_scan_log" model="ir.actions.act_window">
        <field name="name">Scan Logs</field>
        <field name="res_model">rn.qr.scan.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_rn_qr_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">rn.qr.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_rn_qr_model_config" model="ir.actions.act_window">
        <field name="name">Model Configuration</field>
        <field name="res_model">rn.qr.model.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_rn_qr_bulk_generate_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Generate QR</field>
        <field name="res_model">rn.qr.bulk.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_rn_universal_qr_root"
              name="Universal QR"
              sequence="58"
              groups="rn_universal_qr.group_rn_universal_qr_user"
              web_icon="rn_universal_qr,static/description/icon.png"/>

    <menuitem id="menu_rn_qr_records"
              name="QR Records"
              parent="menu_rn_universal_qr_root"
              action="action_rn_qr_record"
              sequence="10"/>

    <menuitem id="menu_rn_qr_scan_logs"
              name="Scan Logs"
              parent="menu_rn_universal_qr_root"
              action="action_rn_qr_scan_log"
              sequence="20"
              groups="rn_universal_qr.group_rn_universal_qr_manager"/>

    <menuitem id="menu_rn_qr_bulk_generate"
              name="Bulk Generate"
              parent="menu_rn_universal_qr_root"
              action="action_rn_qr_bulk_generate_wizard"
              sequence="30"/>

    <menuitem id="menu_rn_qr_configuration"
              name="Configuration"
              parent="menu_rn_universal_qr_root"
              sequence="90"
              groups="rn_universal_qr.group_rn_universal_qr_manager"/>

    <menuitem id="menu_rn_qr_templates"
              name="Templates"
              parent="menu_rn_qr_configuration"
              action="action_rn_qr_template"
              sequence="10"/>

    <menuitem id="menu_rn_qr_model_config"
              name="Models"
              parent="menu_rn_qr_configuration"
              action="action_rn_qr_model_config"
              sequence="20"/>
</odoo>
