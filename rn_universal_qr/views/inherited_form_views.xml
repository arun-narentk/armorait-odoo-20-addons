<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_rn_qr" model="ir.ui.view">
        <field name="name">sale.order.form.rn.qr</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="QR">
                    <field name="rn_qr_token" readonly="1"/>
                    <field name="rn_qr_scan_count" readonly="1"/>
                    <field name="rn_qr_image" widget="image"/>
                    <button name="action_generate_qr" type="object" string="Generate QR" class="btn-primary"/>
                </group>
            </xpath>
        </field>
    </record>

