<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rn_whatsapp_send_wizard_form" model="ir.ui.view">
        <field name="name">rn.whatsapp.send.message.wizard.form</field>
        <field name="model">rn.whatsapp.send.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="account_id"/>
                    <field name="partner_id"/>
                    <field name="phone"/>
                    <field name="template_id"/>
                    <field name="send_immediately"/>
                    <field name="body"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Queue Message" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rn_whatsapp_send_wizard" model="ir.actions.act_window">
        <field name="name">Send WhatsApp</field>
        <field name="res_model">rn.whatsapp.send.message.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
