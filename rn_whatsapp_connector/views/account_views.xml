<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_whatsapp_account_list" model="ir.ui.view">
        <field name="name">rn.whatsapp.account.list</field>
        <field name="model">rn.whatsapp.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider"/>
                <field name="phone_number"/>
                <field name="is_default"/>
                <field name="simulation_mode"/>
                <field name="status"/>
                <field name="connection_state"/>
                <field name="messages_today"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_whatsapp_account_form" model="ir.ui.view">
        <field name="name">rn.whatsapp.account.form</field>
        <field name="model">rn.whatsapp.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                    <button name="action_set_default" type="object" string="Set Default"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_messages" icon="fa-whatsapp">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider"/>
                            <field name="phone_number"/>
                            <field name="phone_number_id"/>
                            <field name="business_id"/>
                            <field name="is_default"/>
                            <field name="simulation_mode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="api_url"/>
                            <field name="api_version"/>
                            <field name="access_token" password="True"/>
                            <field name="webhook_token" password="True"/>
                            <field name="webhook_verify_token" password="True"/>
                            <field name="connection_state"/>
                            <field name="phone_quality_rating"/>
                            <field name="daily_limit"/>
                            <field name="messages_today"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Templates">
                            <field name="template_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="language"/>
                                    <field name="approved"/>
                                    <field name="category"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">rn.whatsapp.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
