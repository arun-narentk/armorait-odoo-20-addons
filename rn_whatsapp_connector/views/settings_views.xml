<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_rn_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="WhatsApp Connector" name="rn_whatsapp_connector" groups="rn_whatsapp_connector.group_rn_whatsapp_admin">
                    <block title="General">
                        <setting string="Enable WhatsApp Connector" help="Turn on WhatsApp messaging features.">
                            <field name="rn_whatsapp_enabled"/>
                        </setting>
                        <setting string="Default Account">
                            <field name="rn_whatsapp_default_account_id"/>
                        </setting>
                    </block>
                    <block title="API">
                        <setting string="Timeout">
                            <field name="rn_whatsapp_timeout"/>
                        </setting>
                        <setting string="Max Retries">
                            <field name="rn_whatsapp_max_retries"/>
                        </setting>
                        <setting string="Rate Limit">
                            <field name="rn_whatsapp_rate_limit"/>
                        </setting>
                        <setting string="Debug Mode">
                            <field name="rn_whatsapp_debug_mode"/>
                        </setting>
                    </block>
                    <block title="Attachments">
                        <setting string="Max Attachment Size (MB)">
                            <field name="rn_whatsapp_max_attachment_mb"/>
                        </setting>
                        <setting string="Allowed Extensions">
                            <field name="rn_whatsapp_allowed_extensions"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_rn_whatsapp_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'rn_whatsapp_connector'}</field>
    </record>

</odoo>
