<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rn_whatsapp_webhook_list" model="ir.ui.view">
        <field name="name">rn.whatsapp.webhook.list</field>
        <field name="model">rn.whatsapp.webhook</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="account_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_rn_whatsapp_webhook_form" model="ir.ui.view">
        <field name="name">rn.whatsapp.webhook.form</field>
        <field name="model">rn.whatsapp.webhook</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="provider"/>
                        <field name="account_id"/>
                        <field name="status"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="headers"/>
                        <field name="payload"/>
                        <field name="response"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_whatsapp_webhook" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">rn.whatsapp.webhook</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_whatsapp_history_list" model="ir.ui.view">
        <field name="name">rn.whatsapp.history.list</field>
        <field name="model">rn.whatsapp.history</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="message_id"/>
                <field name="event_type"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_rn_whatsapp_history" model="ir.actions.act_window">
        <field name="name">Message History</field>
        <field name="res_model">rn.whatsapp.history</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
