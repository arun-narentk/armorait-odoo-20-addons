<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rn_whatsapp_template_list" model="ir.ui.view">
        <field name="name">rn.whatsapp.template.list</field>
        <field name="model">rn.whatsapp.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id"/>
                <field name="language"/>
                <field name="category"/>
                <field name="approved"/>
                <field name="provider_template_id"/>
            </list>
        </field>
    </record>

    <record id="view_rn_whatsapp_template_form" model="ir.ui.view">
        <field name="name">rn.whatsapp.template.form</field>
        <field name="model">rn.whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="language"/>
                            <field name="category"/>
                            <field name="approved"/>
                            <field name="provider_template_id"/>
                            <field name="media_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="header"/>
                            <field name="footer"/>
                            <field name="variable_ids"/>
                            <field name="button_json"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="body" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rn_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">rn.whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
