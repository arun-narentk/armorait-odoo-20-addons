<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_rn_whatsapp_retry_failed" model="ir.cron">
            <field name="name">WhatsApp: Retry Failed Messages</field>
            <field name="model_id" ref="model_rn_whatsapp_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failed_messages()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rn_whatsapp_scheduled_send" model="ir.cron">
            <field name="name">WhatsApp: Send Scheduled Messages</field>
            <field name="model_id" ref="model_rn_whatsapp_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_scheduled_messages()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rn_whatsapp_webhook_cleanup" model="ir.cron">
            <field name="name">WhatsApp: Webhook Cleanup</field>
            <field name="model_id" ref="model_rn_whatsapp_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_webhooks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rn_whatsapp_provider_sync" model="ir.cron">
            <field name="name">WhatsApp: Sync Provider Status</field>
            <field name="model_id" ref="model_rn_whatsapp_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_provider_status()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
