<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="data_rn_whatsapp_account_default" model="rn.whatsapp.account">
        <field name="name">Default Meta Cloud (Simulation)</field>
        <field name="provider">meta_cloud</field>
        <field name="phone_number">+10000000000</field>
        <field name="simulation_mode" eval="True"/>
        <field name="is_default" eval="True"/>
        <field name="status">connected</field>
        <field name="connection_state">online</field>
    </record>
    <record id="data_rn_whatsapp_template_order" model="rn.whatsapp.template">
        <field name="name">order_confirmed</field>
        <field name="account_id" ref="data_rn_whatsapp_account_default"/>
        <field name="provider_template_id">order_confirmed</field>
        <field name="body">Hello {{partner}}, your order {{name}} is confirmed. Thank you!</field>
        <field name="variable_ids">partner,name</field>
        <field name="category">utility</field>
        <field name="approved" eval="True"/>
    </record>
    <record id="data_rn_whatsapp_template_invoice" model="rn.whatsapp.template">
        <field name="name">invoice_posted</field>
        <field name="account_id" ref="data_rn_whatsapp_account_default"/>
        <field name="provider_template_id">invoice_posted</field>
        <field name="body">Hello {{partner}}, invoice {{name}} is ready. Amount: {{amount_total}}</field>
        <field name="variable_ids">partner,name,amount_total</field>
        <field name="category">utility</field>
        <field name="approved" eval="True"/>
    </record>
    <record id="data_rn_whatsapp_template_delivery" model="rn.whatsapp.template">
        <field name="name">delivery_done</field>
        <field name="account_id" ref="data_rn_whatsapp_account_default"/>
        <field name="provider_template_id">delivery_done</field>
        <field name="body">Hello {{partner}}, delivery {{name}} is completed.</field>
        <field name="variable_ids">partner,name</field>
        <field name="category">utility</field>
        <field name="approved" eval="True"/>
    </record>
    <record id="data_rn_whatsapp_rule_sale" model="rn.whatsapp.automation.rule">
        <field name="name">Sale Order Confirmed</field>
        <field name="trigger">sale_order_confirmed</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="account_id" ref="data_rn_whatsapp_account_default"/>
        <field name="template_id" ref="data_rn_whatsapp_template_order"/>
        <field name="phone_field">partner_id.mobile</field>
        <field name="active" eval="True"/>
    </record>
    <record id="data_rn_whatsapp_rule_invoice" model="rn.whatsapp.automation.rule">
        <field name="name">Invoice Posted</field>
        <field name="trigger">invoice_posted</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="account_id" ref="data_rn_whatsapp_account_default"/>
        <field name="template_id" ref="data_rn_whatsapp_template_invoice"/>
        <field name="phone_field">partner_id.mobile</field>
        <field name="active" eval="True"/>
    </record>
    <record id="data_rn_whatsapp_rule_delivery" model="rn.whatsapp.automation.rule">
        <field name="name">Delivery Completed</field>
        <field name="trigger">delivery_completed</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="account_id" ref="data_rn_whatsapp_account_default"/>
        <field name="template_id" ref="data_rn_whatsapp_template_delivery"/>
        <field name="phone_field">partner_id.mobile</field>
        <field name="active" eval="True"/>
    </record>
    <record id="data_rn_whatsapp_subscription_trial" model="rn.whatsapp.subscription">
        <field name="name">Professional Trial</field>
        <field name="plan">professional</field>
        <field name="state">trial</field>
        <field name="list_price">79.99</field>
    </record>
</data>
</odoo>
