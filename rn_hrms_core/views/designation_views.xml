<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hrms_designation_list" model="ir.ui.view">
        <field name="name">rn.hrms.designation.list</field>
        <field name="model">rn.hrms.designation</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hrms_designation_form" model="ir.ui.view">
        <field name="name">rn.hrms.designation.form</field>
        <field name="model">rn.hrms.designation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="department_id"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_hrms_designation" model="ir.actions.act_window">
        <field name="name">Designations</field>
        <field name="res_model">rn.hrms.designation</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_hrms_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">rn.hrms.skill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
