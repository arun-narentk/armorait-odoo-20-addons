<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hrms_approval_list" model="ir.ui.view">
        <field name="name">rn.hrms.approval.list</field>
        <field name="model">rn.hrms.approval</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_type"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="request_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hrms_approval_form" model="ir.ui.view">
        <field name="name">rn.hrms.approval.form</field>
        <field name="model">rn.hrms.approval</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="request_type"/>
                        <field name="employee_id"/>
                        <field name="manager_id"/>
                        <field name="request_date"/>
                        <field name="summary"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hrms_approval" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">rn.hrms.approval</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_hrms_approval_action_wizard_form" model="ir.ui.view">
        <field name="name">rn.hrms.approval.action.wizard.form</field>
        <field name="model">rn.hrms.approval.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Decision">
                <group>
                    <field name="approval_ids" widget="many2many_tags"/>
                    <field name="action"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
