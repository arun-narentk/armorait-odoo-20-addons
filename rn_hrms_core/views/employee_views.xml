<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_rn_hrms" model="ir.ui.view">
        <field name="name">hr.employee.form.rn.hrms</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="ARMORA HRMS" groups="rn_hrms_core.group_rn_hrms_officer">
                    <field name="rn_hrms_employee_code"/>
                    <field name="rn_hrms_branch_id"/>
                    <field name="rn_hrms_designation_id"/>
                    <field name="rn_hrms_employment_type"/>
                    <field name="rn_hrms_joining_date"/>
                    <field name="rn_hrms_confirmation_date"/>
                    <field name="rn_hrms_resignation_date"/>
                    <field name="rn_hrms_emergency_contact"/>
                    <field name="rn_hrms_emergency_phone"/>
                    <field name="rn_hrms_skill_ids" widget="many2many_tags"/>
                    <field name="rn_hrms_onboarded"/>
                </group>
                <field name="rn_hrms_document_ids" groups="rn_hrms_core.group_rn_hrms_officer">
                    <list editable="bottom">
                        <field name="name"/>
                        <field name="document_type"/>
                        <field name="expiry_date"/>
                        <field name="is_private"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="view_rn_hrms_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">rn.hrms.employee.onboarding.wizard.form</field>
        <field name="model">rn.hrms.employee.onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Onboarding">
                <group>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="branch_id"/>
                    <field name="designation_id"/>
                </group>
                <footer>
                    <button name="action_onboard" type="object" string="Onboard" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_hrms_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Onboard Employees</field>
        <field name="res_model">rn.hrms.employee.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
