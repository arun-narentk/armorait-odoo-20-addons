<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hrms_document_list" model="ir.ui.view">
        <field name="name">rn.hrms.document.list</field>
        <field name="model">rn.hrms.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_type"/>
                <field name="employee_id"/>
                <field name="expiry_date"/>
                <field name="is_private"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hrms_document_form" model="ir.ui.view">
        <field name="name">rn.hrms.document.form</field>
        <field name="model">rn.hrms.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="document_type"/>
                        <field name="employee_id"/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                        <field name="expiry_date"/>
                        <field name="is_private"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hrms_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">rn.hrms.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
