<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hrms_branch_list" model="ir.ui.view">
        <field name="name">rn.hrms.branch.list</field>
        <field name="model">rn.hrms.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hrms_branch_form" model="ir.ui.view">
        <field name="name">rn.hrms.branch.form</field>
        <field name="model">rn.hrms.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="partner_id"/>
                        <field name="manager_id"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_hrms_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">rn.hrms.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
