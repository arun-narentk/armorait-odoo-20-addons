<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_hrms">
        <field name="name">ARMORA HRMS</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_rn_hrms_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hrms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_hrms_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hrms"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hrms_readonly'))]"/>
    </record>
    <record id="group_rn_hrms_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hrms"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hrms_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
