<odoo>
    <record id="res_groups_privilege_armora_gst_2b_reconciliation" model="res.groups.privilege">
        <field name="name">GSTR-2B</field>
        <field name="category_id" ref="armora_gst_base.module_category_armora_gst"/>
    </record>

    <record id="group_armora_gst_2b_user" model="res.groups">
        <field name="name">GSTR-2B User</field>
        <field name="privilege_id" ref="res_groups_privilege_armora_gst_2b_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('armora_gst_base.group_armora_gst_user'))]"/>
    </record>

    <record id="group_armora_gst_2b_manager" model="res.groups">
        <field name="name">GSTR-2B Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_armora_gst_2b_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('group_armora_gst_2b_user')), (4, ref('armora_gst_base.group_armora_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
