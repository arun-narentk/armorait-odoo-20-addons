<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_armora_gst_2b_res_config_settings" model="ir.ui.view">
        <field name="name">armora.gst.2b.res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="armora_gst_base.view_armora_gst_base_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='armora_gst_base_settings']" position="inside">
                <setting string="GSTR-2B Amount Tolerance" help="Absolute difference allowed before a 2B vs bill match is treated as a mismatch.">
                    <field name="armora_gst_2b_amount_tolerance"/>
                </setting>
                <setting string="GSTR-2B Date Tolerance (Days)" help="Allowed invoice date difference when matching GSTR-2B to vendor bills.">
                    <field name="armora_gst_2b_date_tolerance_days"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
