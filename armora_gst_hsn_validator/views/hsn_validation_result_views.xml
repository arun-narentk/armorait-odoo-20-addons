<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_armora_gst_hsn_validation_result_list" model="ir.ui.view">
        <field name="name">armora.gst.hsn.validation.result.list</field>
        <field name="model">armora.gst.hsn.validation.result</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_armora_gst_hsn_validation_result_form" model="ir.ui.view">
        <field name="name">armora.gst.hsn.validation.result.form</field>
        <field name="model">armora.gst.hsn.validation.result</field>
        <field name="arch" type="xml">
            <form string="HSN/SAC Validation Result">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Domain fields (source, HSN/SAC code, status, severity, rule) are added in the next implementation step.
                        Format validation must never be presented as government approval.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_armora_gst_hsn_validation_result_search" model="ir.ui.view">
        <field name="name">armora.gst.hsn.validation.result.search</field>
        <field name="model">armora.gst.hsn.validation.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_armora_gst_hsn_validation_result" model="ir.actions.act_window">
        <field name="name">Validation Results</field>
        <field name="res_model">armora.gst.hsn.validation.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
