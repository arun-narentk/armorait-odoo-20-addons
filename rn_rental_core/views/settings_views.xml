<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_rental_settings_form" model="ir.ui.view">
        <field name="name">rn.rental.settings.form</field>
        <field name="model">rn.rental.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="default_plan"/>
                        <field name="default_deposit_pct"/>
                        <field name="allow_overlap_block"/>
                        <field name="enable_email"/>
                        <field name="timezone"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_rental_settings" model="ir.actions.act_window">
        <field name="name">Rental Settings</field>
        <field name="res_model">rn.rental.settings</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_rental_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">rn.rental.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="res_config_settings_view_form_rn_rental" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.rental</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="ARMORA Rental" name="rn_rental_core" groups="rn_rental_core.group_rn_rental_manager">
                    <block title="General">
                        <setting string="Enable Rental Core"><field name="rn_rental_enabled"/></setting>
                        <setting string="Default Plan"><field name="rn_rental_default_plan"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_rn_rental_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'rn_rental_core'}</field>
    </record>
</odoo>
