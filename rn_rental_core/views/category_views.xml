<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_rental_category_list" model="ir.ui.view">
        <field name="name">rn.rental.category.list</field>
        <field name="model">rn.rental.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_rental_category_form" model="ir.ui.view">
        <field name="name">rn.rental.category.form</field>
        <field name="model">rn.rental.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_rental_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">rn.rental.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
