<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_rental_asset_list" model="ir.ui.view">
        <field name="name">rn.rental.asset.list</field>
        <field name="model">rn.rental.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="daily_price"/>
                <field name="state"/>
                <field name="location"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_rental_asset_form" model="ir.ui.view">
        <field name="name">rn.rental.asset.form</field>
        <field name="model">rn.rental.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_available" type="object" string="Available" invisible="state == 'available'"/>
                    <button name="action_set_maintenance" type="object" string="Maintenance" invisible="state == 'maintenance'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,booked,in_use,maintenance"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="product_id"/>
                            <field name="barcode"/>
                            <field name="serial_number"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="owner_id"/>
                            <field name="replacement_cost"/>
                            <field name="deposit_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="List Prices">
                        <field name="hourly_price"/>
                        <field name="half_day_price"/>
                        <field name="daily_price"/>
                        <field name="weekly_price"/>
                        <field name="monthly_price"/>
                        <field name="yearly_price"/>
                    </group>
                    <field name="pricing_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="plan"/>
                            <field name="amount"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </list>
                    </field>
                    <group>
                        <field name="specifications"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_rental_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">rn.rental.asset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
