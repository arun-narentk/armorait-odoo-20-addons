<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_customer_engagement_channel_tree" model="ir.ui.view">
        <field name="name">rn.customer.engagement.channel.tree</field>
        <field name="model">rn.customer.engagement.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="authentication_mode"/>
                <field name="status" widget="badge"/>
                <field name="session_count"/>
            </list>
        </field>
    </record>
    <record id="view_rn_customer_engagement_channel_form" model="ir.ui.view">
        <field name="name">rn.customer.engagement.channel.form</field>
        <field name="model">rn.customer.engagement.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="channel_type"/>
                        <field name="authentication_mode"/>
                        <field name="status"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_customer_engagement_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">rn.customer.engagement.channel</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
