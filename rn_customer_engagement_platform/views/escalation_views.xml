<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_customer_engagement_escalation_tree" model="ir.ui.view">
        <field name="name">rn.customer.engagement.escalation.tree</field>
        <field name="model">rn.customer.engagement.escalation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category"/>
                <field name="state" widget="badge"/>
                <field name="assigned_user_id"/>
            </list>
        </field>
    </record>
    <record id="view_rn_customer_engagement_escalation_form" model="ir.ui.view">
        <field name="name">rn.customer.engagement.escalation.form</field>
        <field name="model">rn.customer.engagement.escalation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="conversation_id"/>
                        <field name="partner_id"/>
                        <field name="category"/>
                        <field name="state"/>
                        <field name="assigned_user_id"/>
                    </group>
                    <field name="summary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_customer_engagement_escalation" model="ir.actions.act_window">
        <field name="name">Escalations</field>
        <field name="res_model">rn.customer.engagement.escalation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
