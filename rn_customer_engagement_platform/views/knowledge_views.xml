<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_customer_engagement_knowledge_tree" model="ir.ui.view">
        <field name="name">rn.customer.engagement.knowledge.tree</field>
        <field name="model">rn.customer.engagement.knowledge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="keyword_hint"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_customer_engagement_knowledge_form" model="ir.ui.view">
        <field name="name">rn.customer.engagement.knowledge.form</field>
        <field name="model">rn.customer.engagement.knowledge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="keyword_hint"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_customer_engagement_knowledge" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field>
        <field name="res_model">rn.customer.engagement.knowledge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
