<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_customer_engagement_platform">
        <field name="name">Customer Engagement Platform</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_rn_customer_engagement_user" model="res.groups">
        <field name="name">Customer Engagement User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_engagement_platform"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_customer_engagement_manager" model="res.groups">
        <field name="name">Customer Engagement Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_engagement_platform"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_customer_engagement_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
