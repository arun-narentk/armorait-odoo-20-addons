<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_field_diff.DiffViewerDialog">
        <Dialog title="this.props.title or 'Field Differences'" size="'lg'">
            <div class="rn-field-diff-viewer p-3">
                <t t-if="this.state.loading">
                    <p>Loading changes...</p>
                </t>
                <t t-else="">
                    <div class="rn-field-diff-summary mb-3" t-if="this.state.summary.total">
                        <strong><t t-out="this.state.summary.total"/> fields changed</strong>
                        <span class="ms-2 text-muted">
                            <t t-if="this.state.summary.numeric"><t t-out="this.state.summary.numeric"/> numeric</t>
                            <t t-if="this.state.summary.date"> | <t t-out="this.state.summary.date"/> dates</t>
                            <t t-if="this.state.summary.text"> | <t t-out="this.state.summary.text"/> text</t>
                        </span>
                    </div>
                    <t t-foreach="this.state.diffs" t-as="diff" t-key="diff.id">
                        <div t-attf-class="rn-field-diff-card rn-field-diff--{{diff.color_class}} mb-3 p-3 border rounded">
                            <div class="fw-bold mb-2"><t t-out="diff.field_label"/></div>
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="text-muted small">Before</div>
                                    <div><t t-out="diff.old_value or '-'"/></div>
                                </div>
                                <div class="col-md-2 text-center align-self-center">&#8595;</div>
                                <div class="col-md-5">
                                    <div class="text-muted small">After</div>
                                    <div><t t-out="diff.new_value or '-'"/></div>
                                </div>
                            </div>
                            <div class="mt-2 text-primary" t-if="diff.difference">
                                Difference: <t t-out="diff.difference"/>
                            </div>
                            <div class="mt-1 small text-muted">
                                <t t-out="diff.user"/> | <t t-out="diff.changed_on"/>
                            </div>
                        </div>
                    </t>
                    <p t-if="!this.state.diffs.length" class="text-muted">No tracked field changes yet.</p>
                </t>
            </div>
        </Dialog>
    </t>
</templates>
