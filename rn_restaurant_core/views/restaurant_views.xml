<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_restaurant_list" model="ir.ui.view">
        <field name="name">rn.restaurant.list</field>
        <field name="model">rn.restaurant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="cuisine_type"/>
                <field name="branch_count"/>
                <field name="table_count"/>
                <field name="item_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_restaurant_form" model="ir.ui.view">
        <field name="name">rn.restaurant.form</field>
        <field name="model">rn.restaurant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_branches" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="branch_count" widget="statinfo" string="Branches"/>
                        </button>
                        <button name="action_view_tables" type="object" class="oe_stat_button" icon="fa-th">
                            <field name="table_count" widget="statinfo" string="Tables"/>
                        </button>
                        <button name="action_view_menu_items" type="object" class="oe_stat_button" icon="fa-cutlery">
                            <field name="item_count" widget="statinfo" string="Menu"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Restaurant name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="cuisine_type"/>
                            <field name="partner_id"/>
                            <field name="timezone"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Branches">
                            <field name="branch_ids"/>
                        </page>
                        <page string="Taxes">
                            <field name="tax_ids"/>
                        </page>
                        <page string="Payment Methods">
                            <field name="payment_method_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_restaurant" model="ir.actions.act_window">
        <field name="name">Restaurants</field>
        <field name="res_model">rn.restaurant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
