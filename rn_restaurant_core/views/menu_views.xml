<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_restaurant_menu_category_list" model="ir.ui.view">
        <field name="name">rn.restaurant.menu.category.list</field>
        <field name="model">rn.restaurant.menu.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="restaurant_id"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>
    <record id="action_rn_restaurant_menu_category" model="ir.actions.act_window">
        <field name="name">Menu Categories</field>
        <field name="res_model">rn.restaurant.menu.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_restaurant_menu_item_list" model="ir.ui.view">
        <field name="name">rn.restaurant.menu.item.list</field>
        <field name="model">rn.restaurant.menu.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="list_price"/>
                <field name="kitchen_station"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_restaurant_menu_item_kanban" model="ir.ui.view">
        <field name="name">rn.restaurant.menu.item.kanban</field>
        <field name="model">rn.restaurant.menu.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="list_price"/>
                <field name="state"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <field name="image_1920" widget="image" options="{'size': [120, 90]}"/>
                            <strong><field name="name"/></strong>
                            <div><field name="list_price"/></div>
                            <div><field name="state"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_rn_restaurant_menu_item_form" model="ir.ui.view">
        <field name="name">rn.restaurant.menu.item.form</field>
        <field name="model">rn.restaurant.menu.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_available" type="object" string="Available" invisible="state == 'available'"/>
                    <button name="action_mark_out" type="object" string="Out of Stock"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="restaurant_id"/>
                            <field name="category_id"/>
                            <field name="product_id"/>
                            <field name="barcode"/>
                            <field name="list_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="kitchen_station"/>
                            <field name="preparation_minutes"/>
                            <field name="is_veg"/>
                            <field name="is_vegan"/>
                            <field name="spice_level"/>
                            <field name="available_dine_in"/>
                            <field name="available_takeaway"/>
                            <field name="available_delivery"/>
                            <field name="available_online"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_restaurant_menu_item" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">rn.restaurant.menu.item</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
