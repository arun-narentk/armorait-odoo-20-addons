<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_restaurant">
        <field name="name">ARMORA Restaurant</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_rn_restaurant_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_restaurant"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_restaurant_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_restaurant"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_restaurant_readonly'))]"/>
    </record>
    <record id="group_rn_restaurant_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_restaurant"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_restaurant_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
