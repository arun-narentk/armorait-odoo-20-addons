<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="config_rn_rn_ai_employee_enabled" model="ir.config_parameter">
        <field name="key">rn_ai_employee.enabled</field>
        <field name="value">False</field>
    </record>
    <record id="config_rn_rn_ai_employee_provider" model="ir.config_parameter">
        <field name="key">rn_ai_employee.provider</field>
        <field name="value">openai</field>
    </record>
    <record id="config_rn_rn_ai_employee_api_url" model="ir.config_parameter">
        <field name="key">rn_ai_employee.api_url</field>
        <field name="value">https://api.openai.com/v1/chat/completions</field>
    </record>
    <record id="config_rn_rn_ai_employee_model" model="ir.config_parameter">
        <field name="key">rn_ai_employee.model</field>
        <field name="value">gpt-4o-mini</field>
    </record>
    <record id="config_rn_rn_ai_employee_temperature" model="ir.config_parameter">
        <field name="key">rn_ai_employee.temperature</field>
        <field name="value">0.2</field>
    </record>
    <record id="config_rn_rn_ai_employee_use_llm" model="ir.config_parameter">
        <field name="key">rn_ai_employee.use_llm</field>
        <field name="value">True</field>
    </record>
    <record id="config_rn_rn_ai_employee_require_write_confirmation" model="ir.config_parameter">
        <field name="key">rn_ai_employee.require_write_confirmation</field>
        <field name="value">True</field>
    </record>
    <record id="config_rn_rn_ai_employee_morning_briefing_enabled" model="ir.config_parameter">
        <field name="key">rn_ai_employee.morning_briefing_enabled</field>
        <field name="value">False</field>
    </record>
</odoo>
