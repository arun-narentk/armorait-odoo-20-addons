<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="tool_today_sales" model="rn.ai.employee.tool">
        <field name="name">Today's Sales</field>
        <field name="model_name">today_sales</field>
        <field name="description">Show confirmed sales orders and revenue for today.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_pending_quotations" model="rn.ai.employee.tool">
        <field name="name">Pending Quotations</field>
        <field name="model_name">pending_quotations</field>
        <field name="description">List quotations waiting for confirmation.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_lost_quotations" model="rn.ai.employee.tool">
        <field name="name">Lost Quotations</field>
        <field name="model_name">lost_quotations</field>
        <field name="description">List cancelled quotations.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_top_customers" model="rn.ai.employee.tool">
        <field name="name">Top Customers</field>
        <field name="model_name">top_customers</field>
        <field name="description">Rank customers by confirmed sales revenue.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_best_selling_products" model="rn.ai.employee.tool">
        <field name="name">Best Selling Products</field>
        <field name="model_name">best_selling_products</field>
        <field name="description">Rank products by sold quantity.</field>
        <field name="active" eval="True"/>
    </record>

    <record id="tool_overdue_invoices" model="rn.ai.employee.tool">
        <field name="name">Overdue Invoices</field>
        <field name="model_name">overdue_invoices</field>
        <field name="description">List posted customer invoices unpaid past their due date.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_customer_balance" model="rn.ai.employee.tool">
        <field name="name">Customer Balance</field>
        <field name="model_name">customer_balance</field>
        <field name="description">Show customers with the highest receivable balances.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_revenue_this_month" model="rn.ai.employee.tool">
        <field name="name">Revenue This Month</field>
        <field name="model_name">revenue_this_month</field>
        <field name="description">Show posted customer invoice revenue for the current month.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_expenses_this_month" model="rn.ai.employee.tool">
        <field name="name">Expenses This Month</field>
        <field name="model_name">expenses_this_month</field>
        <field name="description">Show posted vendor bill totals for the current month.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_profit_this_month" model="rn.ai.employee.tool">
        <field name="name">Profit This Month</field>
        <field name="model_name">profit_this_month</field>
        <field name="description">Estimate profit as revenue minus expenses this month.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_revenue_analysis" model="rn.ai.employee.tool">
        <field name="name">Revenue Analysis</field>
        <field name="model_name">revenue_analysis</field>
        <field name="description">Compare customer invoice revenue between months.</field>
        <field name="active" eval="True"/>
    </record>

    <record id="tool_negative_stock" model="rn.ai.employee.tool">
        <field name="name">Negative Stock</field>
        <field name="model_name">negative_stock</field>
        <field name="description">List products with negative on-hand quantity.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_low_stock" model="rn.ai.employee.tool">
        <field name="name">Low Stock</field>
        <field name="model_name">low_stock</field>
        <field name="description">List products with low on-hand quantity.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_products_not_moved" model="rn.ai.employee.tool">
        <field name="name">Products Not Moved</field>
        <field name="model_name">products_not_moved</field>
        <field name="description">Highlight products without stock moves for a period.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_inventory_valuation" model="rn.ai.employee.tool">
        <field name="name">Inventory Valuation</field>
        <field name="model_name">inventory_valuation</field>
        <field name="description">Estimate on-hand inventory value using standard cost.</field>
        <field name="active" eval="True"/>
    </record>

    <record id="tool_find_customer" model="rn.ai.employee.tool">
        <field name="name">Find Customer</field>
        <field name="model_name">find_customer</field>
        <field name="description">Search customers or find inactive customers.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_top_opportunities" model="rn.ai.employee.tool">
        <field name="name">Top Opportunities</field>
        <field name="model_name">top_opportunities</field>
        <field name="description">List the highest value open CRM opportunities.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_lost_leads" model="rn.ai.employee.tool">
        <field name="name">Lost Leads</field>
        <field name="model_name">lost_leads</field>
        <field name="description">List recently lost CRM leads and opportunities.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_followup_overdue" model="rn.ai.employee.tool">
        <field name="name">Follow-up Overdue</field>
        <field name="model_name">followup_overdue</field>
        <field name="description">List CRM records with overdue next activities.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_pipeline_revenue" model="rn.ai.employee.tool">
        <field name="name">Pipeline Revenue</field>
        <field name="model_name">pipeline_revenue</field>
        <field name="description">Summarize expected revenue from the open CRM pipeline.</field>
        <field name="active" eval="True"/>
    </record>

    <record id="tool_create_quotation" model="rn.ai.employee.tool">
        <field name="name">Create Quotation</field>
        <field name="model_name">create_quotation</field>
        <field name="description">Create a draft sales quotation for a customer and product.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_send_payment_reminders" model="rn.ai.employee.tool">
        <field name="name">Send Payment Reminders</field>
        <field name="model_name">send_payment_reminders</field>
        <field name="description">Send payment reminder emails for overdue customer invoices.</field>
        <field name="active" eval="True"/>
    </record>

    <record id="tool_morning_briefing" model="rn.ai.employee.tool">
        <field name="name">Morning Briefing</field>
        <field name="model_name">morning_briefing</field>
        <field name="description">Executive briefing with revenue, collections, and suggested actions.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_create_rfq" model="rn.ai.employee.tool">
        <field name="name">Create RFQ</field>
        <field name="model_name">create_rfq</field>
        <field name="description">Create a draft purchase RFQ for a vendor and product.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_schedule_activity" model="rn.ai.employee.tool">
        <field name="name">Schedule Activity</field>
        <field name="model_name">schedule_activity</field>
        <field name="description">Schedule follow-up activities on business records.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_send_partner_email" model="rn.ai.employee.tool">
        <field name="name">Send Partner Email</field>
        <field name="model_name">send_partner_email</field>
        <field name="description">Send follow-up emails to customers or partners.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_confirm_purchase_order" model="rn.ai.employee.tool">
        <field name="name">Confirm Purchase Order</field>
        <field name="model_name">confirm_purchase_order</field>
        <field name="description">Confirm a draft purchase order.</field>
        <field name="active" eval="True"/>
    </record>
    <record id="tool_reserve_stock" model="rn.ai.employee.tool">
        <field name="name">Reserve Stock</field>
        <field name="model_name">reserve_stock</field>
        <field name="description">Reserve available stock for a product.</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
