<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_employee_audit_log_tree" model="ir.ui.view">
        <field name="name">rn.ai.employee.audit.log.tree</field>
        <field name="model">rn.ai.employee.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="tool_name"/>
                <field name="result_state"/>
                <field name="confirmed"/>
                <field name="write_action"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_ai_employee_audit_log_form" model="ir.ui.view">
        <field name="name">rn.ai.employee.audit.log.form</field>
        <field name="model">rn.ai.employee.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="tool_name"/>
                        <field name="result_state"/>
                        <field name="confirmed"/>
                        <field name="write_action"/>
                        <field name="user_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="chat_id"/>
                        <field name="pending_action_id"/>
                        <field name="create_date"/>
                    </group>
                    <group string="Details">
                        <field name="arguments"/>
                        <field name="result_summary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_ai_employee_audit_logs" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">rn.ai.employee.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
