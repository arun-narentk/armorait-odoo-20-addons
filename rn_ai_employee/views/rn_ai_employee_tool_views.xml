<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_employee_tool_tree" model="ir.ui.view">
        <field name="name">rn.ai.employee.tool.tree</field>
        <field name="model">rn.ai.employee.tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_ai_employee_tool_form" model="ir.ui.view">
        <field name="name">rn.ai.employee.tool.form</field>
        <field name="model">rn.ai.employee.tool</field>
        <field name="arch" type="xml">
            <form string="AI Tool">
                <header>
                    <button name="action_test_tool"
                            type="object"
                            string="Test Tool"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="model_name"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_ai_employee_tools" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">rn.ai.employee.tool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
