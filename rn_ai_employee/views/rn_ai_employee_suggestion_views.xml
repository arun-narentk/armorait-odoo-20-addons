<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_employee_suggestion_tree" model="ir.ui.view">
        <field name="name">rn.ai.employee.suggestion.tree</field>
        <field name="model">rn.ai.employee.suggestion</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="question"/>
                <field name="category"/>
                <field name="tool_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_ai_employee_suggestion_form" model="ir.ui.view">
        <field name="name">rn.ai.employee.suggestion.form</field>
        <field name="model">rn.ai.employee.suggestion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="question"/>
                        <field name="category"/>
                        <field name="tool_name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_ai_employee_suggestions" model="ir.actions.act_window">
        <field name="name">Suggested Questions</field>
        <field name="res_model">rn.ai.employee.suggestion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
