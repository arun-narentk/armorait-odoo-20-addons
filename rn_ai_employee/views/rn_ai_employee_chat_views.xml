<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_employee_chat_tree" model="ir.ui.view">
        <field name="name">rn.ai.employee.chat.tree</field>
        <field name="model">rn.ai.employee.chat</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="message_count"/>
                <field name="last_message_preview"/>
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_ai_employee_chat_form" model="ir.ui.view">
        <field name="name">rn.ai.employee.chat.form</field>
        <field name="model">rn.ai.employee.chat</field>
        <field name="arch" type="xml">
            <form string="AI Copilot">
                <header>
                    <button name="action_send_message"
                            type="object"
                            string="Send"
                            class="btn-primary"
                            icon="fa-paper-plane"/>
                    <button name="action_ask_selected_suggestion"
                            type="object"
                            string="Ask Suggested Question"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-warning" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Conversation"/>
                        <h1>
                            <field name="name" placeholder="Conversation subject"/>
                        </h1>
                        <div class="text-muted">
                            Ask a business question, review the answer, then use the suggested actions.
                        </div>
                    </div>
                    <notebook>
                        <page string="Chat" name="chat">
                            <group col="12">
                                <group col="8" colspan="8" string="Conversation">
                                    <field name="message_ids" readonly="1" nolabel="1" mode="kanban,list">
                                        <kanban class="o_kanban_mobile">
                                            <templates>
                                                <t t-name="card">
                                                    <div t-attf-class="oe_kanban_global_click border rounded p-3 mb-2 #{record.role.raw_value == 'assistant' and 'bg-info-subtle' or ''} #{record.role.raw_value == 'user' and 'bg-light' or ''} #{record.role.raw_value == 'tool' and 'bg-warning-subtle' or ''} #{record.role.raw_value == 'system' and 'bg-secondary-subtle' or ''}">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <strong>
                                                                <field name="role"/>
                                                            </strong>
                                                            <span class="text-muted">
                                                                <field name="create_date"/>
                                                            </span>
                                                        </div>
                                                        <div class="fw-semibold" invisible="not headline">
                                                            <field name="headline"/>
                                                        </div>
                                                        <div class="mt-2">
                                                            <field name="content"/>
                                                        </div>
                                                        <div class="mt-3 text-muted" invisible="not action_count">
                                                            <strong><field name="action_count"/> suggested actions.</strong>
                                                            Open the message to run them.
                                                        </div>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                        <list create="0" edit="0" delete="0">
                                            <field name="create_date" string="Time"/>
                                            <field name="role"/>
                                            <field name="headline"/>
                                            <field name="content"/>
                                        </list>
                                        <form create="0" edit="0" delete="0">
                                            <sheet>
                                                <group col="4">
                                                    <field name="create_date"/>
                                                    <field name="role"/>
                                                    <field name="headline"/>
                                                    <field name="tool_name" invisible="not tool_name"/>
                                                </group>
                                                <separator string="Message"/>
                                                <field name="content" nolabel="1"/>
                                                <separator string="Suggested Actions" invisible="not action_ids"/>
                                                <field name="action_ids" nolabel="1" invisible="not action_ids">
                                                    <list create="0" edit="0" delete="0">
                                                        <field name="label"/>
                                                        <field name="action_type"/>
                                                        <button name="action_run"
                                                                type="object"
                                                                string="Run"
                                                                class="btn-primary"/>
                                                    </list>
                                                </field>
                                                <separator string="Tool Result" invisible="not tool_result"/>
                                                <field name="tool_result" nolabel="1" invisible="not tool_result"/>
                                            </sheet>
                                        </form>
                                    </field>
                                    <separator string="Ask in your own words"/>
                                    <field name="draft_message"
                                           nolabel="1"
                                           placeholder="Example: Why did revenue decrease this month?"/>
                                </group>
                                <group col="4" colspan="4" string="Start Faster">
                                    <div class="border rounded p-3 mb-3">
                                        <div class="fw-semibold mb-2">Suggested Question</div>
                                        <field name="suggested_question_id"
                                               nolabel="1"
                                               options="{'no_create': True, 'no_open': True}"/>
                                    </div>
                                    <div class="border rounded p-3 mb-2">
                                        <div class="fw-semibold mb-2">Accounting</div>
                                        <button name="action_ask_suggested"
                                                type="object"
                                                string="Show overdue invoices"
                                                class="btn btn-link p-0"
                                                context="{'suggested_question': 'Show overdue invoices'}"/>
                                        <br/>
                                        <button name="action_ask_suggested"
                                                type="object"
                                                string="Revenue this month"
                                                class="btn btn-link p-0"
                                                context="{'suggested_question': 'Show revenue this month'}"/>
                                    </div>
                                    <div class="border rounded p-3 mb-2">
                                        <div class="fw-semibold mb-2">Sales</div>
                                        <button name="action_ask_suggested"
                                                type="object"
                                                string="Today's sales"
                                                class="btn btn-link p-0"
                                                context="{'suggested_question': 'Show today sales'}"/>
                                        <br/>
                                        <button name="action_ask_suggested"
                                                type="object"
                                                string="Top customers"
                                                class="btn btn-link p-0"
                                                context="{'suggested_question': 'Show top customers'}"/>
                                    </div>
                                    <div class="border rounded p-3">
                                        <div class="fw-semibold mb-2">Inventory</div>
                                        <button name="action_ask_suggested"
                                                type="object"
                                                string="Stock issues"
                                                class="btn btn-link p-0"
                                                context="{'suggested_question': 'Show low stock products'}"/>
                                        <br/>
                                        <button name="action_ask_suggested"
                                                type="object"
                                                string="Products not moved"
                                                class="btn btn-link p-0"
                                                context="{'suggested_question': 'Show products not moved'}"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Conversation Info" name="details" groups="rn_ai_employee.group_rn_ai_employee_manager">
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                <field name="message_count" readonly="1"/>
                                <field name="active"/>
                                <field name="last_message_preview" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rn_ai_employee_chat_search" model="ir.ui.view">
        <field name="name">rn.ai.employee.chat.search</field>
        <field name="model">rn.ai.employee.chat</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter string="My Conversations" name="my_chats" domain="[('user_id', '=', uid)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_rn_ai_employee_chat" model="ir.actions.server">
        <field name="name">Chat</field>
        <field name="model_id" ref="model_rn_ai_employee_chat"/>
        <field name="state">code</field>
        <field name="code">action = env['rn.ai.employee.chat'].action_start_new_chat()</field>
    </record>

    <record id="action_rn_ai_employee_conversations" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">rn.ai.employee.chat</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_chats': 1}</field>
    </record>
</odoo>
