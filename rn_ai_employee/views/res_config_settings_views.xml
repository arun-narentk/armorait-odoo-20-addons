<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rn_ai_employee" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.ai.employee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Copilot" name="rn_ai_employee" groups="rn_ai_employee.group_rn_ai_employee_manager">
                    <block title="AI Copilot Platform">
                        <setting string="Enable AI Copilot"
                                 help="Turn on the enterprise intelligence layer for sales, finance, inventory, CRM, and purchase.">
                            <field name="rn_ai_employee_enabled"/>
                        </setting>
                        <setting string="Require write confirmation"
                                 help="Sensitive skills ask for explicit confirmation before changing live data.">
                            <field name="rn_ai_employee_require_write_confirmation"/>
                        </setting>
                        <setting string="Morning briefing"
                                 help="Send a proactive executive briefing to managers each morning.">
                            <field name="rn_ai_employee_morning_briefing_enabled"/>
                        </setting>
                        <setting string="Provider"
                                 help="External AI provider configuration.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="rn_ai_employee_provider" class="col-lg-3 o_light_label"/>
                                    <field name="rn_ai_employee_provider" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="rn_ai_employee_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="rn_ai_employee_api_key" password="True" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="rn_ai_employee_api_url" class="col-lg-3 o_light_label"/>
                                    <field name="rn_ai_employee_api_url" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="rn_ai_employee_model" class="col-lg-3 o_light_label"/>
                                    <field name="rn_ai_employee_model" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="rn_ai_employee_temperature" class="col-lg-3 o_light_label"/>
                                    <field name="rn_ai_employee_temperature" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="rn_ai_employee_use_llm" class="col-lg-3 o_light_label"/>
                                    <field name="rn_ai_employee_use_llm" class="col-lg-9"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_rn_ai_employee_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'rn_ai_employee', 'bin_size': False}</field>
    </record>
</odoo>
