<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_invoice_ocr">
        <field name="name">ARMORA AI Invoice OCR</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_rn_invoice_ocr_user" model="res.groups">
        <field name="name">OCR User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_invoice_ocr"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_rn_invoice_ocr_manager" model="res.groups">
        <field name="name">OCR Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_invoice_ocr"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_invoice_ocr_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
