<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_invoice_ocr_settings_form" model="ir.ui.view">
        <field name="name">rn.ai.invoice.ocr.settings.form</field>
        <field name="model">rn.ai.invoice.ocr.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group string="Automation">
                        <field name="auto_extract_on_upload"/>
                        <field name="auto_match_vendor"/>
                        <field name="auto_match_product"/>
                        <field name="duplicate_check"/>
                        <field name="min_confidence_approve"/>
                    </group>
                    <group string="Regional and AI">
                        <field name="enable_gst_india"/>
                        <field name="enable_llm_enhance"/>
                        <field name="credit_balance"/>
                        <field name="purchase_journal_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rn_ai_invoice_ocr_settings_tree" model="ir.ui.view">
        <field name="name">rn.ai.invoice.ocr.settings.tree</field>
        <field name="model">rn.ai.invoice.ocr.settings</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="credit_balance"/>
                <field name="enable_gst_india"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_rn_ai_invoice_ocr_settings" model="ir.actions.act_window">
        <field name="name">OCR Settings</field>
        <field name="res_model">rn.ai.invoice.ocr.settings</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_ai_invoice_ocr_subscription_tree" model="ir.ui.view">
        <field name="name">rn.ai.invoice.ocr.subscription.tree</field>
        <field name="model">rn.ai.invoice.ocr.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="monthly_credits"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_ai_invoice_ocr_subscription_form" model="ir.ui.view">
        <field name="name">rn.ai.invoice.ocr.subscription.form</field>
        <field name="model">rn.ai.invoice.ocr.subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="plan"/>
                        <field name="state"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="monthly_fee"/>
                        <field name="currency_id"/>
                        <field name="monthly_credits"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_ai_invoice_ocr_subscription" model="ir.actions.act_window">
        <field name="name">OCR Subscriptions</field>
        <field name="res_model">rn.ai.invoice.ocr.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_config_settings_view_form_invoice_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.invoice.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="AI Invoice OCR" name="rn_ai_invoice_ocr_settings">
                    <setting string="Auto extract on upload" help="Run OCR when a scan is created.">
                        <field name="invoice_ocr_auto_extract"/>
                    </setting>
                    <setting string="India GST parsing" help="Parse CGST, SGST, IGST, and HSN from invoice text.">
                        <field name="invoice_ocr_enable_gst"/>
                    </setting>
                    <setting string="Duplicate check" help="Warn when invoice number already exists for vendor.">
                        <field name="invoice_ocr_duplicate_check"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
