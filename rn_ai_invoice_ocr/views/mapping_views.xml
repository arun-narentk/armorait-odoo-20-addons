<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_invoice_vendor_mapping_tree" model="ir.ui.view">
        <field name="name">rn.ai.invoice.vendor.mapping.tree</field>
        <field name="model">rn.ai.invoice.vendor.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="ocr_text"/>
                <field name="partner_id"/>
                <field name="hit_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_ai_invoice_vendor_mapping_form" model="ir.ui.view">
        <field name="name">rn.ai.invoice.vendor.mapping.form</field>
        <field name="model">rn.ai.invoice.vendor.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="ocr_text"/>
                        <field name="partner_id"/>
                        <field name="hit_count"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_ai_invoice_vendor_mapping" model="ir.actions.act_window">
        <field name="name">Vendor Mappings</field>
        <field name="res_model">rn.ai.invoice.vendor.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_ai_invoice_product_mapping_tree" model="ir.ui.view">
        <field name="name">rn.ai.invoice.product.mapping.tree</field>
        <field name="model">rn.ai.invoice.product.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="ocr_text"/>
                <field name="product_id"/>
                <field name="hit_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_ai_invoice_product_mapping_form" model="ir.ui.view">
        <field name="name">rn.ai.invoice.product.mapping.form</field>
        <field name="model">rn.ai.invoice.product.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="ocr_text"/>
                        <field name="product_id"/>
                        <field name="hit_count"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_ai_invoice_product_mapping" model="ir.actions.act_window">
        <field name="name">Product Mappings</field>
        <field name="res_model">rn.ai.invoice.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
