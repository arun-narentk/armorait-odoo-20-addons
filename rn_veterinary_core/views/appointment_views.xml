<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_vet_appointment_tree" model="ir.ui.view">
        <field name="name">rn.vet.appointment.tree</field>
        <field name="model">rn.vet.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_datetime"/>
                <field name="pet_id"/>
                <field name="owner_id"/>
                <field name="veterinarian_id"/>
                <field name="appointment_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_vet_appointment_form" model="ir.ui.view">
        <field name="name">rn.vet.appointment.form</field>
        <field name="model">rn.vet.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check_in" type="object" string="Check In" invisible="state != 'scheduled'"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state not in ('checked_in', 'in_progress')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pet_id"/>
                        <field name="owner_id"/>
                        <field name="veterinarian_id"/>
                        <field name="appointment_type"/>
                    </group>
                    <group>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="duration_minutes"/>
                    </group>
                    <field name="reason"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_vet_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">rn.vet.appointment</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_vet_vaccine_type" model="ir.actions.act_window">
        <field name="name">Vaccine Types</field>
        <field name="res_model">rn.vet.vaccine.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
