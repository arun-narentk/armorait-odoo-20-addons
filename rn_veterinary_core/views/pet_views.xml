<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_vet_pet_tree" model="ir.ui.view">
        <field name="name">rn.vet.pet.tree</field>
        <field name="model">rn.vet.pet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="species"/>
                <field name="breed"/>
                <field name="weight_kg"/>
                <field name="microchip"/>
            </list>
        </field>
    </record>
    <record id="view_rn_vet_pet_form" model="ir.ui.view">
        <field name="name">rn.vet.pet.form</field>
        <field name="model">rn.vet.pet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="owner_id"/>
                        <field name="species"/>
                        <field name="breed"/>
                        <field name="gender"/>
                        <field name="color"/>
                    </group>
                    <group>
                        <field name="date_of_birth"/>
                        <field name="weight_kg"/>
                        <field name="microchip"/>
                    </group>
                    <notebook>
                        <page string="Medical">
                            <field name="allergies"/>
                            <field name="medical_history"/>
                            <field name="vaccination_ids">
                                <list>
                                    <field name="vaccine_type_id"/>
                                    <field name="administered_date"/>
                                    <field name="next_due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Records">
                            <field name="medical_record_ids">
                                <list>
                                    <field name="record_date"/>
                                    <field name="name"/>
                                    <field name="diagnosis"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_vet_pet" model="ir.actions.act_window">
        <field name="name">Pets</field>
        <field name="res_model">rn.vet.pet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
