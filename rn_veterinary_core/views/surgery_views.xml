<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_vet_surgery_tree" model="ir.ui.view">
        <field name="name">rn.vet.surgery.tree</field>
        <field name="model">rn.vet.surgery</field>
        <field name="arch" type="xml">
            <list>
                <field name="surgery_date"/>
                <field name="name"/>
                <field name="pet_id"/>
                <field name="procedure"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_rn_vet_surgery" model="ir.actions.act_window">
        <field name="name">Surgeries</field>
        <field name="res_model">rn.vet.surgery</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
