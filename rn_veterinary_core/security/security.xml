<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_vet">
        <field name="name">ARMORA Veterinary ERP</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_vet_reception" model="res.groups">
        <field name="name">Reception</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_vet"/>
    </record>
    <record id="group_rn_vet_veterinarian" model="res.groups">
        <field name="name">Veterinarian</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_vet"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_vet_reception'))]"/>
    </record>
    <record id="group_rn_vet_manager" model="res.groups">
        <field name="name">Clinic Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_vet"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_vet_veterinarian'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
