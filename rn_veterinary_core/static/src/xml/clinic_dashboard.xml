<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_veterinary_core.ClinicDashboard">
        <div class="o_rn_vet_clinic_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2>Clinic Dashboard</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Appointments Today</div><div class="fs-3" t-out="this.state.appointments"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Vaccines Due</div><div class="fs-3" t-out="this.state.vaccinesDue"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Boarding Occupancy</div><div class="fs-3"><t t-out="this.state.boarding"/>%</div></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Active Pets</div><div class="fs-3" t-out="this.state.pets"/></div></div>
                <div class="col-md-12"><div class="card p-3"><div class="text-muted">Grooming Services (Month)</div><div class="fs-4" t-out="this.state.grooming"/></div></div>
            </div>
        </div>
    </t>
</templates>
