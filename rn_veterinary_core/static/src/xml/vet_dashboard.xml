<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_veterinary_core.VetDashboard">
        <div class="o_rn_vet_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2>My Schedule</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-6"><div class="card p-3"><div class="text-muted">Appointments Today</div><div class="fs-3" t-out="this.state.appointments"/></div></div>
                <div class="col-md-6"><div class="card p-3"><div class="text-muted">Pending Surgeries</div><div class="fs-3" t-out="this.state.surgeries"/></div></div>
            </div>
        </div>
    </t>
</templates>
