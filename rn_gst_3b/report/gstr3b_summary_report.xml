<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_3b_action_report_summary" model="ir.actions.report">
        <field name="name">GSTR-3B Summary</field>
        <field name="model">rn.gst.3b</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_gst_3b.report_gstr3b_summary</field>
        <field name="print_report_name">'GSTR-3B Summary - %s - %s' % (object.gstin, object.reporting_period or object.return_period)</field>
        <field name="binding_model_id" ref="model_rn_gst_3b"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_gstr3b_summary_document">
        <t t-call="web.external_layout">
            <t t-set="cur" t-value="doc.currency_id"/>
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': cur}"/>
            <t t-set="heads" t-value="[('Integrated Tax (IGST)', 'igst'), ('Central Tax (CGST)', 'cgst'), ('State/UT Tax (SGST)', 'sgst'), ('Cess', 'cess')]"/>
            <div class="page o_rn_gst_report">
                <h3 class="mb-1">GSTR-3B Summary</h3>
                <p class="text-muted mb-3">Figures as recorded in Odoo. Check against the GST Portal before you file.</p>

                <table class="table table-sm table-borderless mb-4">
                    <tr>
                        <td class="w-25"><strong>GSTIN</strong></td>
                        <td class="w-25" t-out="doc.gstin"/>
                        <td class="w-25"><strong>Reference</strong></td>
                        <td class="w-25" t-out="doc.name"/>
                    </tr>
                    <tr>
                        <td><strong>Legal name</strong></td>
                        <td t-out="doc.company_id.name"/>
                        <td><strong>Status</strong></td>
                        <td><span t-field="doc.state"/></td>
                    </tr>
                    <tr>
                        <td><strong>Financial year</strong></td>
                        <td t-out="doc.financial_year"/>
                        <td><strong>Return period</strong></td>
                        <td><span t-out="doc.return_period"/> (<span t-field="doc.period_start"/> to <span t-field="doc.period_end"/>)</td>
                    </tr>
                    <tr>
                        <td><strong>Due date</strong></td>
                        <td><span t-field="doc.due_date"/></td>
                        <td><strong>Payment / offset date</strong></td>
                        <td><span t-field="doc.payment_date"/></td>
                    </tr>
                </table>

                <h5>Outward and reverse charge inward supplies (Table 3.1)</h5>
                <table class="table table-sm table-bordered mb-4">
                    <thead class="table-light">
                        <tr>
                            <th>Nature of supplies</th>
                            <th class="text-end">Taxable value</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST/UTGST</th>
                            <th class="text-end">Cess</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>(a) Outward taxable supplies (other than zero rated, nil rated and exempted)</td><td class="text-end" t-out="doc.t31a_taxable" t-options="money"/><td class="text-end" t-out="doc.t31a_igst" t-options="money"/><td class="text-end" t-out="doc.t31a_cgst" t-options="money"/><td class="text-end" t-out="doc.t31a_sgst" t-options="money"/><td class="text-end" t-out="doc.t31a_cess" t-options="money"/></tr>
                        <tr><td>(b) Outward taxable supplies (zero rated)</td><td class="text-end" t-out="doc.t31b_taxable" t-options="money"/><td class="text-end" t-out="doc.t31b_igst" t-options="money"/><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td><td class="text-end" t-out="doc.t31b_cess" t-options="money"/></tr>
                        <tr><td>(c) Other outward supplies (nil rated, exempted)</td><td class="text-end" t-out="doc.t31c_taxable" t-options="money"/><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td></tr>
                        <tr><td>(d) Inward supplies (liable to reverse charge)</td><td class="text-end" t-out="doc.t31d_taxable" t-options="money"/><td class="text-end" t-out="doc.t31d_igst" t-options="money"/><td class="text-end" t-out="doc.t31d_cgst" t-options="money"/><td class="text-end" t-out="doc.t31d_sgst" t-options="money"/><td class="text-end" t-out="doc.t31d_cess" t-options="money"/></tr>
                        <tr><td>(e) Non-GST outward supplies</td><td class="text-end" t-out="doc.t31e_taxable" t-options="money"/><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td></tr>
                    </tbody>
                </table>

                <h5>Inter-state supplies to unregistered, composition and UIN holders (Table 3.2)</h5>
                <table class="table table-sm table-bordered mb-4">
                    <thead class="table-light">
                        <tr>
                            <th>Supplies made to</th>
                            <th>Place of supply</th>
                            <th class="text-end">Taxable value</th>
                            <th class="text-end">IGST</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="not doc.interstate_line_ids">
                            <td colspan="4" class="text-center text-muted">No inter-state supplies to unregistered persons, composition dealers or UIN holders.</td>
                        </tr>
                        <tr t-foreach="doc.interstate_line_ids" t-as="line">
                            <td><span t-field="line.supply_type"/></td>
                            <td><span t-out="line.state_id.name"/> (<span t-out="line.state_id.l10n_in_tin"/>)</td>
                            <td class="text-end" t-out="line.taxable_value" t-options="money"/>
                            <td class="text-end" t-out="line.igst" t-options="money"/>
                        </tr>
                    </tbody>
                </table>

                <h5>Eligible ITC (Table 4)</h5>
                <table class="table table-sm table-bordered mb-4">
                    <thead class="table-light">
                        <tr>
                            <th>Details</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST/UTGST</th>
                            <th class="text-end">Cess</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>(A)(1) Import of goods</td><td class="text-end" t-out="doc.t4a1_igst" t-options="money"/><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td><td class="text-end" t-out="doc.t4a1_cess" t-options="money"/></tr>
                        <tr><td>(A)(2) Import of services</td><td class="text-end" t-out="doc.t4a2_igst" t-options="money"/><td class="text-end text-muted">-</td><td class="text-end text-muted">-</td><td class="text-end" t-out="doc.t4a2_cess" t-options="money"/></tr>
                        <tr><td>(A)(3) Inward supplies liable to reverse charge (other than 1 and 2)</td><td class="text-end" t-out="doc.t4a3_igst" t-options="money"/><td class="text-end" t-out="doc.t4a3_cgst" t-options="money"/><td class="text-end" t-out="doc.t4a3_sgst" t-options="money"/><td class="text-end" t-out="doc.t4a3_cess" t-options="money"/></tr>
                        <tr><td>(A)(4) Inward supplies from ISD</td><td class="text-end" t-out="doc.t4a4_igst" t-options="money"/><td class="text-end" t-out="doc.t4a4_cgst" t-options="money"/><td class="text-end" t-out="doc.t4a4_sgst" t-options="money"/><td class="text-end" t-out="doc.t4a4_cess" t-options="money"/></tr>
                        <tr><td>(A)(5) All other ITC</td><td class="text-end" t-out="doc.t4a5_igst" t-options="money"/><td class="text-end" t-out="doc.t4a5_cgst" t-options="money"/><td class="text-end" t-out="doc.t4a5_sgst" t-options="money"/><td class="text-end" t-out="doc.t4a5_cess" t-options="money"/></tr>
                        <tr><td>(B)(1) Reversed as per rules 38, 42, 43 and section 17(5)</td><td class="text-end" t-out="doc.t4b1_igst" t-options="money"/><td class="text-end" t-out="doc.t4b1_cgst" t-options="money"/><td class="text-end" t-out="doc.t4b1_sgst" t-options="money"/><td class="text-end" t-out="doc.t4b1_cess" t-options="money"/></tr>
                        <tr><td>(B)(2) Reversed: others</td><td class="text-end" t-out="doc.t4b2_igst" t-options="money"/><td class="text-end" t-out="doc.t4b2_cgst" t-options="money"/><td class="text-end" t-out="doc.t4b2_sgst" t-options="money"/><td class="text-end" t-out="doc.t4b2_cess" t-options="money"/></tr>
                        <tr class="fw-bold"><td>(C) Net ITC available (A) - (B)</td><td class="text-end" t-out="doc.t4c_igst" t-options="money"/><td class="text-end" t-out="doc.t4c_cgst" t-options="money"/><td class="text-end" t-out="doc.t4c_sgst" t-options="money"/><td class="text-end" t-out="doc.t4c_cess" t-options="money"/></tr>
                        <tr><td>(D)(1) ITC reclaimed which was reversed earlier</td><td class="text-end" t-out="doc.t4d1_igst" t-options="money"/><td class="text-end" t-out="doc.t4d1_cgst" t-options="money"/><td class="text-end" t-out="doc.t4d1_sgst" t-options="money"/><td class="text-end" t-out="doc.t4d1_cess" t-options="money"/></tr>
                        <tr><td>(D)(2) Ineligible ITC under section 16(4) and place of supply rules</td><td class="text-end" t-out="doc.t4d2_igst" t-options="money"/><td class="text-end" t-out="doc.t4d2_cgst" t-options="money"/><td class="text-end" t-out="doc.t4d2_sgst" t-options="money"/><td class="text-end" t-out="doc.t4d2_cess" t-options="money"/></tr>
                    </tbody>
                </table>

                <h5>Exempt, nil rated and non-GST inward supplies (Table 5)</h5>
                <table class="table table-sm table-bordered mb-4">
                    <thead class="table-light">
                        <tr>
                            <th>Nature of supplies</th>
                            <th class="text-end">Inter-state</th>
                            <th class="text-end">Intra-state</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>From a supplier under composition scheme, exempt and nil rated supply</td>
                            <td class="text-end" t-out="doc.t5_exempt_inter" t-options="money"/>
                            <td class="text-end" t-out="doc.t5_exempt_intra" t-options="money"/>
                        </tr>
                        <tr>
                            <td>Non-GST supply</td>
                            <td class="text-end" t-out="doc.t5_nongst_inter" t-options="money"/>
                            <td class="text-end" t-out="doc.t5_nongst_intra" t-options="money"/>
                        </tr>
                    </tbody>
                </table>

                <h5>Payment of tax (Table 6.1)</h5>
                <table class="table table-sm table-bordered mb-1">
                    <thead class="table-light">
                        <tr>
                            <th>Tax head</th>
                            <th class="text-end">Tax payable</th>
                            <th class="text-end">ITC opening</th>
                            <th class="text-end">ITC available</th>
                            <th class="text-end">ITC used from this head</th>
                            <th class="text-end">ITC balance</th>
                            <th class="text-end">Paid in cash</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="heads" t-as="head">
                            <td t-out="head[0]"/>
                            <td class="text-end" t-out="doc['liability_' + head[1]]" t-options="money"/>
                            <td class="text-end" t-out="doc['itc_opening_' + head[1]]" t-options="money"/>
                            <td class="text-end" t-out="doc['itc_available_' + head[1]]" t-options="money"/>
                            <td class="text-end" t-out="doc['itc_utilized_' + head[1]]" t-options="money"/>
                            <td class="text-end" t-out="doc['itc_remaining_' + head[1]]" t-options="money"/>
                            <td class="text-end" t-out="doc['cash_payable_' + head[1]]" t-options="money"/>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td>Total</td>
                            <td class="text-end" t-out="sum(doc['liability_' + h[1]] for h in heads)" t-options="money"/>
                            <td class="text-end" t-out="sum(doc['itc_opening_' + h[1]] for h in heads)" t-options="money"/>
                            <td class="text-end" t-out="sum(doc['itc_available_' + h[1]] for h in heads)" t-options="money"/>
                            <td class="text-end" t-out="sum(doc['itc_utilized_' + h[1]] for h in heads)" t-options="money"/>
                            <td class="text-end" t-out="sum(doc['itc_remaining_' + h[1]] for h in heads)" t-options="money"/>
                            <td class="text-end" t-out="sum(doc['cash_payable_' + h[1]] for h in heads)" t-options="money"/>
                        </tr>
                    </tfoot>
                </table>
                <p class="small text-muted mb-4">
                    ITC set-off rule version: <span t-out="doc.itc_utilization_version or 'not computed yet'"/>.
                    <t t-if="doc.t31d_igst or doc.t31d_cgst or doc.t31d_sgst or doc.t31d_cess">
                        Paid in cash includes reverse charge tax from Table 3.1(d), which cannot be paid from ITC.
                    </t>
                </p>

                <h5>Interest (Table 5.1)</h5>
                <table class="table table-sm table-bordered mb-4">
                    <tbody>
                        <tr>
                            <td class="w-50">Net tax liability (paid in cash)</td>
                            <td class="text-end" t-out="doc.net_tax_liability" t-options="money"/>
                        </tr>
                        <tr>
                            <td>Minimum cash ledger balance (Rule 88B)</td>
                            <td class="text-end" t-out="doc.minimum_ecl_balance" t-options="money"/>
                        </tr>
                        <tr>
                            <td>Interest rate</td>
                            <td class="text-end"><span t-out="doc.interest_rate * 100" t-options="{'widget': 'float', 'precision': 2}"/> % a year</td>
                        </tr>
                        <tr>
                            <td>System minimum interest</td>
                            <td class="text-end" t-out="doc.system_minimum_interest" t-options="money"/>
                        </tr>
                        <tr class="fw-bold">
                            <td>Self-assessed interest</td>
                            <td class="text-end" t-out="doc.self_assessed_interest" t-options="money"/>
                        </tr>
                        <tr>
                            <td>Calculation version and date</td>
                            <td class="text-end">
                                <span t-out="doc.interest_calculation_version or '-'"/>,
                                <span t-field="doc.interest_calculation_date"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h5>Tax liability breakup: previous-period supplies</h5>
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Source period</th>
                            <th>Document</th>
                            <th>Return / table</th>
                            <th class="text-end">Taxable value</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                            <th class="text-end">Cess</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="not doc.liability_breakup_ids">
                            <td colspan="8" class="text-center text-muted">No previous-period supplies in this return.</td>
                        </tr>
                        <tr t-foreach="doc.liability_breakup_ids" t-as="line">
                            <td t-out="line.source_period"/>
                            <td><span t-out="line.document_name or line.document_id.name or ''"/> <span t-field="line.document_date"/></td>
                            <td><span t-field="line.source_return"/> <span t-out="line.source_table or ''"/></td>
                            <td class="text-end" t-out="line.taxable_value" t-options="money"/>
                            <td class="text-end" t-out="line.igst" t-options="money"/>
                            <td class="text-end" t-out="line.cgst" t-options="money"/>
                            <td class="text-end" t-out="line.sgst" t-options="money"/>
                            <td class="text-end" t-out="line.cess" t-options="money"/>
                        </tr>
                    </tbody>
                    <tfoot t-if="doc.liability_breakup_ids">
                        <tr class="fw-bold">
                            <td colspan="3">Total</td>
                            <td class="text-end" t-out="sum(doc.liability_breakup_ids.mapped('taxable_value'))" t-options="money"/>
                            <td class="text-end" t-out="sum(doc.liability_breakup_ids.mapped('igst'))" t-options="money"/>
                            <td class="text-end" t-out="sum(doc.liability_breakup_ids.mapped('cgst'))" t-options="money"/>
                            <td class="text-end" t-out="sum(doc.liability_breakup_ids.mapped('sgst'))" t-options="money"/>
                            <td class="text-end" t-out="sum(doc.liability_breakup_ids.mapped('cess'))" t-options="money"/>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>

    <template id="report_gstr3b_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="rn_gst_3b.report_gstr3b_summary_document"/>
            </t>
        </t>
    </template>
</odoo>
