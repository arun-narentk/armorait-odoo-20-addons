<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_attachment_preview">
        <field name="name">ARMORA Attachment Preview</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_attachment_preview_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_attachment_preview"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_attachment_preview_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_attachment_preview"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_attachment_preview_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
