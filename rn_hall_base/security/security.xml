<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_hall">
        <field name="name">ARMORA Marriage Hall Management</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_hall_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_hall_counter" model="res.groups">
        <field name="name">Counter Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hall_readonly'))]"/>
    </record>
    <record id="group_rn_hall_office" model="res.groups">
        <field name="name">Office Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hall_counter'))]"/>
    </record>
    <record id="group_rn_hall_manager" model="res.groups">
        <field name="name">Hall Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hall_office'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
