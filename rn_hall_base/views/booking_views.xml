<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hall_booking_list" model="ir.ui.view">
        <field name="name">rn.hall.booking.list</field>
        <field name="model">rn.hall.booking</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'tentative'" decoration-warning="state == 'waitlist'" decoration-success="state == 'confirmed'">
                <field name="reference"/>
                <field name="name"/>
                <field name="venue_id"/>
                <field name="hall_id"/>
                <field name="partner_id"/>
                <field name="function_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="guest_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hall_booking_form" model="ir.ui.view">
        <field name="name">rn.hall.booking.form</field>
        <field name="model">rn.hall.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_tentative" type="object" string="Mark Tentative" invisible="state != 'draft'"/>
                    <button name="action_waitlist" type="object" string="Waitlist" invisible="state not in ('draft', 'tentative')"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state not in ('draft', 'tentative', 'waitlist')"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled', 'completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,tentative,waitlist,confirmed,completed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not conflict_warning">
                        <field name="conflict_warning"/>
                    </div>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="name"/>
                            <field name="venue_id"/>
                            <field name="hall_id"/>
                            <field name="function_type"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="muhurtham_time" widget="float_time"/>
                            <field name="guest_count"/>
                            <field name="groom_name"/>
                            <field name="bride_name"/>
                        </group>
                    </group>
                    <group string="Commercial">
                        <group>
                            <field name="total_amount"/>
                            <field name="advance_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="referral_source"/>
                            <field name="special_request"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_rn_hall_booking_calendar" model="ir.ui.view">
        <field name="name">rn.hall.booking.calendar</field>
        <field name="model">rn.hall.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings" date_start="date_start" date_stop="date_end" color="hall_id" mode="month">
                <field name="name"/>
                <field name="hall_id"/>
                <field name="partner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="action_rn_hall_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">rn.hall.booking</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
