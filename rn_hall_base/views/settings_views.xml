<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hall_settings_list" model="ir.ui.view">
        <field name="name">rn.hall.settings.list</field>
        <field name="model">rn.hall.settings</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="default_venue_id"/>
                <field name="venue_label"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hall_settings_form" model="ir.ui.view">
        <field name="name">rn.hall.settings.form</field>
        <field name="model">rn.hall.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="default_venue_id"/>
                            <field name="venue_label"/>
                            <field name="customer_label"/>
                            <field name="timezone"/>
                        </group>
                        <group>
                            <field name="enable_online_booking"/>
                            <field name="enable_waitlist"/>
                            <field name="enable_conflict_block"/>
                            <field name="enable_sms"/>
                            <field name="enable_whatsapp"/>
                            <field name="booking_prefix"/>
                            <field name="receipt_prefix"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_hall_settings" model="ir.actions.act_window">
        <field name="name">Hall Settings</field>
        <field name="res_model">rn.hall.settings</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_hall_subscription_list" model="ir.ui.view">
        <field name="name">rn.hall.subscription.list</field>
        <field name="model">rn.hall.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="venue_id"/>
                <field name="plan"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="monthly_fee"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hall_subscription_form" model="ir.ui.view">
        <field name="name">rn.hall.subscription.form</field>
        <field name="model">rn.hall.subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="venue_id"/>
                            <field name="plan"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="monthly_fee"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="max_halls"/>
                            <field name="max_users"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hall_subscription" model="ir.actions.act_window">
        <field name="name">SaaS Subscriptions</field>
        <field name="res_model">rn.hall.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_config_settings_view_form_rn_hall" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.hall</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Marriage Hall" name="rn_hall_base">
                    <block title="Hall Defaults">
                        <setting string="Default Venue">
                            <field name="hall_default_venue_id"/>
                        </setting>
                        <setting string="Venue Label">
                            <field name="hall_venue_label"/>
                        </setting>
                        <setting string="Online Booking">
                            <field name="hall_enable_online_booking"/>
                        </setting>
                        <setting string="Block Double Bookings">
                            <field name="hall_enable_conflict_block"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_rn_hall_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'rn_hall_base'}</field>
    </record>
</odoo>
