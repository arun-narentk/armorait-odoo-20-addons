    <record id="seq_rn_dental_lab_request" model="ir.sequence">
        <field name="name">Dental Lab Request</field>
        <field name="code">rn.dental.lab.request</field>
        <field name="prefix">LAB</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
