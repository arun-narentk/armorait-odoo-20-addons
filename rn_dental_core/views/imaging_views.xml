<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dental_imaging_tree" model="ir.ui.view">
        <field name="name">rn.dental.imaging.tree</field>
        <field name="model">rn.dental.imaging</field>
        <field name="arch" type="xml">
            <list>
                <field name="capture_date"/>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="image_type"/>
                <field name="tooth_number"/>
            </list>
        </field>
    </record>
    <record id="action_rn_dental_imaging" model="ir.actions.act_window">
        <field name="name">Imaging</field>
        <field name="res_model">rn.dental.imaging</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
