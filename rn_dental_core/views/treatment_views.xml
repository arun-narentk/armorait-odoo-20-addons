<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dental_treatment_plan_tree" model="ir.ui.view">
        <field name="name">rn.dental.treatment.plan.tree</field>
        <field name="model">rn.dental.treatment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="total_cost"/>
                <field name="progress_pct"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_dental_treatment_plan_form" model="ir.ui.view">
        <field name="name">rn.dental.treatment.plan.form</field>
        <field name="model">rn.dental.treatment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="patient_id"/>
                        <field name="dentist_id"/>
                        <field name="consent_signed"/>
                        <field name="total_cost"/>
                        <field name="progress_pct"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="procedure_id"/>
                            <field name="tooth_number"/>
                            <field name="visit_count"/>
                            <field name="planned_cost"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_dental_treatment_plan" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field>
        <field name="res_model">rn.dental.treatment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
