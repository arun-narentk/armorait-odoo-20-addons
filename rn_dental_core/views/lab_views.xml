<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dental_lab_request_tree" model="ir.ui.view">
        <field name="name">rn.dental.lab.request.tree</field>
        <field name="model">rn.dental.lab.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="work_type"/>
                <field name="request_date"/>
                <field name="due_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_rn_dental_lab_request" model="ir.actions.act_window">
        <field name="name">Lab Requests</field>
        <field name="res_model">rn.dental.lab.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
