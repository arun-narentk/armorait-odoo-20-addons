<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_dental_core.DentistDashboard">
        <div class="o_rn_dental_dentist_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2>My Schedule</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-4"><div class="card p-3"><div class="text-muted">Appointments Today</div><div class="fs-3" t-out="this.state.appointments"/></div></div>
                <div class="col-md-4"><div class="card p-3"><div class="text-muted">Pending Treatments</div><div class="fs-3" t-out="this.state.treatments"/></div></div>
                <div class="col-md-4"><div class="card p-3"><div class="text-muted">Lab Pending</div><div class="fs-3" t-out="this.state.labPending"/></div></div>
            </div>
        </div>
    </t>
</templates>
