<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dental_appointment_wizard_form" model="ir.ui.view">
        <field name="name">rn.dental.appointment.wizard.form</field>
        <field name="model">rn.dental.appointment.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Appointment">
                <group>
                    <field name="patient_id"/>
                    <field name="dentist_id"/>
                    <field name="chair_id"/>
                    <field name="procedure_id"/>
                    <field name="start_datetime"/>
                </group>
                <footer>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_dental_appointment_wizard" model="ir.actions.act_window">
        <field name="name">Quick Appointment</field>
        <field name="res_model">rn.dental.appointment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
