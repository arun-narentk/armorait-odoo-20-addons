<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_invoice_validator_res_config_settings" model="ir.ui.view">
        <field name="name">rn.gst.invoice.validator.res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rn_gst_base.view_rn_gst_base_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='rn_gst_base_settings']" position="inside">
                <setting string="Block Posting on GST Errors" help="Prevent posting Indian invoices/bills while critical Armora GST errors remain.">
                    <field name="rn_gst_block_post_on_error"/>
                </setting>
                <setting string="Validate Customer Invoices">
                    <field name="rn_gst_validate_sales"/>
                </setting>
                <setting string="Validate Vendor Bills">
                    <field name="rn_gst_validate_purchases"/>
                </setting>
                <setting string="Strict POS vs GSTIN" help="Treat Place of Supply vs partner GSTIN state mismatch as a blocking error.">
                    <field name="rn_gst_strict_pos_gstin"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
