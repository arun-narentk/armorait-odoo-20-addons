<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_armora_gst_rate_change_list" model="ir.ui.view">
        <field name="name">armora.gst.rate.change.list</field>
        <field name="model">armora.gst.rate.change</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rate_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_armora_gst_rate_change_form" model="ir.ui.view">
        <field name="name">armora.gst.rate.change.form</field>
        <field name="model">armora.gst.rate.change</field>
        <field name="arch" type="xml">
            <form string="GST Rate Change">
                <header>
                    <field name="state" widget="statusbar"
                             statusbar_visible="draft,review,approved,scheduled,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="note" colspan="2"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        Draft and review changes must not alter live Odoo taxes.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_armora_gst_rate_change" model="ir.actions.act_window">
        <field name="name">Rate Changes</field>
        <field name="res_model">armora.gst.rate.change</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
