<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_armora_gst_rate_bulk_update_wizard_form" model="ir.ui.view">
        <field name="name">armora.gst.rate.bulk.update.wizard.form</field>
        <field name="model">armora.gst.rate.bulk.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk GST Rate Update">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="note" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_close" type="object" string="Close" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_armora_gst_rate_bulk_update_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Rate Update</field>
        <field name="res_model">armora.gst.rate.bulk.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
