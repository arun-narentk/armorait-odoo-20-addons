<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_armora_gst_rate_conflict_list" model="ir.ui.view">
        <field name="name">armora.gst.rate.conflict.list</field>
        <field name="model">armora.gst.rate.conflict</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="severity"/>
                <field name="rate_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_armora_gst_rate_conflict_form" model="ir.ui.view">
        <field name="name">armora.gst.rate.conflict.form</field>
        <field name="model">armora.gst.rate.conflict</field>
        <field name="arch" type="xml">
            <form string="GST Rate Conflict">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="severity"/>
                        <field name="rate_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_armora_gst_rate_conflict_search" model="ir.ui.view">
        <field name="name">armora.gst.rate.conflict.search</field>
        <field name="model">armora.gst.rate.conflict</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_error" string="Errors" domain="[('severity', '=', 'error')]"/>
                <filter name="filter_warning" string="Warnings" domain="[('severity', '=', 'warning')]"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_armora_gst_rate_conflict" model="ir.actions.act_window">
        <field name="name">Rate Conflicts</field>
        <field name="res_model">armora.gst.rate.conflict</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
