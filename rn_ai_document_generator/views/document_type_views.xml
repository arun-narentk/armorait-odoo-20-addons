<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_doc_type_list" model="ir.ui.view">
        <field name="name">rn.ai.document.type.list</field>
        <field name="model">rn.ai.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="default_style"/>
                <field name="require_approval"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_ai_doc_type_form" model="ir.ui.view">
        <field name="name">rn.ai.document.type.form</field>
        <field name="model">rn.ai.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="default_style"/>
                        <field name="require_approval"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_doc_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">rn.ai.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
