<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_doc_version_list" model="ir.ui.view">
        <field name="name">rn.ai.document.version.list</field>
        <field name="model">rn.ai.document.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_id"/>
                <field name="version_number"/>
                <field name="author_id"/>
                <field name="reason"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_rn_ai_doc_version_form" model="ir.ui.view">
        <field name="name">rn.ai.document.version.form</field>
        <field name="model">rn.ai.document.version</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_restore" type="object" string="Restore This Version" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="document_id"/>
                        <field name="version_number"/>
                        <field name="author_id"/>
                        <field name="reason"/>
                        <field name="comment"/>
                    </group>
                    <field name="body_html"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_doc_version" model="ir.actions.act_window">
        <field name="name">Versions</field>
        <field name="res_model">rn.ai.document.version</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
