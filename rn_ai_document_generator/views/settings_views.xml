<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_doc_settings_form" model="ir.ui.view">
        <field name="name">rn.ai.document.settings.form</field>
        <field name="model">rn.ai.document.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="ai_provider"/>
                        <field name="ai_api_url"/>
                        <field name="ai_api_key" password="True"/>
                        <field name="ai_model"/>
                        <field name="default_language"/>
                        <field name="default_style"/>
                        <field name="auto_snapshot"/>
                        <field name="enable_watermark"/>
                        <field name="watermark_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_doc_settings" model="ir.actions.act_window">
        <field name="name">Document Settings</field>
        <field name="res_model">rn.ai.document.settings</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_ai_doc_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">rn.ai.document.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_ai_doc_export_form" model="ir.ui.view">
        <field name="name">rn.ai.document.export.wizard.form</field>
        <field name="model">rn.ai.document.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Documents">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="limit"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export CSV" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_doc_export" model="ir.actions.act_window">
        <field name="name">Export Documents</field>
        <field name="res_model">rn.ai.document.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_res_config_settings_rn_ai_doc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.ai.doc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Documents" name="rn_ai_document_generator">
                    <block title="AI Provider">
                        <setting string="Provider">
                            <field name="rn_ai_doc_provider"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_rn_ai_doc_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'rn_ai_document_generator'}</field>
    </record>
</odoo>
