<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_doc_template_list" model="ir.ui.view">
        <field name="name">rn.ai.document.template.list</field>
        <field name="model">rn.ai.document.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="type_id"/>
                <field name="language"/>
                <field name="style"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_ai_doc_template_form" model="ir.ui.view">
        <field name="name">rn.ai.document.template.form</field>
        <field name="model">rn.ai.document.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="type_id"/>
                            <field name="language"/>
                            <field name="style"/>
                            <field name="model_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="ai_prompt"/>
                            <field name="placeholder_help"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body_html"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_doc_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">rn.ai.document.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
