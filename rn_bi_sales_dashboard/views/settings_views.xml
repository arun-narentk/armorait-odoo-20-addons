<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_bi_dashboard_settings_form" model="ir.ui.view">
        <field name="name">rn.bi.dashboard.settings.form</field>
        <field name="model">rn.bi.dashboard.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="theme"/>
                        <field name="refresh_interval"/>
                        <field name="chart_color_primary"/>
                        <field name="chart_color_secondary"/>
                        <field name="decimal_precision"/>
                        <field name="timezone"/>
                        <field name="cache_ttl_seconds"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_bi_dashboard_settings" model="ir.actions.act_window">
        <field name="name">BI Settings</field>
        <field name="res_model">rn.bi.dashboard.settings</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="res_config_settings_view_form_rn_bi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.bi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="BI Sales Dashboard" name="rn_bi_sales_dashboard" groups="rn_bi_sales_dashboard.group_rn_bi_dashboard_manager">
                    <block title="General">
                        <setting string="Enable BI Sales Dashboard"><field name="rn_bi_sales_enabled"/></setting>
                        <setting string="Refresh Interval"><field name="rn_bi_sales_refresh"/></setting>
                        <setting string="Cache TTL"><field name="rn_bi_sales_cache_ttl"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_rn_bi_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'rn_bi_sales_dashboard'}</field>
    </record>
</odoo>
