<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_bi_dashboard_filter_list" model="ir.ui.view">
        <field name="name">rn.bi.dashboard.filter.list</field>
        <field name="model">rn.bi.dashboard.filter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_preset"/>
                <field name="shared"/>
            </list>
        </field>
    </record>
    <record id="view_rn_bi_dashboard_filter_form" model="ir.ui.view">
        <field name="name">rn.bi.dashboard.filter.form</field>
        <field name="model">rn.bi.dashboard.filter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_preset"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="salesperson_ids" widget="many2many_tags"/>
                        <field name="team_ids" widget="many2many_tags"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="country_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="categ_ids" widget="many2many_tags"/>
                        <field name="shared"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_bi_dashboard_filter" model="ir.actions.act_window">
        <field name="name">Filters</field>
        <field name="res_model">rn.bi.dashboard.filter</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_bi_sales_filter_wizard_form" model="ir.ui.view">
        <field name="name">rn.bi.sales.filter.wizard.form</field>
        <field name="model">rn.bi.sales.filter.wizard</field>
        <field name="arch" type="xml">
            <form string="Open Dashboard with Filters">
                <group>
                    <field name="date_preset"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="salesperson_ids" widget="many2many_tags"/>
                    <field name="team_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_open_dashboard" type="object" string="Open Dashboard" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_bi_sales_filter_wizard" model="ir.actions.act_window">
        <field name="name">Filtered Dashboard</field>
        <field name="res_model">rn.bi.sales.filter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_rn_bi_compare_period_wizard_form" model="ir.ui.view">
        <field name="name">rn.bi.compare.period.wizard.form</field>
        <field name="model">rn.bi.compare.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Compare Periods">
                <group>
                    <group string="Period A">
                        <field name="period_a_from"/>
                        <field name="period_a_to"/>
                    </group>
                    <group string="Period B">
                        <field name="period_b_from"/>
                        <field name="period_b_to"/>
                    </group>
                </group>
                <field name="result_html"/>
                <footer>
                    <button name="action_compare" type="object" string="Compare" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_bi_compare_period_wizard" model="ir.actions.act_window">
        <field name="name">Compare Periods</field>
        <field name="res_model">rn.bi.compare.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
