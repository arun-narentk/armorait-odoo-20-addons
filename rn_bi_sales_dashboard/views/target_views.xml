<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_bi_sales_target_list" model="ir.ui.view">
        <field name="name">rn.bi.sales.target.list</field>
        <field name="model">rn.bi.sales.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="target_amount"/>
                <field name="achieved_amount"/>
                <field name="achievement_pct"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_bi_sales_target_form" model="ir.ui.view">
        <field name="name">rn.bi.sales.target.form</field>
        <field name="model">rn.bi.sales.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="period_type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="target_amount"/>
                            <field name="achieved_amount"/>
                            <field name="achievement_pct"/>
                            <field name="remaining_amount"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_bi_sales_target" model="ir.actions.act_window">
        <field name="name">Sales Targets</field>
        <field name="res_model">rn.bi.sales.target</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_bi_sales_kpi" model="ir.actions.act_window">
        <field name="name">KPI Cards</field>
        <field name="res_model">rn.bi.sales.kpi</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
