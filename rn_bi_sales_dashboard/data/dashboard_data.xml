<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
<record id="rn_bi_kpi_revenue" model="rn.bi.sales.kpi">
<field name="name">Total Revenue</field><field name="code">total_revenue</field>
<field name="kpi_type">total_revenue</field><field name="sequence">10</field>
</record>
<record id="rn_bi_kpi_orders" model="rn.bi.sales.kpi">
<field name="name">Orders</field><field name="code">orders</field>
<field name="kpi_type">orders</field><field name="sequence">20</field>
</record>
<record id="rn_bi_kpi_aov" model="rn.bi.sales.kpi">
<field name="name">Average Order Value</field><field name="code">aov</field>
<field name="kpi_type">aov</field><field name="sequence">30</field>
</record>
<record id="rn_bi_kpi_quotes" model="rn.bi.sales.kpi">
<field name="name">Quotation Value</field><field name="code">quotation_value</field>
<field name="kpi_type">quotation_value</field><field name="sequence">40</field>
</record>
<record id="rn_bi_default_dashboard" model="rn.bi.sales.dashboard">
<field name="name">Sales Executive Dashboard</field>
<field name="is_default" eval="True"/>
<field name="theme">corporate</field>
<field name="refresh_interval">300</field>
</record>
<record id="rn_bi_widget_revenue" model="rn.bi.dashboard.widget">
<field name="name">Revenue Card</field>
<field name="dashboard_id" ref="rn_bi_default_dashboard"/>
<field name="widget_type">kpi_card</field>
<field name="kpi_id" ref="rn_bi_kpi_revenue"/>
<field name="width">3</field>
<field name="sequence">10</field>
</record>
<record id="rn_bi_widget_orders" model="rn.bi.dashboard.widget">
<field name="name">Orders Card</field>
<field name="dashboard_id" ref="rn_bi_default_dashboard"/>
<field name="widget_type">kpi_card</field>
<field name="kpi_id" ref="rn_bi_kpi_orders"/>
<field name="width">3</field>
<field name="sequence">20</field>
</record>
<record id="rn_bi_widget_trend" model="rn.bi.dashboard.widget">
<field name="name">Monthly Sales Trend</field>
<field name="dashboard_id" ref="rn_bi_default_dashboard"/>
<field name="widget_type">line_chart</field>
<field name="chart_key">monthly_trend</field>
<field name="width">6</field>
<field name="sequence">100</field>
</record>
<record id="rn_bi_widget_salespeople" model="rn.bi.dashboard.widget">
<field name="name">Salesperson Ranking</field>
<field name="dashboard_id" ref="rn_bi_default_dashboard"/>
<field name="widget_type">bar_chart</field>
<field name="chart_key">salesperson</field>
<field name="width">6</field>
<field name="sequence">110</field>
</record>
</data></odoo>