<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_bi_sales">
        <field name="name">BI Sales Dashboard</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_rn_bi_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_bi_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_bi_sales_user" model="res.groups">
        <field name="name">Sales User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_bi_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_bi_readonly'))]"/>
    </record>
    <record id="group_rn_bi_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_bi_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_bi_sales_user'))]"/>
    </record>
    <record id="group_rn_bi_dashboard_manager" model="res.groups">
        <field name="name">Dashboard Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_bi_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_bi_sales_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
