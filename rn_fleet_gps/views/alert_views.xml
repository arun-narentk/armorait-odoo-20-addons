<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_fleet_alert_list" model="ir.ui.view">
        <field name="name">rn.fleet.alert.list</field>
        <field name="model">rn.fleet.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="alert_type"/>
                <field name="severity"/>
                <field name="vehicle_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_rn_fleet_alert_form" model="ir.ui.view">
        <field name="name">rn.fleet.alert.form</field>
        <field name="model">rn.fleet.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" invisible="state != 'open'"/>
                    <button name="action_resolve" type="object" string="Resolve" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="alert_type"/>
                        <field name="severity"/>
                        <field name="vehicle_id"/>
                        <field name="device_id"/>
                        <field name="geofence_id"/>
                        <field name="value"/>
                        <field name="threshold"/>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_fleet_alert" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">rn.fleet.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
