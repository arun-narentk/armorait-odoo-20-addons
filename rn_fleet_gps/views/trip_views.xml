<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_fleet_trip_list" model="ir.ui.view">
        <field name="name">rn.fleet.trip.list</field>
        <field name="model">rn.fleet.trip</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="distance_km"/>
                <field name="max_speed"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_fleet_trip_form" model="ir.ui.view">
        <field name="name">rn.fleet.trip.form</field>
        <field name="model">rn.fleet.trip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Close Trip" class="btn-primary" invisible="state != 'running'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="device_id"/>
                            <field name="destination"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="distance_km"/>
                            <field name="duration_minutes"/>
                            <field name="avg_speed"/>
                            <field name="max_speed"/>
                            <field name="fuel_used"/>
                            <field name="expense_total"/>
                        </group>
                    </group>
                    <group string="Coordinates">
                        <field name="start_latitude"/>
                        <field name="start_longitude"/>
                        <field name="end_latitude"/>
                        <field name="end_longitude"/>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_fleet_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">rn.fleet.trip</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_fleet_export_trips_form" model="ir.ui.view">
        <field name="name">rn.fleet.export.trips.wizard.form</field>
        <field name="model">rn.fleet.export.trips.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Trips">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="limit"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export CSV" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_fleet_export_trips" model="ir.actions.act_window">
        <field name="name">Export Trips</field>
        <field name="res_model">rn.fleet.export.trips.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
