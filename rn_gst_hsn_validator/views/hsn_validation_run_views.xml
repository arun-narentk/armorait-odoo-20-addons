<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_hsn_validation_run_list" model="ir.ui.view">
        <field name="name">rn.gst.hsn.validation.run.list</field>
        <field name="model">rn.gst.hsn.validation.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_hsn_validation_run_form" model="ir.ui.view">
        <field name="name">rn.gst.hsn.validation.run.form</field>
        <field name="model">rn.gst.hsn.validation.run</field>
        <field name="arch" type="xml">
            <form string="HSN/SAC Validation Run">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rn_gst_hsn_validation_run_search" model="ir.ui.view">
        <field name="name">rn.gst.hsn.validation.run.search</field>
        <field name="model">rn.gst.hsn.validation.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rn_gst_hsn_validation_run" model="ir.actions.act_window">
        <field name="name">Validation Runs</field>
        <field name="res_model">rn.gst.hsn.validation.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
