<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_hsn_validation_rule_list" model="ir.ui.view">
        <field name="name">rn.gst.hsn.validation.rule.list</field>
        <field name="model">rn.gst.hsn.validation.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="severity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_hsn_validation_rule_form" model="ir.ui.view">
        <field name="name">rn.gst.hsn.validation.rule.form</field>
        <field name="model">rn.gst.hsn.validation.rule</field>
        <field name="arch" type="xml">
            <form string="HSN/SAC Validation Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="severity"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_gst_hsn_validation_rule" model="ir.actions.act_window">
        <field name="name">Validation Rules</field>
        <field name="res_model">rn.gst.hsn.validation.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
