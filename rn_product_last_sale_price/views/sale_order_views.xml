<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_rn_product_last_sale_price" model="ir.ui.view">
        <field name="name">sale.order.form.rn.product.last.sale.price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='price_unit']" position="before">
                <field name="last_sale_price"
                         string="Last Sale Price"
                         optional="show"
                         readonly="1"
                         decoration-info="last_sale_price &gt; 0"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="last_sale_price" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
