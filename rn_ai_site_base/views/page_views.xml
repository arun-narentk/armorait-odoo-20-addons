<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_site_page_form" model="ir.ui.view">
        <field name="name">rn.ai.site.page.form</field>
        <field name="model">rn.ai.site.page</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="site_id"/>
                            <field name="page_type"/>
                            <field name="sequence"/>
                            <field name="is_published"/>
                        </group>
                        <group string="SEO">
                            <field name="seo_title"/>
                            <field name="seo_description"/>
                            <field name="og_title"/>
                            <field name="og_description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Blocks" name="blocks">
                            <field name="block_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="block_type"/>
                                    <field name="headline"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="block_type"/>
                                        <field name="headline"/>
                                        <field name="subheadline"/>
                                        <field name="body_html"/>
                                        <field name="cta_label"/>
                                        <field name="cta_url"/>
                                        <field name="image_url"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Structured Data" name="schema">
                            <field name="structured_data_json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_site_page" model="ir.actions.act_window">
        <field name="name">Pages</field>
        <field name="res_model">rn.ai.site.page</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
