<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_site_settings_form" model="ir.ui.view">
        <field name="name">rn.ai.site.settings.form</field>
        <field name="model">rn.ai.site.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="default_language"/>
                            <field name="publisher_mode"/>
                            <field name="max_sites"/>
                            <field name="credit_balance"/>
                        </group>
                        <group>
                            <field name="enable_llm_content"/>
                            <field name="enable_auto_crm"/>
                            <field name="enable_auto_seo"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_site_settings" model="ir.actions.act_window">
        <field name="name">AI Site Settings</field>
        <field name="res_model">rn.ai.site.settings</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_ai_site_subscription_list" model="ir.ui.view">
        <field name="name">rn.ai.site.subscription.list</field>
        <field name="model">rn.ai.site.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="ai_credits_monthly"/>
                <field name="monthly_fee"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_rn_ai_site_subscription" model="ir.actions.act_window">
        <field name="name">SaaS Subscriptions</field>
        <field name="res_model">rn.ai.site.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_config_settings_view_form_rn_ai_site" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.ai.site</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Business Launch" name="rn_ai_site_base">
                    <block title="Launch Platform">
                        <setting string="Default Language">
                            <field name="ai_site_default_language"/>
                        </setting>
                        <setting string="LLM Content (companion module)">
                            <field name="ai_site_enable_llm"/>
                        </setting>
                        <setting string="Auto CRM on Publish">
                            <field name="ai_site_enable_auto_crm"/>
                        </setting>
                        <setting string="Publisher Mode">
                            <field name="ai_site_publisher_mode"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_rn_ai_site_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'rn_ai_site_base'}</field>
    </record>
</odoo>
