<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_site_brief_list" model="ir.ui.view">
        <field name="name">rn.ai.site.brief.list</field>
        <field name="model">rn.ai.site.brief</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="business_name"/>
                <field name="business_type"/>
                <field name="location"/>
                <field name="language"/>
                <field name="state"/>
                <field name="site_id"/>
            </list>
        </field>
    </record>
    <record id="view_rn_ai_site_brief_form" model="ir.ui.view">
        <field name="name">rn.ai.site.brief.form</field>
        <field name="model">rn.ai.site.brief</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_analyze" type="object" string="Analyze Brief" invisible="state not in ('draft',)"/>
                    <button name="action_generate_site" type="object" string="Generate Website" class="btn-primary" invisible="state in ('generated', 'published')"/>
                    <button name="action_open_site" type="object" string="Open Site" invisible="not site_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,analyzed,generated,published"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="name"/>
                            <field name="business_name"/>
                            <field name="business_type"/>
                            <field name="location"/>
                            <field name="language"/>
                            <field name="tone"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="whatsapp"/>
                            <field name="target_audience"/>
                            <field name="keywords"/>
                            <field name="partner_id"/>
                            <field name="site_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe your business in plain language..."/>
                        <field name="services" placeholder="Comma-separated services or products"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_site_brief" model="ir.actions.act_window">
        <field name="name">Business Briefs</field>
        <field name="res_model">rn.ai.site.brief</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
