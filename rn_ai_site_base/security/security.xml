<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_ai_site">
        <field name="name">ARMORA AI Business Launch</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>
    <record id="group_rn_ai_site_user" model="res.groups">
        <field name="name">Site Creator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_site"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_ai_site_editor" model="res.groups">
        <field name="name">Content Editor</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_site"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_ai_site_user'))]"/>
    </record>
    <record id="group_rn_ai_site_manager" model="res.groups">
        <field name="name">Launch Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_site"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_ai_site_editor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
