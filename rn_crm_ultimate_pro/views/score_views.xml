<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_crm_score_rule_list" model="ir.ui.view">
        <field name="name">rn.crm.score.rule.list</field>
        <field name="model">rn.crm.score.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="points"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_crm_score_rule_form" model="ir.ui.view">
        <field name="name">rn.crm.score.rule.form</field>
        <field name="model">rn.crm.score.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rule_type"/>
                        <field name="points"/>
                        <field name="max_points"/>
                        <field name="domain"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_crm_score_rule" model="ir.actions.act_window">
        <field name="name">Score Rules</field>
        <field name="res_model">rn.crm.score.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
