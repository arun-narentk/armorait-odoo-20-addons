<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_crm_duplicate_batch_list" model="ir.ui.view">
        <field name="name">rn.crm.duplicate.batch.list</field>
        <field name="model">rn.crm.duplicate.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sensitivity"/>
                <field name="match_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_crm_duplicate_batch_form" model="ir.ui.view">
        <field name="name">rn.crm.duplicate.batch.form</field>
        <field name="model">rn.crm.duplicate.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sensitivity"/>
                        <field name="match_count"/>
                        <field name="state"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="lead_id"/>
                            <field name="duplicate_lead_id"/>
                            <field name="match_on"/>
                            <field name="confidence"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_crm_duplicate_batch" model="ir.actions.act_window">
        <field name="name">Duplicate Scans</field>
        <field name="res_model">rn.crm.duplicate.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_crm_merge_log" model="ir.actions.act_window">
        <field name="name">Merge Logs</field>
        <field name="res_model">rn.crm.merge.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
