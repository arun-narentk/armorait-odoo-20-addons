<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_crm">
        <field name="name">CRM Ultimate Pro</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_rn_crm_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_crm_salesperson" model="res.groups">
        <field name="name">Salesperson</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_crm_readonly'))]"/>
    </record>
    <record id="group_rn_crm_manager" model="res.groups">
        <field name="name">CRM Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_crm_salesperson'))]"/>
    </record>
    <record id="group_rn_crm_admin" model="res.groups">
        <field name="name">CRM Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_crm_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
