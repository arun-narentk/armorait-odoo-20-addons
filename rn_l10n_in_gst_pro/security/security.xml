<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_rn_gst">
        <field name="name">GST Compliance Pro</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_rn_gst_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_gst_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_readonly'))]"/>
    </record>

    <record id="group_rn_gst_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_auditor'))]"/>
    </record>

    <record id="group_rn_gst_manager" model="res.groups">
        <field name="name">GST Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_accountant'))]"/>
    </record>

    <record id="group_rn_gst_admin" model="res.groups">
        <field name="name">GST Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
