<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_reconciliation_list" model="ir.ui.view">
        <field name="name">rn.gst.reconciliation.list</field>
        <field name="model">rn.gst.reconciliation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_id"/>
                <field name="reconciliation_type"/>
                <field name="mismatch_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_gst_reconciliation_form" model="ir.ui.view">
        <field name="name">rn.gst.reconciliation.form</field>
        <field name="model">rn.gst.reconciliation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="period_id"/>
                        <field name="reconciliation_type"/>
                        <field name="mismatch_count"/>
                        <field name="state"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="notes"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="move_id"/>
                            <field name="expected_amount"/>
                            <field name="actual_amount"/>
                            <field name="difference"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_gst_reconciliation" model="ir.actions.act_window">
        <field name="name">Reconciliations</field>
        <field name="res_model">rn.gst.reconciliation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
