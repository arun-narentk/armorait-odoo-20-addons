<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_period_list" model="ir.ui.view">
        <field name="name">rn.gst.period.list</field>
        <field name="model">rn.gst.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="financial_year"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_gst_period_form" model="ir.ui.view">
        <field name="name">rn.gst.period.form</field>
        <field name="model">rn.gst.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="financial_year"/>
                            <field name="period_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="return_ids">
                        <list>
                            <field name="name"/>
                            <field name="return_type"/>
                            <field name="state"/>
                            <field name="total_tax"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_gst_period" model="ir.actions.act_window">
        <field name="name">GST Periods</field>
        <field name="res_model">rn.gst.period</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
