<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_gstr1_wizard_form" model="ir.ui.view">
        <field name="name">rn.gst.gstr1.wizard.form</field>
        <field name="model">rn.gst.gstr1.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate GSTR-1">
                <group>
                    <field name="period_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="auto_compute"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_gst_gstr1_wizard" model="ir.actions.act_window">
        <field name="name">Generate GSTR-1</field>
        <field name="res_model">rn.gst.gstr1.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

