        <field name="name">rn.gst.reconciliation.wizard.form</field>
        <field name="model">rn.gst.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Reconciliation">
                <group>
                    <field name="period_id"/>
