<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_temple_branch_list" model="ir.ui.view">
        <field name="name">rn.temple.branch.list</field>
        <field name="model">rn.temple.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="temple_id"/>
                <field name="is_head_office"/>
                <field name="city"/>
                <field name="phone"/>
            </list>
        </field>
    </record>
    <record id="view_rn_temple_branch_form" model="ir.ui.view">
        <field name="name">rn.temple.branch.form</field>
        <field name="model">rn.temple.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="temple_id"/>
                            <field name="is_head_office"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="city"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="timing_ids">
                        <list editable="bottom">
                            <field name="day_of_week"/>
                            <field name="session_type"/>
                            <field name="time_open" widget="float_time"/>
                            <field name="time_close" widget="float_time"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_temple_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">rn.temple.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
