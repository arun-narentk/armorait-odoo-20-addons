<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_temple_festival_calendar" model="ir.ui.view">
        <field name="name">rn.temple.festival.calendar</field>
        <field name="model">rn.temple.festival</field>
        <field name="arch" type="xml">
            <calendar string="Festivals" date_start="date_start" date_stop="date_end" color="festival_type" mode="month">
                <field name="name"/>
                <field name="temple_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="view_rn_temple_festival_list" model="ir.ui.view">
        <field name="name">rn.temple.festival.list</field>
        <field name="model">rn.temple.festival</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="temple_id"/>
                <field name="branch_id"/>
                <field name="festival_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="budget_estimate"/>
            </list>
        </field>
    </record>
    <record id="view_rn_temple_festival_form" model="ir.ui.view">
        <field name="name">rn.temple.festival.form</field>
        <field name="model">rn.temple.festival</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" invisible="state != 'confirmed'"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state not in ('confirmed', 'ongoing')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,ongoing,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="temple_id"/>
                        <field name="branch_id"/>
                        <field name="festival_type"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="budget_estimate"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_temple_festival" model="ir.actions.act_window">
        <field name="name">Festival Calendar</field>
        <field name="res_model">rn.temple.festival</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
