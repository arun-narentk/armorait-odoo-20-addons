<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_temple_trustee_list" model="ir.ui.view">
        <field name="name">rn.temple.trustee.list</field>
        <field name="model">rn.temple.trustee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="temple_id"/>
                <field name="role"/>
                <field name="phone"/>
                <field name="is_signatory"/>
            </list>
        </field>
    </record>
    <record id="view_rn_temple_trustee_form" model="ir.ui.view">
        <field name="name">rn.temple.trustee.form</field>
        <field name="model">rn.temple.trustee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="temple_id"/>
                        <field name="role"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="term_start"/>
                        <field name="term_end"/>
                        <field name="is_signatory"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_temple_trustee" model="ir.actions.act_window">
        <field name="name">Trustees</field>
        <field name="res_model">rn.temple.trustee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
