<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_debit_note_validation_list" model="ir.ui.view">
        <field name="name">rn.gst.debit.note.validation.list</field>
        <field name="model">rn.gst.debit.note.validation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="move_id"/>
                <field name="reason_id"/>
                <field name="state"/>
                <field name="severity"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_debit_note_validation_form" model="ir.ui.view">
        <field name="name">rn.gst.debit.note.validation.form</field>
        <field name="model">rn.gst.debit.note.validation</field>
        <field name="arch" type="xml">
            <form string="Debit Note Validation">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,pass,warning,blocked"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="move_id"/>
                        <field name="reason_id"/>
                        <field name="severity"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note" colspan="2"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Debit-note validation checks additional taxable value and tax (liability increase).
                        Do not apply credit-note reduction rules here. Odoo remains responsible for tax calculation.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rn_gst_debit_note_validation_search" model="ir.ui.view">
        <field name="name">rn.gst.debit.note.validation.search</field>
        <field name="model">rn.gst.debit.note.validation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="move_id"/>
                <filter name="filter_blocked" string="Blocked" domain="[('state', '=', 'blocked')]"/>
                <filter name="filter_warning" string="Warning" domain="[('state', '=', 'warning')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rn_gst_debit_note_validation" model="ir.actions.act_window">
        <field name="name">Debit Note Validations</field>
        <field name="res_model">rn.gst.debit.note.validation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
