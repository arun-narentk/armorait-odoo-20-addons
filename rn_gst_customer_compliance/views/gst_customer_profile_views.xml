<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_customer_profile_view_list" model="ir.ui.view">
        <field name="name">rn.gst.customer.profile.list</field>
        <field name="model">rn.gst.customer.profile</field>
        <field name="arch" type="xml">
            <list string="Customer GST Profiles" create="false" decoration-danger="risk == 'high'"
                  decoration-warning="risk == 'medium'">
                <header>
                    <button name="action_create_all" type="object" string="Profile All Customers" display="always"
                            class="btn-primary"/>
                    <button name="action_refresh" type="object" string="Refresh"/>
                </header>
                <field name="partner_id"/>
                <field name="gstin"/>
                <field name="gst_treatment" optional="show"/>
                <field name="gstin_status" optional="show"/>
                <field name="invoice_count" optional="show"/>
                <field name="sales_amount" sum="Total" optional="show"/>
                <field name="credit_amount" sum="Total" optional="hide"/>
                <field name="score"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="risk" widget="badge" decoration-success="risk == 'low'" decoration-warning="risk == 'medium'"
                       decoration-danger="risk == 'high'"/>
            </list>
        </field>
    </record>

    <record id="rn_gst_customer_profile_view_form" model="ir.ui.view">
        <field name="name">rn.gst.customer.profile.form</field>
        <field name="model">rn.gst.customer.profile</field>
        <field name="arch" type="xml">
            <form string="Customer GST Profile" create="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="partner_id" readonly="1"/></h1>
                        <field name="risk" widget="badge" decoration-success="risk == 'low'"
                               decoration-warning="risk == 'medium'" decoration-danger="risk == 'high'"/>
                    </div>
                    <group>
                        <group>
                            <field name="gstin"/>
                            <field name="gst_treatment"/>
                            <field name="gstin_status"/>
                            <field name="score"/>
                        </group>
                        <group>
                            <field name="sales_amount"/>
                            <field name="credit_amount"/>
                            <field name="refreshed_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="finding_ids" readonly="1">
                        <list decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'">
                            <field name="severity" widget="badge"/>
                            <field name="message"/>
                            <field name="count"/>
                            <field name="penalty" string="Points Off"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rn_gst_customer_profile_view_search" model="ir.ui.view">
        <field name="name">rn.gst.customer.profile.search</field>
        <field name="model">rn.gst.customer.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="gstin"/>
                <filter string="High Risk" name="high" domain="[('risk', '=', 'high')]"/>
                <filter string="Medium Risk" name="medium" domain="[('risk', '=', 'medium')]"/>
                <filter string="B2B Shown as B2C" name="b2b_as_b2c" domain="[('finding_ids.code', '=', 'b2b_as_b2c')]"/>
                <group>
                    <filter string="Risk" name="group_risk" context="{'group_by': 'risk'}"/>
                    <filter string="GST Treatment" name="group_treatment" context="{'group_by': 'gst_treatment'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rn_gst_customer_profile_action" model="ir.actions.act_window">
        <field name="name">Customer GST Profiles</field>
        <field name="res_model">rn.gst.customer.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer profiles yet</p>
            <p>Click "Profile All Customers" to check every customer invoiced in the last 12 months.</p>
        </field>
    </record>
</odoo>
