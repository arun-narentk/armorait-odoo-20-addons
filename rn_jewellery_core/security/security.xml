<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_jewellery">
        <field name="name">ARMORA Jewellery ERP</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_jewellery_sales" model="res.groups">
        <field name="name">Sales</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_jewellery"/>
    </record>
    <record id="group_rn_jewellery_production" model="res.groups">
        <field name="name">Production</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_jewellery"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_jewellery_sales'))]"/>
    </record>
    <record id="group_rn_jewellery_manager" model="res.groups">
        <field name="name">Jewellery Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_jewellery"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_jewellery_production'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
