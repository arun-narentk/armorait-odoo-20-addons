<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_jewellery_core.RetailDashboard">
        <div class="o_rn_jewellery_dashboard p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h1 class="h3 mb-0">Retail Dashboard</h1>
                    <div class="text-muted small">Metal rates, stock value, repairs and custom orders</div>
                </div>
                <button class="btn btn-primary btn-sm" t-on-click="this.refresh">Refresh</button>
            </div>
            <t t-if="this.state.loading"><div class="text-muted">Loading dashboard...</div></t>
            <t t-else="">
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-4"><div class="o_rn_jewellery_card"><div class="label">Gold Rate (per g)</div><div class="value" t-out="this.formatNumber(this.state.data.gold_rate)"/></div></div>
                    <div class="col-6 col-md-4"><div class="o_rn_jewellery_card"><div class="label">Silver Rate (per g)</div><div class="value" t-out="this.formatNumber(this.state.data.silver_rate)"/></div></div>
                    <div class="col-6 col-md-4"><div class="o_rn_jewellery_card"><div class="label">Inventory Value</div><div class="value" t-out="this.formatNumber(this.state.data.inventory_value)"/></div></div>
                </div>
                <div class="row g-3">
                    <div class="col-6 col-md-4"><div class="o_rn_jewellery_card"><div class="label">Inventory Items</div><div class="value" t-out="this.state.data.inventory_items || 0"/></div></div>
                    <div class="col-6 col-md-4"><div class="o_rn_jewellery_card"><div class="label">Open Repairs</div><div class="value" t-out="this.state.data.open_repairs || 0"/></div></div>
                    <div class="col-6 col-md-4"><div class="o_rn_jewellery_card"><div class="label">Custom Orders Pending</div><div class="value" t-out="this.state.data.custom_orders_pending || 0"/></div></div>
                </div>
                <div class="text-muted small mt-3">Updated: <t t-out="this.state.data.updated_at"/></div>
            </t>
        </div>
    </t>
</templates>
