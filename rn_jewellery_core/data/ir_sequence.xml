        <field name="code">rn.jewellery.customer.order</field>
        <field name="prefix">CO</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rn_jewellery_repair_order" model="ir.sequence">
        <field name="name">Repair Order</field>
        <field name="code">rn.jewellery.repair.order</field>
        <field name="prefix">REP</field>
        <field name="padding">5</field>
