<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_jewellery_order_tree" model="ir.ui.view">
        <field name="name">rn.jewellery.customer.order.tree</field>
        <field name="model">rn.jewellery.customer.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="delivery_date"/>
                <field name="advance_amount"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_rn_jewellery_order" model="ir.actions.act_window">
        <field name="name">Custom Orders</field>
        <field name="res_model">rn.jewellery.customer.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
