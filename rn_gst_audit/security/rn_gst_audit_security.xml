<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_rn_gst_audit" model="res.groups.privilege">
        <field name="name">GST Audit</field>
        <field name="category_id" ref="rn_gst_base.module_category_rn_gst"/>
    </record>

    <record id="group_rn_gst_audit_user" model="res.groups">
        <field name="name">Audit Preparer</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_audit"/>
        <field name="implied_ids" eval="[(4, ref('rn_gst_base.group_rn_gst_user'))]"/>
    </record>

    <record id="group_rn_gst_audit_reviewer" model="res.groups">
        <field name="name">Audit Reviewer</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_audit_user')), (4, ref('rn_gst_base.group_rn_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
