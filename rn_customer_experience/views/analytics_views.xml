<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_customer_experience_analytics_tree" model="ir.ui.view">
        <field name="name">rn.customer.experience.analytics.tree</field>
        <field name="model">rn.customer.experience.analytics</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_rn_customer_experience_analytics" model="ir.actions.act_window">
        <field name="name">Portal Analytics</field>
        <field name="res_model">rn.customer.experience.analytics</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
