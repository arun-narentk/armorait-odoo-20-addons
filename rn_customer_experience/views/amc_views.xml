<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_customer_experience_amc_tree" model="ir.ui.view">
        <field name="name">rn.customer.experience.amc.tree</field>
        <field name="model">rn.customer.experience.amc</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="renewal_date"/>
                <field name="next_visit_date"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_rn_customer_experience_amc_form" model="ir.ui.view">
        <field name="name">rn.customer.experience.amc.form</field>
        <field name="model">rn.customer.experience.amc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="state"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="renewal_date"/>
                        <field name="next_visit_date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="service_history"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_customer_experience_amc" model="ir.actions.act_window">
        <field name="name">AMC Contracts</field>
        <field name="res_model">rn.customer.experience.amc</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
