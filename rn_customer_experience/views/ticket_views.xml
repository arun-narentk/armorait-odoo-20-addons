<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_customer_experience_ticket_tree" model="ir.ui.view">
        <field name="name">rn.customer.experience.ticket.tree</field>
        <field name="model">rn.customer.experience.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_rn_customer_experience_ticket_form" model="ir.ui.view">
        <field name="name">rn.customer.experience.ticket.form</field>
        <field name="model">rn.customer.experience.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,waiting,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="reference" readonly="1"/></h3>
                    </div>
                    <group>
                        <field name="partner_id"/>
                        <field name="category"/>
                        <field name="priority"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="AI Triage">
                        <field name="ai_category" readonly="1"/>
                        <field name="ai_suggestion" readonly="1"/>
                    </group>
                    <field name="description"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rn_customer_experience_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">rn.customer.experience.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
