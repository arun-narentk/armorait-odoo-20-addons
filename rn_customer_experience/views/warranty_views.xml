<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_customer_experience_warranty_tree" model="ir.ui.view">
        <field name="name">rn.customer.experience.warranty.tree</field>
        <field name="model">rn.customer.experience.warranty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="serial_number"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_rn_customer_experience_warranty_form" model="ir.ui.view">
        <field name="name">rn.customer.experience.warranty.form</field>
        <field name="model">rn.customer.experience.warranty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                        <field name="serial_number"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_customer_experience_warranty" model="ir.actions.act_window">
        <field name="name">Warranty Records</field>
        <field name="res_model">rn.customer.experience.warranty</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
