<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_customer_experience">
        <field name="name">Customer Experience Portal</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>
    <record id="group_rn_customer_experience_user" model="res.groups">
        <field name="name">Portal Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_experience"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_customer_experience_admin" model="res.groups">
        <field name="name">Portal Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_experience"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_customer_experience_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
