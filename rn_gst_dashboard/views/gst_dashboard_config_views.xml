<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_dashboard_filter_list" model="ir.ui.view">
        <field name="name">rn.gst.dashboard.filter.list</field>
        <field name="model">rn.gst.dashboard.filter</field>
        <field name="arch" type="xml">
            <list string="Dashboard Filter Presets">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="gstin"/>
                <field name="financial_year"/>
                <field name="return_period"/>
                <field name="user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_dashboard_filter_form" model="ir.ui.view">
        <field name="name">rn.gst.dashboard.filter.form</field>
        <field name="model">rn.gst.dashboard.filter</field>
        <field name="arch" type="xml">
            <form string="Dashboard Filter Preset">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="gst_registration_id"/>
                        <field name="gstin"/>
                        <field name="financial_year"/>
                        <field name="return_period"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="user_id"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_gst_dashboard_filter" model="ir.actions.act_window">
        <field name="name">Dashboard Filter Presets</field>
        <field name="res_model">rn.gst.dashboard.filter</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
