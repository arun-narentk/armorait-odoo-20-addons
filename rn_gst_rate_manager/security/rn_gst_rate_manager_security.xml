<odoo>
    <record id="res_groups_privilege_rn_gst_rate_manager" model="res.groups.privilege">
        <field name="name">GST Rate</field>
        <field name="category_id" ref="rn_gst_base.module_category_rn_gst"/>
    </record>

    <record id="group_rn_gst_rate_manager_user" model="res.groups">
        <field name="name">GST Rate User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_rate_manager"/>
        <field name="implied_ids" eval="[(4, ref('rn_gst_base.group_rn_gst_user'))]"/>
    </record>

    <record id="group_rn_gst_rate_manager_manager" model="res.groups">
        <field name="name">GST Rate Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_rate_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_rate_manager_user')), (4, ref('rn_gst_base.group_rn_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_rn_gst_rate_manager_administrator" model="res.groups">
        <field name="name">GST Rate Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_rate_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_rate_manager_manager')), (4, ref('rn_gst_base.group_rn_gst_administrator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
