<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_rate_history_list" model="ir.ui.view">
        <field name="name">rn.gst.rate.history.list</field>
        <field name="model">rn.gst.rate.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="rate_id"/>
                <field name="change_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_rate_history_form" model="ir.ui.view">
        <field name="name">rn.gst.rate.history.form</field>
        <field name="model">rn.gst.rate.history</field>
        <field name="arch" type="xml">
            <form string="GST Rate History" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate_id"/>
                        <field name="change_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="note" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_gst_rate_history" model="ir.actions.act_window">
        <field name="name">Rate History</field>
        <field name="res_model">rn.gst.rate.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
