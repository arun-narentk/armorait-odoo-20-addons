<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="visual_status_sale_draft" model="rn.visual.status">
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="field_name">state</field>
            <field name="field_value">draft</field>
            <field name="emoji">📝</field>
            <field name="label">Draft</field>
            <field name="color">gray</field>
            <field name="sequence">10</field>
        </record>

        <record id="visual_status_sale_confirmed" model="rn.visual.status">
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="field_name">state</field>
            <field name="field_value">sale</field>
            <field name="emoji">🟢</field>
            <field name="label">Confirmed</field>
            <field name="color">green</field>
            <field name="sequence">20</field>
        </record>

        <record id="visual_status_invoice_posted" model="rn.visual.status">
            <field name="model_id" ref="account.model_account_move"/>
            <field name="field_name">state</field>
            <field name="field_value">posted</field>
            <field name="emoji">💰</field>
            <field name="label">Posted</field>
            <field name="color">blue</field>
            <field name="sequence">30</field>
        </record>

        <record id="visual_status_crm_hot" model="rn.visual.status">
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="field_name">priority</field>
            <field name="field_value">3</field>
            <field name="emoji">🔥</field>
            <field name="label">Hot</field>
            <field name="color">red</field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
