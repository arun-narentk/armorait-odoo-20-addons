<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_hr_intel">
        <field name="name">ARMORA Workforce Intelligence</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_rn_hr_intel_user" model="res.groups">
        <field name="name">HR Analyst</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hr_intel"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="group_rn_hr_intel_manager" model="res.groups">
        <field name="name">HR Intelligence Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hr_intel"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hr_intel_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
