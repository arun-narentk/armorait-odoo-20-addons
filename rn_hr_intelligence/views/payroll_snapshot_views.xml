<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hr_payroll_snapshot_tree" model="ir.ui.view">
        <field name="name">rn.hr.payroll.snapshot.tree</field>
        <field name="model">rn.hr.payroll.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="period"/>
                <field name="gross_salary"/>
                <field name="net_salary"/>
                <field name="overtime_cost"/>
                <field name="headcount"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>
    <record id="action_rn_hr_payroll_snapshot" model="ir.actions.act_window">
        <field name="name">Payroll Snapshots</field>
        <field name="res_model">rn.hr.payroll.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
