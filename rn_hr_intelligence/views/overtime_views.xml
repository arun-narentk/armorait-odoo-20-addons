<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hr_overtime_tree" model="ir.ui.view">
        <field name="name">rn.hr.overtime.log.tree</field>
        <field name="model">rn.hr.overtime.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <field name="hours"/>
                <field name="cost"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hr_overtime_form" model="ir.ui.view">
        <field name="name">rn.hr.overtime.log.form</field>
        <field name="model">rn.hr.overtime.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="hours"/>
                        <field name="hourly_rate"/>
                        <field name="cost"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_hr_overtime" model="ir.actions.act_window">
        <field name="name">Overtime Logs</field>
        <field name="res_model">rn.hr.overtime.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
