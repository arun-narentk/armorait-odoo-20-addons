<odoo>
    <!-- Armora GST suite security groups (shared by all rn_gst_* modules). -->
    <record id="module_category_rn_gst" model="ir.module.category">
        <field name="name">Armora GST</field>
        <field name="sequence">34</field>
    </record>

    <record id="res_groups_privilege_rn_gst" model="res.groups.privilege">
        <field name="name">GST Suite</field>
        <field name="category_id" ref="module_category_rn_gst"/>
    </record>

    <record id="group_rn_gst_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_rn_gst_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_rn_gst_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
