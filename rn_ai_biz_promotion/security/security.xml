<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_ai_biz_promotion">
        <field name="name">AI BIZ Promotion</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_rn_ai_biz_promotion_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_biz_promotion"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_ai_biz_promotion_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_biz_promotion"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_ai_biz_promotion_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
