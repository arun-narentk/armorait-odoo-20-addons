<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_biz_promotion_list" model="ir.ui.view">
        <field name="name">ai.biz.promotion.list</field>
        <field name="model">ai.biz.promotion</field>
        <field name="arch" type="xml">
            <list string="AI BIZ Promotions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="title"/>
                <field name="subtitle"/>
                <field name="benefit_count"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ai_biz_promotion_form" model="ir.ui.view">
        <field name="name">ai.biz.promotion.form</field>
        <field name="model">ai.biz.promotion</field>
        <field name="arch" type="xml">
            <form string="AI BIZ Promotion">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_website"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-globe">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Website</span>
                                <span class="o_stat_text">/ai-biz</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="banner_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Internal name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="button_text"/>
                            <field name="button_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General Information" name="general">
                            <group>
                                <field name="title"/>
                                <field name="subtitle"/>
                            </group>
                            <group string="Description">
                                <field name="description" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Bottom Section">
                                <field name="footer_text" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Benefits" name="benefits">
                            <field name="benefit_ids" mode="list,kanban">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="icon" widget="image" options="{'size': [48, 48]}"/>
                                    <field name="title"/>
                                    <field name="description"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="icon" widget="image"/>
                                        <field name="sequence"/>
                                        <field name="title"/>
                                        <field name="description"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ai_biz_promotion_search" model="ir.ui.view">
        <field name="name">ai.biz.promotion.search</field>
        <field name="model">ai.biz.promotion</field>
        <field name="arch" type="xml">
            <search string="AI BIZ Promotions">
                <field name="name"/>
                <field name="title"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_biz_promotion" model="ir.actions.act_window">
        <field name="name">AI BIZ Promotions</field>
        <field name="res_model">ai.biz.promotion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI BIZ promotion
            </p>
            <p>
                Configure banner, benefits, and CTA content for the public <code>/ai-biz</code> landing page.
            </p>
        </field>
    </record>
</odoo>
