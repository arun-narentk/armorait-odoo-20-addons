<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_ai_email_settings_form" model="ir.ui.view">
        <field name="name">rn.ai.email.settings.form</field>
        <field name="model">rn.ai.email.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="credit_balance"/>
                        <field name="monthly_credit_limit"/>
                        <field name="default_tone"/>
                        <field name="default_language"/>
                        <field name="enable_llm_provider"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_ai_email_settings" model="ir.actions.act_window">
        <field name="name">AI Email Settings</field>
        <field name="res_model">rn.ai.email.settings</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
