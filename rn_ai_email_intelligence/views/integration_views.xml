<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_ai_email" model="ir.ui.view">
        <field name="name">sale.order.form.ai.email</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_compose_ai_email" type="object" string="AI Email"
                    groups="rn_ai_email_intelligence.group_rn_ai_email_user"/>
            </xpath>
        </field>
    </record>
    <record id="account_move_form_ai_email" model="ir.ui.view">
        <field name="name">account.move.form.ai.email</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_compose_ai_email" type="object" string="AI Email"
                    invisible="move_type not in ('out_invoice', 'in_invoice')"
                    groups="rn_ai_email_intelligence.group_rn_ai_email_user"/>
            </xpath>
        </field>
    </record>
    <record id="crm_lead_form_ai_email" model="ir.ui.view">
        <field name="name">crm.lead.form.ai.email</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_compose_ai_email" type="object" string="AI Email"
                    groups="rn_ai_email_intelligence.group_rn_ai_email_user"/>
            </xpath>
        </field>
    </record>
    <record id="res_partner_form_ai_email" model="ir.ui.view">
        <field name="name">res.partner.form.ai.email</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_compose_ai_email" type="object" class="oe_stat_button" icon="fa-envelope"
                    groups="rn_ai_email_intelligence.group_rn_ai_email_user">
                    <span>AI Email</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
