<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hms_patient_list" model="ir.ui.view">
        <field name="name">rn.hms.patient.list</field>
        <field name="model">rn.hms.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="blood_group"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hms_patient_form" model="ir.ui.view">
        <field name="name">rn.hms.patient.form</field>
        <field name="model">rn.hms.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="patient_code"/>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="emergency_contact"/>
                            <field name="emergency_phone"/>
                            <field name="insurance_provider"/>
                            <field name="insurance_policy"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Clinical">
                        <field name="allergy_ids"/>
                        <field name="medical_history"/>
                        <field name="family_history"/>
                        <field name="note"/>
                    </group>
                    <field name="appointment_ids">
                        <list>
                            <field name="name"/>
                            <field name="doctor_id"/>
                            <field name="start_datetime"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">rn.hms.patient</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_hms_register_patient_wizard_form" model="ir.ui.view">
        <field name="name">rn.hms.register.patient.wizard.form</field>
        <field name="model">rn.hms.register.patient.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Patient">
                <group>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="gender"/>
                    <field name="birth_date"/>
                    <field name="blood_group"/>
                    <field name="emergency_contact"/>
                    <field name="emergency_phone"/>
                </group>
                <footer>
                    <button name="action_register" type="object" string="Register" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_hms_register_patient_wizard" model="ir.actions.act_window">
        <field name="name">Register Patient</field>
        <field name="res_model">rn.hms.register.patient.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
