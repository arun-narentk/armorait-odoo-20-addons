<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hms_department_list" model="ir.ui.view">
        <field name="name">rn.hms.department.list</field>
        <field name="model">rn.hms.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="department_type"/>
                <field name="manager_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hms_department_form" model="ir.ui.view">
        <field name="name">rn.hms.department.form</field>
        <field name="model">rn.hms.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="department_type"/>
                        <field name="manager_id"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_hms_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">rn.hms.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
