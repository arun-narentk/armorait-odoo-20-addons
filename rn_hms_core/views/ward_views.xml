<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hms_ward_list" model="ir.ui.view">
        <field name="name">rn.hms.ward.list</field>
        <field name="model">rn.hms.ward</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="ward_type"/>
                <field name="department_id"/>
                <field name="bed_count"/>
                <field name="occupied_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hms_ward_form" model="ir.ui.view">
        <field name="name">rn.hms.ward.form</field>
        <field name="model">rn.hms.ward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="ward_type"/>
                        <field name="department_id"/>
                        <field name="bed_count"/>
                        <field name="occupied_count"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="note"/>
                    </group>
                    <field name="bed_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="state"/>
                            <field name="patient_id"/>
                            <field name="active"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_hms_ward" model="ir.actions.act_window">
        <field name="name">Wards</field>
        <field name="res_model">rn.hms.ward</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
