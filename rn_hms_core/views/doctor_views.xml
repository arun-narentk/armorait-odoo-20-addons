<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hms_doctor_list" model="ir.ui.view">
        <field name="name">rn.hms.doctor.list</field>
        <field name="model">rn.hms.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="registration_no"/>
                <field name="consulting_fee"/>
                <field name="consultation_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hms_doctor_form" model="ir.ui.view">
        <field name="name">rn.hms.doctor.form</field>
        <field name="model">rn.hms.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="registration_no"/>
                            <field name="employee_id"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="consulting_fee"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="consultation_minutes"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hms_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">rn.hms.doctor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
