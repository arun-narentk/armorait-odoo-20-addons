<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_rn_hms_patient" model="ir.actions.report">
        <field name="name">Patient Card</field>
        <field name="model">rn.hms.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_hms_core.report_patient_document</field>
        <field name="binding_model_id" ref="model_rn_hms_patient"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_patient_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>Patient Card</h2>
                    <p><strong>ID:</strong> <span t-field="doc.patient_code"/></p>
                    <p><strong>Name:</strong> <span t-field="doc.name"/></p>
                    <p><strong>Phone:</strong> <span t-field="doc.phone"/></p>
                    <p><strong>Blood Group:</strong> <span t-field="doc.blood_group"/></p>
                    <p class="mt-4">ARMORA IT Technologies | https://www.armorait.com | info@armorait.com</p>
                </div>
            </t>
        </t>
    </template>
</odoo>
