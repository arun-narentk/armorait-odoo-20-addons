<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product template form -->
    <record id="product_template_form_view_rn_last_purchase" model="ir.ui.view">
        <field name="name">product.template.form.rn.last.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group string="Last Purchase Price" name="rn_last_purchase_price"
                       groups="purchase.group_purchase_user"
                       invisible="not purchase_ok">
                    <field name="last_purchase_price"
                             widget="monetary"
                             options="{'currency_field': 'cost_currency_id'}"/>
                    <field name="last_purchase_date"/>
                    <field name="last_purchase_vendor_id"/>
                    <field name="last_purchase_order_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Product template list -->
    <record id="product_template_tree_view_rn_last_purchase" model="ir.ui.view">
        <field name="name">product.template.list.rn.last.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="last_purchase_price"
                         widget="monetary"
                         options="{'currency_field': 'cost_currency_id'}"
                         optional="hide"
                         groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>

    <!-- Product variant form (same template form is used for variants via is_product_variant) -->
    <record id="product_product_tree_view_rn_last_purchase" model="ir.ui.view">
        <field name="name">product.product.list.rn.last.purchase</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="last_purchase_price"
                         widget="monetary"
                         options="{'currency_field': 'cost_currency_id'}"
                         optional="hide"
                         groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>
</odoo>
