<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_2b_import_wizard_form" model="ir.ui.view">
        <field name="name">rn.gst.2b.import.wizard.form</field>
        <field name="model">rn.gst.2b.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import GSTR-2B">
                <group>
                    <field name="reconciliation_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="filename" invisible="1"/>
                    <field name="data_file" filename="filename"/>
                    <field name="replace_existing"/>
                </group>
                <group string="Column Help">
                    <field name="note" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
