<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_construction_core.SiteDashboard">
        <div class="o_rn_site_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2>Site Engineer</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">My Sites</div><div class="fs-3" t-out="this.state.sites"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Open Issues</div><div class="fs-3" t-out="this.state.issues"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Pending MR</div><div class="fs-3" t-out="this.state.pendingMr"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Logs Today</div><div class="fs-3" t-out="this.state.logsToday"/></div></div>
            </div>
        </div>
    </t>
</templates>
