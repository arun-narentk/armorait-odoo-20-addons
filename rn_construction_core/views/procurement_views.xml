<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_construction_material_request_tree" model="ir.ui.view">
        <field name="name">rn.construction.material.request.tree</field>
        <field name="model">rn.construction.material.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="site_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="state"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>
    <record id="view_rn_construction_material_request_form" model="ir.ui.view">
        <field name="name">rn.construction.material.request.form</field>
        <field name="model">rn.construction.material.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="site_id"/>
                        <field name="requested_by"/>
                        <field name="request_date"/>
                    </group>
                    <group>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="uom"/>
                        <field name="purchase_order_id" readonly="1"/>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_construction_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">rn.construction.material.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
