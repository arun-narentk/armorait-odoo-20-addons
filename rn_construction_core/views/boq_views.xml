<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_construction_boq_tree" model="ir.ui.view">
        <field name="name">rn.construction.boq.tree</field>
        <field name="model">rn.construction.boq</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="construction_project_id"/>
                <field name="version"/>
                <field name="estimated_total"/>
                <field name="actual_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_construction_boq_form" model="ir.ui.view">
        <field name="name">rn.construction.boq.form</field>
        <field name="model">rn.construction.boq</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="construction_project_id"/>
                        <field name="version"/>
                    </group>
                    <group>
                        <field name="estimated_total"/>
                        <field name="actual_total"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="item_type"/>
                            <field name="description"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom"/>
                            <field name="unit_rate"/>
                            <field name="estimated_amount"/>
                            <field name="actual_qty"/>
                            <field name="actual_rate"/>
                            <field name="actual_amount"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_construction_boq" model="ir.actions.act_window">
        <field name="name">BOQ</field>
        <field name="res_model">rn.construction.boq</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
