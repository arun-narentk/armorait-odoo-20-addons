<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_construction_running_bill_tree" model="ir.ui.view">
        <field name="name">rn.construction.running.bill.tree</field>
        <field name="model">rn.construction.running.bill</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="construction_project_id"/>
                <field name="bill_date"/>
                <field name="work_done_amount"/>
                <field name="retention_amount"/>
                <field name="net_payable"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_construction_running_bill_form" model="ir.ui.view">
        <field name="name">rn.construction.running.bill.form</field>
        <field name="model">rn.construction.running.bill</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="construction_project_id"/>
                        <field name="milestone_id"/>
                        <field name="bill_date"/>
                    </group>
                    <group>
                        <field name="work_done_amount"/>
                        <field name="retention_pct"/>
                        <field name="retention_amount"/>
                        <field name="net_payable"/>
                        <field name="invoice_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_construction_running_bill" model="ir.actions.act_window">
        <field name="name">Running Bills</field>
        <field name="res_model">rn.construction.running.bill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
