<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_school_approve_wizard_form" model="ir.ui.view">
        <field name="name">rn.school.admission.approve.wizard.form</field>
        <field name="model">rn.school.admission.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve and Enroll">
                <group>
                    <field name="application_id"/>
                    <field name="class_id"/>
                    <field name="fee_paid"/>
                </group>
                <footer>
                    <button name="action_approve_enroll" type="object" string="Approve and Enroll" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
