<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_school_fee_structure_tree" model="ir.ui.view">
        <field name="name">rn.school.fee.structure.tree</field>
        <field name="model">rn.school.fee.structure</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="grade_level"/><field name="total_fee"/><field name="installment_count"/></list>
        </field>
    </record>
    <record id="view_rn_school_fee_installment_tree" model="ir.ui.view">
        <field name="name">rn.school.fee.installment.tree</field>
        <field name="model">rn.school.fee.installment</field>
        <field name="arch" type="xml">
            <list><field name="student_id"/><field name="name"/><field name="due_date"/><field name="net_amount"/><field name="state"/></list>
        </field>
    </record>
    <record id="action_rn_school_fee_structure" model="ir.actions.act_window">
        <field name="name">Fee Structures</field>
        <field name="res_model">rn.school.fee.structure</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_school_fee_installment" model="ir.actions.act_window">
        <field name="name">Fee Installments</field>
        <field name="res_model">rn.school.fee.installment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
