<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_school_student_tree" model="ir.ui.view">
        <field name="name">rn.school.student.tree</field>
        <field name="model">rn.school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="admission_number"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="risk_level"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_school_student_form" model="ir.ui.view">
        <field name="name">rn.school.student.form</field>
        <field name="model">rn.school.student</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <group>
                        <field name="admission_number" readonly="1"/>
                        <field name="name"/>
                        <field name="class_id"/>
                        <field name="academic_year_id"/>
                        <field name="roll_number"/>
                        <field name="gender"/>
                        <field name="date_of_birth"/>
                        <field name="risk_level"/>
                    </group>
                    <field name="medical_notes"/>
                    <notebook>
                        <page string="Parents"><field name="parent_ids"><list editable="bottom"><field name="name"/><field name="relation"/><field name="mobile"/><field name="is_primary"/></list></field></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">rn.school.student</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
