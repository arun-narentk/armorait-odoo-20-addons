<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_school_exam_result_tree" model="ir.ui.view">
        <field name="name">rn.school.exam.result.tree</field>
        <field name="model">rn.school.exam.result</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="marks_obtained"/>
                <field name="percentage"/>
                <field name="grade"/>
                <field name="rank"/>
                <button name="action_generate_ai_comment" type="object" string="AI Comment"/>
            </list>
        </field>
    </record>
    <record id="action_rn_school_exam" model="ir.actions.act_window">
        <field name="name">Exams</field>
        <field name="res_model">rn.school.exam</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
