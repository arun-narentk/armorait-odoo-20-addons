<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_teacher" model="ir.ui.view">
        <field name="name">hr.employee.form.school</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Teaching" groups="rn_school_core.group_rn_school_teacher">
                    <group>
                        <field name="is_teacher"/>
                        <field name="subject_specialization"/>
                        <field name="employee_code"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
