<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_school_class_tree" model="ir.ui.view">
        <field name="name">rn.school.class.tree</field>
        <field name="model">rn.school.class</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="grade_level"/><field name="section"/><field name="student_count"/></list>
        </field>
    </record>
    <record id="action_rn_school_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">rn.school.class</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_school_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">rn.school.academic.year</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
