<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_school_enquiry_tree" model="ir.ui.view">
        <field name="name">rn.school.admission.enquiry.tree</field>
        <field name="model">rn.school.admission.enquiry</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="applicant_name"/><field name="mobile"/><field name="grade_applied"/><field name="state"/></list>
        </field>
    </record>
    <record id="view_rn_school_application_form" model="ir.ui.view">
        <field name="name">rn.school.admission.application.form</field>
        <field name="model">rn.school.admission.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify_documents" type="object" string="Verify Documents" invisible="state != 'application'"/>
                    <button name="action_schedule_interview" type="object" string="Interview" invisible="state != 'documents'"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state not in ('interview','documents')"/>
                    <button name="action_create_student" type="object" string="Enroll Student" invisible="state != 'approved'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="applicant_name"/>
                        <field name="parent_name"/>
                        <field name="mobile"/>
                        <field name="grade_applied"/>
                        <field name="fee_paid"/>
                        <field name="student_id" readonly="1"/>
                    </group>
                    <field name="interview_notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_school_enquiry" model="ir.actions.act_window">
        <field name="name">Enquiries</field>
        <field name="res_model">rn.school.admission.enquiry</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_school_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">rn.school.admission.application</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
