<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rn_school_admission" model="ir.sequence">
        <field name="name">Student Admission Number</field>
        <field name="code">rn.school.student.admission</field>
        <field name="prefix">ADM</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rn_school_enquiry" model="ir.sequence">
        <field name="name">Admission Enquiry</field>
        <field name="code">rn.school.admission.enquiry</field>
        <field name="prefix">ENQ</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rn_school_application" model="ir.sequence">
        <field name="name">Admission Application</field>
        <field name="code">rn.school.admission.application</field>
        <field name="prefix">APP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
