<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_temple_devotee_tree" model="ir.ui.view">
        <field name="name">rn.temple.devotee.tree</field>
        <field name="model">rn.temple.devotee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mobile"/>
                <field name="membership_type"/>
                <field name="donation_total"/>
            </list>
        </field>
    </record>
    <record id="view_rn_temple_devotee_form" model="ir.ui.view">
        <field name="name">rn.temple.devotee.form</field>
        <field name="model">rn.temple.devotee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="mobile"/>
                        <field name="email"/>
                        <field name="membership_type"/>
                        <field name="family_head_id"/>
                    </group>
                    <field name="address"/>
                    <field name="preferred_seva_ids" widget="many2many_tags"/>
                    <field name="donation_ids">
                        <list>
                            <field name="name"/>
                            <field name="donation_date"/>
                            <field name="amount"/>
                            <field name="payment_mode"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_temple_devotee" model="ir.actions.act_window">
        <field name="name">Devotees</field>
        <field name="res_model">rn.temple.devotee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
