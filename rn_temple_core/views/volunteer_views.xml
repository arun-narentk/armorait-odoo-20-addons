<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_temple_volunteer_tree" model="ir.ui.view">
        <field name="name">rn.temple.volunteer.tree</field>
        <field name="model">rn.temple.volunteer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mobile"/>
                <field name="skills"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_rn_temple_volunteer" model="ir.actions.act_window">
        <field name="name">Volunteers</field>
        <field name="res_model">rn.temple.volunteer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
