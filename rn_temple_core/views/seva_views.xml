<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_temple_seva_type_tree" model="ir.ui.view">
        <field name="name">rn.temple.seva.type.tree</field>
        <field name="model">rn.temple.seva.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="amount"/>
                <field name="capacity_per_slot"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_temple_seva_booking_tree" model="ir.ui.view">
        <field name="name">rn.temple.seva.booking.tree</field>
        <field name="model">rn.temple.seva.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="booking_date"/>
                <field name="devotee_id"/>
                <field name="seva_type_id"/>
                <field name="slot_label"/>
                <field name="qr_token"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_temple_seva_booking_form" model="ir.ui.view">
        <field name="name">rn.temple.seva.booking.form</field>
        <field name="model">rn.temple.seva.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="devotee_id"/>
                        <field name="seva_type_id"/>
                        <field name="booking_date"/>
                        <field name="slot_label"/>
                        <field name="amount"/>
                        <field name="qr_token"/>
                        <field name="festival_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_temple_seva_type" model="ir.actions.act_window">
        <field name="name">Seva Types</field>
        <field name="res_model">rn.temple.seva.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_temple_seva_booking" model="ir.actions.act_window">
        <field name="name">Seva Bookings</field>
        <field name="res_model">rn.temple.seva.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
