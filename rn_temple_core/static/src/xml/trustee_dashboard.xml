<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_temple_core.TrusteeDashboard">
        <div class="o_rn_temple_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2>Trustee Dashboard</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-4"><div class="card p-3"><div class="text-muted">Donations This Month</div><div class="fs-3" t-out="this.formatNumber(this.state.donations)"/></div></div>
                <div class="col-md-4"><div class="card p-3"><div class="text-muted">Receipt Count</div><div class="fs-3" t-out="this.state.donationCount"/></div></div>
                <div class="col-md-4"><div class="card p-3"><div class="text-muted">Active Devotees</div><div class="fs-3" t-out="this.state.devotees"/></div></div>
                <div class="col-md-6"><div class="card p-3"><div class="text-muted">Active Festivals</div><div class="fs-4" t-out="this.state.festivals"/></div></div>
                <div class="col-md-6"><div class="card p-3"><div class="text-muted">Hundi Pending Deposit</div><div class="fs-4" t-out="this.state.hundi"/></div></div>
            </div>
        </div>
    </t>
</templates>
