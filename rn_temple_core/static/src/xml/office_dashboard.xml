<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_temple_core.OfficeDashboard">
        <div class="o_rn_temple_office_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2>Temple Office</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Sevas Today</div><div class="fs-3" t-out="this.state.bookings"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Pending Receipts</div><div class="fs-3" t-out="this.state.receipts"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Upcoming Festivals</div><div class="fs-3" t-out="this.state.festivals"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Annadhanam Today</div><div class="fs-3" t-out="this.state.annadhanam"/></div></div>
            </div>
        </div>
    </t>
</templates>
