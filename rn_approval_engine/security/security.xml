<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_approval">
        <field name="name">ARMORA Approval Engine</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_approval_user" model="res.groups">
        <field name="name">Approval User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_approval"/>
    </record>
    <record id="group_rn_approval_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_approval_user'))]"/>
    </record>
    <record id="group_rn_approval_manager" model="res.groups">
        <field name="name">Approval Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_approval_approver'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
