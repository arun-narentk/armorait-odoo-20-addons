<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_approval_submit_wizard_form" model="ir.ui.view">
        <field name="name">rn.approval.submit.wizard.form</field>
        <field name="model">rn.approval.submit.wizard</field>
        <field name="arch" type="xml">
            <form string="Submit for Approval">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="workflow_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
