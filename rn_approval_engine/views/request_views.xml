<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_approval_request_tree" model="ir.ui.view">
        <field name="name">rn.approval.request.tree</field>
        <field name="model">rn.approval.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('rejected', 'cancelled')">
                <field name="reference"/>
                <field name="document_display"/>
                <field name="workflow_id"/>
                <field name="requester_id"/>
                <field name="amount"/>
                <field name="current_stage_id"/>
                <field name="pending_line_count"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'pending'"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_approval_request_form" model="ir.ui.view">
        <field name="name">rn.approval.request.form</field>
        <field name="model">rn.approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                        invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_open_document" type="object" string="Open Document"/>
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not is_overdue">
                        This approval is past SLA deadline.
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workflow_id" readonly="state != 'draft'"/>
                            <field name="document_display"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <field name="requester_id"/>
                            <field name="current_stage_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="sla_deadline"/>
                            <field name="pending_line_count"/>
                            <field name="approved_line_count"/>
                        </group>
                    </group>
                    <group string="AI Risk Summary" invisible="not risk_summary">
                        <field name="risk_summary" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Approvers" name="approvers">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="state == 'approved'"
                                    decoration-danger="state == 'rejected'">
                                    <field name="stage_id"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                    <field name="action_type"/>
                                    <field name="comment"/>
                                    <field name="deadline"/>
                                    <field name="is_active_stage"/>
                                    <button name="action_approve" type="object" string="Approve"
                                        invisible="state != 'pending' or not is_active_stage"/>
                                    <button name="action_reject" type="object" string="Reject"
                                        invisible="state != 'pending' or not is_active_stage"/>
                                    <button name="action_request_changes" type="object" string="Changes"
                                        invisible="state != 'pending' or not is_active_stage"/>
                                </list>
                            </field>
                        </page>
                        <page string="History" name="history">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="stage_name"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="is_overdue" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rn_approval_request_search" model="ir.ui.view">
        <field name="name">rn.approval.request.search</field>
        <field name="model">rn.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="document_display"/>
                <field name="requester_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="my_pending" string="My Pending"
                    domain="[('line_ids.user_id', '=', uid), ('line_ids.state', '=', 'pending'), ('state', '=', 'pending')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_workflow" string="Workflow" context="{'group_by': 'workflow_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rn_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">rn.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 0}</field>
    </record>

    <record id="action_rn_approval_my_pending" model="ir.actions.act_window">
        <field name="name">My Pending Approvals</field>
        <field name="res_model">rn.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_pending': 1}</field>
    </record>
</odoo>
