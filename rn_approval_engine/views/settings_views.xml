<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_approval_settings_form" model="ir.ui.view">
        <field name="name">rn.approval.settings.form</field>
        <field name="model">rn.approval.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group string="Notifications">
                        <field name="enable_email_notify"/>
                        <field name="enable_whatsapp_notify"/>
                        <field name="reminder_hours"/>
                    </group>
                    <group string="SLA and AI">
                        <field name="default_sla_hours"/>
                        <field name="enable_ai_risk"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rn_approval_settings_tree" model="ir.ui.view">
        <field name="name">rn.approval.settings.tree</field>
        <field name="model">rn.approval.settings</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="enable_email_notify"/>
                <field name="enable_ai_risk"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_rn_approval_settings" model="ir.actions.act_window">
        <field name="name">Approval Settings</field>
        <field name="res_model">rn.approval.settings</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_config_settings_view_form_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Approval Engine" name="rn_approval_engine">
                    <block title="Workflow Approval">
                        <setting string="Email notifications">
                            <field name="approval_enable_email"/>
                        </setting>
                        <setting string="AI risk hints">
                            <field name="approval_enable_ai_risk"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit_for_approval" type="object" string="Submit for Approval"
                    invisible="approval_state in ('pending', 'approved')"
                    groups="rn_approval_engine.group_rn_approval_user"/>
                <button name="action_open_approval_request" type="object" string="Approval"
                    invisible="not approval_request_id"
                    groups="rn_approval_engine.group_rn_approval_user"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="approval_state" readonly="1" groups="rn_approval_engine.group_rn_approval_user"/>
                <field name="approval_request_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_approval" model="ir.ui.view">
        <field name="name">account.move.form.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit_for_approval" type="object" string="Submit for Approval"
                    invisible="approval_state in ('pending', 'approved') or move_type not in ('in_invoice', 'in_refund')"
                    groups="rn_approval_engine.group_rn_approval_user"/>
                <button name="action_open_approval_request" type="object" string="Approval"
                    invisible="not approval_request_id"
                    groups="rn_approval_engine.group_rn_approval_user"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="approval_state" readonly="1"
                    invisible="move_type not in ('in_invoice', 'in_refund')"
                    groups="rn_approval_engine.group_rn_approval_user"/>
                <field name="approval_request_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
