<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rn_gst_exception" model="ir.sequence">
        <field name="name">GST Exception</field>
        <field name="code">rn.gst.exception</field>
        <field name="prefix">GSTEX/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_rn_gst_exception_collect" model="ir.cron">
        <field name="name">GST Exceptions: collect problems from GST apps</field>
        <field name="model_id" ref="model_rn_gst_exception"/>
        <field name="state">code</field>
        <field name="code">model._cron_collect()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
