<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_armora_gst_excel_template_list" model="ir.ui.view">
        <field name="name">armora.gst.excel.template.list</field>
        <field name="model">armora.gst.excel.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="filing_type"/>
                <field name="financial_year"/>
                <field name="version"/>
                <field name="active"/>
                <field name="sheet_names"/>
            </list>
        </field>
    </record>

    <record id="view_armora_gst_excel_template_form" model="ir.ui.view">
        <field name="name">armora.gst.excel.template.form</field>
        <field name="model">armora.gst.excel.template</field>
        <field name="arch" type="xml">
            <form string="GSTN Offline Tool Template">
                <header>
                    <button name="action_inspect_workbook" type="object" string="Inspect Workbook" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Official GSTN Returns Offline Tool Excel template (GSTR-1/IFF).
                        Not a direct GST Portal upload file. Re-upload when GSTN updates the utility.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="filing_type"/>
                            <field name="version"/>
                            <field name="financial_year"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                            <field name="template_filename" invisible="1"/>
                            <field name="template_file" filename="template_filename"/>
                            <field name="sheet_names" readonly="1"/>
                        </group>
                    </group>
                    <group string="Inspection">
                        <field name="validation_message" readonly="1"/>
                        <field name="mapping_json" widget="text"/>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_armora_gst_excel_template" model="ir.actions.act_window">
        <field name="name">Offline Tool Templates</field>
        <field name="res_model">armora.gst.excel.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
