<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_armora_gst_filing" model="ir.sequence">
        <field name="name">GST Filing</field>
        <field name="code">armora.gst.filing</field>
        <field name="prefix">GST/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_armora_gst_gstr9" model="ir.sequence">
        <field name="name">GSTR-9 Annual Return</field>
        <field name="code">armora.gst.gstr9</field>
        <field name="prefix">GSTR9/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
