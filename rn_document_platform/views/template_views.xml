<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_doc_template_tree" model="ir.ui.view">
        <field name="name">rn.doc.platform.template.tree</field>
        <field name="model">rn.doc.platform.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_rn_doc_template" model="ir.actions.act_window">
        <field name="name">Document Templates</field>
        <field name="res_model">rn.doc.platform.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
