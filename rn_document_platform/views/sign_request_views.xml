<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_doc_sign_request_tree" model="ir.ui.view">
        <field name="name">rn.doc.sign.request.tree</field>
        <field name="model">rn.doc.sign.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="document_display"/>
                <field name="sign_mode"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state in ('sent', 'partial')"
                    decoration-success="state == 'completed'"
                    decoration-danger="state in ('declined', 'expired')"/>
            </list>
        </field>
    </record>

    <record id="view_rn_doc_sign_request_form" model="ir.ui.view">
        <field name="name">rn.doc.sign.request.form</field>
        <field name="model">rn.doc.sign.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_run_ai_analysis" type="object" string="AI Analyze"/>
                    <button name="action_open_document" type="object" string="Open Source Document"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,partial,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="reference" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="document_display"/>
                            <field name="attachment_id"/>
                            <field name="sign_mode"/>
                            <field name="expiry_date"/>
                            <field name="document_hash" readonly="1"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="analysis_id"/>
                            <field name="requester_id"/>
                            <field name="access_token" groups="rn_document_platform.group_rn_doc_platform_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signers" name="signers">
                            <field name="signer_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="role"/>
                                    <field name="sign_method"/>
                                    <field name="state"/>
                                    <field name="is_active"/>
                                    <button name="action_mark_signed" type="object" string="Mark Signed" invisible="state != 'sent'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fields" name="fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="signer_id"/>
                                    <field name="field_type"/>
                                    <field name="page"/>
                                    <field name="pos_x"/>
                                    <field name="pos_y"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audit" name="audit">
                            <field name="audit_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="action"/>
                                    <field name="user_id"/>
                                    <field name="ip_address"/>
                                    <field name="document_hash"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rn_doc_sign_request" model="ir.actions.act_window">
        <field name="name">Sign Requests</field>
        <field name="res_model">rn.doc.sign.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="sale_order_form_sign" model="ir.ui.view">
        <field name="name">sale.order.form.sign</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_for_signature" type="object" string="Send for Signature"
                    invisible="sign_state in ('sent', 'partial', 'completed')"
                    groups="rn_document_platform.group_rn_doc_platform_user"/>
                <button name="action_open_sign_request" type="object" string="Signature"
                    invisible="not sign_request_id"
                    groups="rn_document_platform.group_rn_doc_platform_user"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_sign" model="ir.ui.view">
        <field name="name">purchase.order.form.sign</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_for_signature" type="object" string="Send for Signature"
                    invisible="sign_state in ('sent', 'partial', 'completed')"
                    groups="rn_document_platform.group_rn_doc_platform_user"/>
            </xpath>
        </field>
    </record>

    <record id="hr_version_form_sign" model="ir.ui.view">
        <field name="name">hr.version.form.sign</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_send_for_signature" type="object" string="Send for Signature"
                        groups="rn_document_platform.group_rn_doc_platform_user"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
