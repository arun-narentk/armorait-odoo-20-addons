<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_doc_ai_analysis_tree" model="ir.ui.view">
        <field name="name">rn.doc.ai.analysis.tree</field>
        <field name="model">rn.doc.ai.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_id"/>
                <field name="risk_level" widget="badge"/>
                <field name="contract_value"/>
                <field name="duration"/>
            </list>
        </field>
    </record>
    <record id="view_rn_doc_ai_analysis_form" model="ir.ui.view">
        <field name="name">rn.doc.ai.analysis.form</field>
        <field name="model">rn.doc.ai.analysis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="request_id"/>
                        <field name="risk_level"/>
                        <field name="contract_value"/>
                        <field name="duration"/>
                        <field name="renewal_date"/>
                        <field name="notice_period"/>
                        <field name="payment_terms"/>
                    </group>
                    <field name="summary_html" nolabel="1"/>
                    <field name="risk_flags"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_doc_ai_analysis" model="ir.actions.act_window">
        <field name="name">AI Analysis</field>
        <field name="res_model">rn.doc.ai.analysis</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
