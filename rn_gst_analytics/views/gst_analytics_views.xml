<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_analytics_view_pivot" model="ir.ui.view">
        <field name="name">rn.gst.analytics.pivot</field>
        <field name="model">rn.gst.analytics</field>
        <field name="arch" type="xml">
            <pivot string="GST Analytics" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="output_tax" type="measure"/>
                <field name="input_tax" type="measure"/>
                <field name="taxable_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="rn_gst_analytics_view_graph" model="ir.ui.view">
        <field name="name">rn.gst.analytics.graph</field>
        <field name="model">rn.gst.analytics</field>
        <field name="arch" type="xml">
            <graph string="GST by Month" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="direction"/>
                <field name="tax_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="rn_gst_analytics_view_list" model="ir.ui.view">
        <field name="name">rn.gst.analytics.list</field>
        <field name="model">rn.gst.analytics</field>
        <field name="arch" type="xml">
            <list string="GST Analytics" create="false">
                <field name="date"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="journal_id" optional="hide"/>
                <field name="direction"/>
                <field name="kind"/>
                <field name="head"/>
                <field name="gstr_section" optional="show"/>
                <field name="taxable_amount" sum="Total"/>
                <field name="tax_amount" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="rn_gst_analytics_view_search" model="ir.ui.view">
        <field name="name">rn.gst.analytics.search</field>
        <field name="model">rn.gst.analytics</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <filter string="Outward" name="outward" domain="[('direction', '=', 'outward')]"/>
                <filter string="Inward" name="inward" domain="[('direction', '=', 'inward')]"/>
                <separator/>
                <filter string="GST" name="tax" domain="[('kind', '=', 'tax')]"/>
                <filter string="Taxable Value" name="taxable" domain="[('kind', '=', 'taxable')]"/>
                <separator/>
                <filter string="Date" name="date" date="date"/>
                <group>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Tax Head" name="group_head" context="{'group_by': 'head'}"/>
                    <filter string="GSTR Section" name="group_section" context="{'group_by': 'gstr_section'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rn_gst_analytics_action" model="ir.actions.act_window">
        <field name="name">GST Analytics</field>
        <field name="res_model">rn.gst.analytics</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No GST entries yet</p>
            <p>Taxable value and GST of posted invoices and bills show here by month, head and section.</p>
        </field>
    </record>

    <menuitem id="rn_gst_analytics_menu"
              name="Analytics"
              parent="rn_gst_base.menu_rn_gst_root"
              action="rn_gst_analytics_action"
              sequence="85"
              groups="rn_gst_base.group_rn_gst_user"/>
</odoo>
