<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rn.gst.ewaybill.manager</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rn_gst_base.view_rn_gst_base_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='rn_gst_base_settings']" position="inside">
                <setting string="E-Way Bill Value Limit" help="Goods invoices of this value or more without an e-way bill are listed.">
                    <field name="rn_ewb_threshold"/>
                </setting>
                <setting string="E-Way Bill Expiry Warning" help="Days of validity left when an e-way bill counts as expiring soon.">
                    <field name="rn_ewb_warn_days"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
