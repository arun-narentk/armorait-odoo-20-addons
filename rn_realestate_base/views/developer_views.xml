<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_realestate_developer_list" model="ir.ui.view">
        <field name="name">rn.realestate.developer.list</field>
        <field name="model">rn.realestate.developer</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="developer_type"/>
                <field name="city"/>
                <field name="project_count"/>
                <field name="available_unit_count"/>
                <field name="lead_count"/>
            </list>
        </field>
    </record>
    <record id="view_rn_realestate_developer_form" model="ir.ui.view">
        <field name="name">rn.realestate.developer.form</field>
        <field name="model">rn.realestate.developer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_projects" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                        <button name="action_open_leads" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="developer_type"/>
                            <field name="legal_name"/>
                            <field name="rera_registration"/>
                            <field name="gstin"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="street"/>
                        <field name="city"/>
                        <field name="state_id"/>
                        <field name="zip"/>
                        <field name="country_id"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_realestate_developer" model="ir.actions.act_window">
        <field name="name">Developers</field>
        <field name="res_model">rn.realestate.developer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
