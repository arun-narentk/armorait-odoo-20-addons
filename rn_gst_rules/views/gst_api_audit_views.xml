<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_api_audit_tree" model="ir.ui.view">
        <field name="name">rn.gst.api.audit.tree</field>
        <field name="model">rn.gst.api.audit</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_timestamp"/>
                <field name="api_type"/>
                <field name="api_environment"/>
                <field name="company_id"/>
                <field name="gstin"/>
                <field name="document_name"/>
                <field name="success"/>
                <field name="error_code"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_api_audit_form" model="ir.ui.view">
        <field name="name">rn.gst.api.audit.form</field>
        <field name="model">rn.gst.api.audit</field>
        <field name="arch" type="xml">
            <form string="GST API Audit" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="request_timestamp"/>
                            <field name="api_type"/>
                            <field name="api_environment"/>
                            <field name="success"/>
                            <field name="retry_count"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="gstin"/>
                            <field name="user_id"/>
                            <field name="document_name"/>
                            <field name="request_reference"/>
                            <field name="response_reference"/>
                        </group>
                    </group>
                    <group string="Error">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>
                    <group string="Sanitized Payloads">
                        <field name="request_payload" widget="text"/>
                        <field name="response_payload" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_gst_api_audit" model="ir.actions.act_window">
        <field name="name">GST API Audit</field>
        <field name="res_model">rn.gst.api.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
