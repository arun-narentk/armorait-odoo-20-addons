<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_rule_tree" model="ir.ui.view">
        <field name="name">rn.gst.rule.tree</field>
        <field name="model">rn.gst.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="rule_code"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="version"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_rule_form" model="ir.ui.view">
        <field name="name">rn.gst.rule.form</field>
        <field name="model">rn.gst.rule</field>
        <field name="arch" type="xml">
            <form string="GST Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rule_code"/>
                            <field name="rule_type"/>
                            <field name="version"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                            <field name="api_version"/>
                            <field name="source_reference"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Configuration JSON">
                        <field name="configuration" nolabel="1" colspan="2" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_gst_rule" model="ir.actions.act_window">
        <field name="name">GST Rules</field>
        <field name="res_model">rn.gst.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
