<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_smart_notes" model="ir.ui.view">
        <field name="name">sale.order.form.smart.notes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_smart_notes" type="object" class="oe_stat_button" icon="fa-sticky-note-o"
                        groups="rn_smart_notes.group_rn_smart_notes_user">
                    <field name="smart_note_count" widget="statinfo" string="Notes"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="after">
                <widget name="rn_smart_notes_panel" groups="rn_smart_notes.group_rn_smart_notes_user"/>
            </xpath>
        </field>
    </record>

