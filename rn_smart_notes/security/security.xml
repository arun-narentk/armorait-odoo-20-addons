<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_smart_notes">
        <field name="name">ARMORA Smart Notes</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_smart_notes_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_notes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_smart_notes_sales_team" model="res.groups">
        <field name="name">Sales Team Notes</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_notes"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_smart_notes_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_rn_smart_notes_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_notes"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_smart_notes_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
