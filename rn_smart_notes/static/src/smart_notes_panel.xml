<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_smart_notes.SmartNotesPanel">
        <div class="o_rn_smart_notes_panel border-top mt-3 pt-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="mb-0">Notes</h3>
                <button type="button" class="btn btn-sm btn-primary" t-on-click="this.openComposer">+ Add Note</button>
            </div>

            <div class="d-flex flex-wrap gap-1 mb-3" t-if="this.state.quickTemplates.length">
                <button t-foreach="this.state.quickTemplates" t-as="qt" t-key="qt.id"
                        type="button" class="btn btn-sm btn-outline-secondary"
                        t-on-click="() => this.quickAdd(qt.id)">
                    + <t t-out="qt.name"/>
                </button>
            </div>

            <div t-if="this.state.showComposer" class="o_rn_note_composer card mb-3 p-3">
                <input class="form-control mb-2" placeholder="Title" t-model.proxy="this.state.draftName"/>
                <textarea class="form-control mb-2" rows="3" placeholder="Description" t-model.proxy="this.state.draftNote"/>
                <div class="row g-2">
                    <div class="col-md-3">
                        <select class="form-select" t-model.proxy="this.state.draftColor">
                            <option value="yellow">Yellow</option>
                            <option value="blue">Blue</option>
                            <option value="green">Green</option>
                            <option value="pink">Pink</option>
                            <option value="orange">Orange</option>
                            <option value="red">Red</option>
                            <option value="purple">Purple</option>
                            <option value="gray">Gray</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" t-model.proxy="this.state.draftPriority">
                            <option value="critical">Critical</option>
                            <option value="high">High</option>
                            <option value="medium">Medium</option>
                            <option value="low">Low</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" t-model.proxy="this.state.draftIcon">
                            <option value="warning">Warning</option>
                            <option value="vip">VIP</option>
                            <option value="finance">Finance</option>
                            <option value="logistics">Logistics</option>
                            <option value="call">Call</option>
                            <option value="technical">Technical</option>
                            <option value="general">General</option>
                            <option value="urgent">Urgent</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-center">
                        <label class="form-check-label">
                            <input type="checkbox" class="form-check-input me-1" t-model.proxy="this.state.draftPinned"/>
                            Pin note
                        </label>
                    </div>
                </div>
                <div class="mt-2 d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-primary" t-on-click="this.saveNote">Save</button>
                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="this.resetComposer">Cancel</button>
                </div>
            </div>

            <div t-if="this.state.loading" class="text-muted">Loading notes...</div>
            <div t-elif="!this.state.notes.length" class="text-muted">No notes yet. Add a reminder, VIP flag, or warning.</div>
            <div t-else="" class="o_rn_note_cards d-flex flex-column gap-2">
                <div t-foreach="this.state.notes" t-as="note" t-key="note.id"
                     class="o_rn_note_card card p-3"
                     t-att-style="'background-color:' + note.color_css">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong t-out="note.name"/>
                            <span t-if="note.is_pinned" class="badge text-bg-warning ms-2">Pinned</span>
                        </div>
                        <small class="text-muted" t-out="note.create_age"/>
                    </div>
                    <div class="small text-muted mb-2">
                        <t t-out="this.iconLabel(note.icon)"/> | <t t-out="note.priority"/> | <t t-out="note.user_name"/>
                    </div>
                    <div t-if="note.note" class="mb-2" t-out="note.note"/>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-link p-0" t-on-click="() => this.togglePin(note)">
                            <t t-if="note.is_pinned">Unpin</t>
                            <t t-else="">Pin</t>
                        </button>
                        <button type="button" class="btn btn-sm btn-link p-0" t-on-click="() => this.editNote(note)">Edit</button>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0" t-on-click="() => this.deleteNote(note)">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
