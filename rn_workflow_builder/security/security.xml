<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_workflow">
        <field name="name">ARMORA AI Automation</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_workflow_user" model="res.groups">
        <field name="name">Workflow User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_workflow"/>
    </record>
    <record id="group_rn_workflow_designer" model="res.groups">
        <field name="name">Workflow Designer</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_workflow_user'))]"/>
    </record>
    <record id="group_rn_workflow_manager" model="res.groups">
        <field name="name">Workflow Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_workflow_designer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
