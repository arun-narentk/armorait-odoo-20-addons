<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_workflow_tree" model="ir.ui.view">
        <field name="name">rn.workflow.tree</field>
        <field name="model">rn.workflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="trigger_type"/>
                <field name="model_id"/>
                <field name="state"/>
                <field name="run_count"/>
                <field name="success_rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_workflow_form" model="ir.ui.view">
        <field name="name">rn.workflow.form</field>
        <field name="model">rn.workflow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_pause" type="object" string="Pause"
                            invisible="state != 'active'"/>
                    <button name="action_run_manual" type="object" string="Run Now"
                            invisible="state != 'active'"/>
                    <button name="action_open_designer" type="object" string="Open Designer"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="trigger_type"/>
                        <field name="model_id"/>
                        <field name="schedule_interval" invisible="trigger_type != 'on_schedule'"/>
                        <field name="webhook_token" readonly="1" invisible="trigger_type != 'on_webhook'"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                    <field name="ai_validation" readonly="1"/>
                    <notebook>
                        <page string="Nodes">
                            <field name="node_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="node_type"/>
                                    <field name="action_type"/>
                                    <field name="field_name"/>
                                    <field name="compare_value"/>
                                    <field name="connector_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Runs">
                            <field name="run_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="start_time"/>
                                    <field name="duration_ms"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_workflow" model="ir.actions.act_window">
        <field name="name">Workflows</field>
        <field name="res_model">rn.workflow</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
