<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_workflow_template_tree" model="ir.ui.view">
        <field name="name">rn.workflow.template.tree</field>
        <field name="model">rn.workflow.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="trigger_type"/>
                <field name="model_id"/>
                <button name="action_create_workflow" type="object" string="Use Template" class="btn-primary"/>
            </list>
        </field>
    </record>
    <record id="action_rn_workflow_template" model="ir.actions.act_window">
        <field name="name">Workflow Templates</field>
        <field name="res_model">rn.workflow.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
