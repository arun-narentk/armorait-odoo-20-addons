<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_workflow_run_tree" model="ir.ui.view">
        <field name="name">rn.workflow.run.tree</field>
        <field name="model">rn.workflow.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workflow_id"/>
                <field name="state"/>
                <field name="trigger_model"/>
                <field name="trigger_res_id"/>
                <field name="start_time"/>
                <field name="duration_ms"/>
                <field name="retry_count"/>
            </list>
        </field>
    </record>
    <record id="view_rn_workflow_run_form" model="ir.ui.view">
        <field name="name">rn.workflow.run.form</field>
        <field name="model">rn.workflow.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="workflow_id"/>
                        <field name="trigger_model"/>
                        <field name="trigger_res_id"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="duration_ms"/>
                        <field name="retry_count"/>
                        <field name="error_message"/>
                    </group>
                    <field name="log_ids">
                        <list>
                            <field name="sequence"/>
                            <field name="node_name"/>
                            <field name="node_type"/>
                            <field name="state"/>
                            <field name="message"/>
                            <field name="executed_at"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_workflow_run" model="ir.actions.act_window">
        <field name="name">Execution History</field>
        <field name="res_model">rn.workflow.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_workflow_run_failed" model="ir.actions.act_window">
        <field name="name">Failed Runs</field>
        <field name="res_model">rn.workflow.run</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('failed', 'retry'))]</field>
    </record>
</odoo>
