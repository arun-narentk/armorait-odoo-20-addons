  </record>

  <record id="starter_customer_welcome" model="rn.workflow">
    <field name="name">Customer Welcome</field>
    <field name="code">starter_customer_welcome</field>
    <field name="description">Send a welcome email when a new customer contact is created.</field>
    <field name="trigger_type">on_create</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">draft</field>
    <field name="sequence">80</field>
  </record>
  <record id="starter_customer_welcome_node_1" model="rn.workflow.node">
    <field name="workflow_id" ref="starter_customer_welcome"/>
