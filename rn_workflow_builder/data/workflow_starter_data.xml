  <record id="starter_followup_reminder_node_2" model="rn.workflow.node">
    <field name="workflow_id" ref="starter_followup_reminder"/>
    <field name="name">Send follow-up email</field>
    <field name="sequence">20</field>
    <field name="node_type">action</field>
    <field name="action_type">send_email</field>
    <field name="config_json">{"subject": "Following up on your request", "body": "&lt;p&gt;We are following up on your recent inquiry.&lt;/p&gt;"}</field>
  </record>
</odoo>
