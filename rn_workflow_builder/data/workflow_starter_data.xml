    <field name="code">starter_expense_approval</field>
    <field name="description">Route submitted employee expenses to approvers.</field>
    <field name="trigger_type">on_write</field>
    <field name="model_id" ref="hr_expense.model_hr_expense"/>
    <field name="state">draft</field>
    <field name="sequence">70</field>
  </record>
  <record id="starter_expense_approval_node_1" model="rn.workflow.node">
    <field name="workflow_id" ref="starter_expense_approval"/>
    <field name="name">Check expense submitted</field>
    <field name="sequence">10</field>
    <field name="node_type">condition</field>
    <field name="field_name">state</field>
    <field name="condition_operator">equals</field>
    <field name="compare_value">submitted</field>
  </record>
  <record id="starter_expense_approval_node_2" model="rn.workflow.node">
    <field name="workflow_id" ref="starter_expense_approval"/>
    <field name="name">Start expense approval</field>
    <field name="sequence">20</field>
    <field name="node_type">action</field>
    <field name="action_type">start_approval</field>
  </record>
  <record id="starter_expense_approval_node_3" model="rn.workflow.node">
    <field name="workflow_id" ref="starter_expense_approval"/>
    <field name="name">Notify approver</field>
    <field name="sequence">30</field>
    <field name="node_type">action</field>
    <field name="action_type">send_notification</field>
