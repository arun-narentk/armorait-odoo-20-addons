    <field name="sequence">90</field>
  </record>
  <record id="starter_followup_reminder_node_1" model="rn.workflow.node">
    <field name="workflow_id" ref="starter_followup_reminder"/>
    <field name="name">Notify lead owner</field>
    <field name="sequence">10</field>
    <field name="node_type">action</field>
    <field name="action_type">send_notification</field>
    <field name="config_json">{"message": "Lead stage updated. Schedule your follow-up."}</field>
