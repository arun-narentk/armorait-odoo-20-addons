    <field name="sequence">10</field>
    <field name="node_type">action</field>
    <field name="action_type">send_email</field>
    <field name="config_json">{"subject": "Welcome to our company", "body": "&lt;p&gt;Thank you for connecting with us. Our team will reach out shortly.&lt;/p&gt;"}</field>
  </record>
  <record id="starter_customer_welcome_node_2" model="rn.workflow.node">
    <field name="workflow_id" ref="starter_customer_welcome"/>
    <field name="name">Log welcome activity</field>
    <field name="sequence">20</field>
    <field name="node_type">action</field>
    <field name="action_type">send_notification</field>
    <field name="config_json">{"message": "Welcome email queued for new customer."}</field>
  </record>

