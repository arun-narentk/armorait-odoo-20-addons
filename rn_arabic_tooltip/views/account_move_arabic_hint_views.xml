<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Demo: attach the custom "rn_arabic_hint" field widget to a few
        customer invoice fields. When the UI language is English, hovering
        the value shows its Arabic translation (standard value if present,
        otherwise the automatic accounting fallback).

        The fields are inserted as plain fields in the invoice header column
        so Odoo renders their labels natively (correct grid alignment).
    -->
    <record id="view_move_form_rn_arabic_hint" model="ir.ui.view">
        <field name="name">account.move.form.rn.arabic.hint</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="payment_state" widget="rn_arabic_hint"
                       string="Payment Status" readonly="1" force_save="1"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="move_type" widget="rn_arabic_hint"
                       string="Document Type" readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
