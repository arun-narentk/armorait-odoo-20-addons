<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_mrp_wc_status_tree" model="ir.ui.view">
        <field name="name">rn.mrp.workcenter.status.tree</field>
        <field name="model">rn.mrp.workcenter.status</field>
        <field name="arch" type="xml">
            <list>
                <field name="workcenter_id"/>
                <field name="status" widget="badge"/>
                <field name="current_production_id"/>
                <field name="queue_count"/>
                <field name="utilization_percent"/>
                <field name="running_hours_today"/>
                <field name="downtime_minutes_today"/>
                <field name="last_update"/>
            </list>
        </field>
    </record>
    <record id="action_rn_mrp_wc_status" model="ir.actions.act_window">
        <field name="name">Work Center Status</field>
        <field name="res_model">rn.mrp.workcenter.status</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="mrp_workcenter_form_intel" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.intel</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Manufacturing Intelligence" groups="rn_mrp_intelligence.group_rn_mrp_intel_user">
                    <field name="rn_status"/>
                    <field name="rn_oee_target"/>
                    <field name="rn_last_maintenance_date"/>
                    <field name="rn_next_maintenance_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
