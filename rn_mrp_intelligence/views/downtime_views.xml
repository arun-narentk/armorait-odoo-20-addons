<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_mrp_downtime_tree" model="ir.ui.view">
        <field name="name">rn.mrp.downtime.log.tree</field>
        <field name="model">rn.mrp.downtime.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workcenter_id"/>
                <field name="reason"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_minutes"/>
                <field name="shift_id"/>
            </list>
        </field>
    </record>
    <record id="view_rn_mrp_downtime_form" model="ir.ui.view">
        <field name="name">rn.mrp.downtime.log.form</field>
        <field name="model">rn.mrp.downtime.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="workcenter_id"/>
                        <field name="production_id"/>
                        <field name="shift_id"/>
                        <field name="reason"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="duration_minutes"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_mrp_downtime" model="ir.actions.act_window">
        <field name="name">Downtime Logs</field>
        <field name="res_model">rn.mrp.downtime.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
