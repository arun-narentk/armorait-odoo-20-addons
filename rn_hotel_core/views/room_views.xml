<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hotel_room_tree" model="ir.ui.view">
        <field name="name">rn.hotel.room.tree</field>
        <field name="model">rn.hotel.room</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="room_type_id"/><field name="floor"/><field name="status"/></list>
        </field>
    </record>
    <record id="action_rn_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">rn.hotel.room</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_hotel_room_type" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">rn.hotel.room.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
