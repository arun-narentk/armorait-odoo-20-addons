<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hotel_folio_form" model="ir.ui.view">
        <field name="name">rn.hotel.folio.form</field>
        <field name="model">rn.hotel.folio</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="guest_id"/>
                        <field name="room_id"/>
                        <field name="amount_total"/>
                        <field name="invoice_id"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="charge_type"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hotel_folio" model="ir.actions.act_window">
        <field name="name">Guest Folios</field>
        <field name="res_model">rn.hotel.folio</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
