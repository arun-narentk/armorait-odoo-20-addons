<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_messaging_connector_tree" model="ir.ui.view">
        <field name="name">rn.messaging.connector.tree</field>
        <field name="model">rn.messaging.connector</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="status"/>
                <field name="simulation_mode"/>
                <field name="bot_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_messaging_connector_form" model="ir.ui.view">
        <field name="name">rn.messaging.connector.form</field>
        <field name="model">rn.messaging.connector</field>
        <field name="arch" type="xml">
            <form string="Messaging Connector">
                <header>
                    <button name="action_test_simulation" type="object" string="Mark Connected" class="btn-primary"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_conversations" type="object" class="oe_stat_button" icon="fa-comments">
                            <field name="conversation_count" widget="statinfo" string="Chats"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="channel_type"/>
                            <field name="bot_id"/>
                            <field name="simulation_mode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phone_number"/>
                            <field name="phone_number_id"/>
                            <field name="page_id"/>
                            <field name="instagram_account_id"/>
                            <field name="business_account_id"/>
                            <field name="api_url"/>
                            <field name="api_version"/>
                            <field name="webhook_path" readonly="1"/>
                        </group>
                    </group>
                    <group string="WhatsApp Bridge" groups="rn_messaging_bot.group_rn_messaging_manager">
                        <field name="linked_account_ref"/>
                        <button name="action_sync_linked_account" type="object" string="Sync Credentials" class="btn-secondary"/>
                    </group>
                    <group string="Credentials" groups="rn_messaging_bot.group_rn_messaging_admin">
                        <field name="access_token" password="True"/>
                        <field name="webhook_verify_token"/>
                        <field name="webhook_secret"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_messaging_connector" model="ir.actions.act_window">
        <field name="name">Connectors</field>
        <field name="res_model">rn.messaging.connector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
