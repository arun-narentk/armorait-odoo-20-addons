<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_messaging_bot.FlowDesigner">
        <div class="o_rn_messaging_flow_designer o_action p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="mb-0">Bot Flow Designer</h2>
                    <p class="text-muted mb-0" t-if="this.state.bot.name">
                        <t t-out="this.state.bot.name"/>
                    </p>
                </div>
                <button class="btn btn-primary" t-on-click="this.saveLayout">Save Layout</button>
            </div>
            <div t-if="this.state.loading" class="text-muted">Loading flow...</div>
            <div t-else="" class="o_rn_flow_canvas card" t-ref="this.canvasRef">
                <svg class="o_rn_flow_edges">
                    <path t-foreach="this.state.edges" t-as="edge" t-key="edge.source + '-' + edge.target + '-' + edge.label"
                          t-att-d="this.edgePath(edge)" class="o_rn_flow_edge"/>
                </svg>
                <div class="o_rn_flow_node card shadow-sm"
                     t-foreach="this.state.nodes" t-as="node" t-key="node.id"
                     t-att-style="this.nodeStyle(node)"
                     t-on-mousedown="(ev) => this.onNodeMouseDown(ev, node)">
                    <span class="badge text-bg-secondary mb-1" t-out="node.node_type"/>
                    <strong t-out="node.name"/>
                    <div class="small text-muted mt-1" t-if="node.body_text" t-out="node.body_text"/>
                </div>
            </div>
        </div>
    </t>
</templates>
