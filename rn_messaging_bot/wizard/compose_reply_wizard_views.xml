<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_messaging_compose_reply_wizard_form" model="ir.ui.view">
        <field name="name">rn.messaging.compose.reply.wizard.form</field>
        <field name="model">rn.messaging.compose.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Reply">
                <group>
                    <field name="conversation_id" readonly="1"/>
                    <field name="body" placeholder="Type your reply to the customer..."/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
