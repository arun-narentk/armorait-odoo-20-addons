<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="armora_gst_rcm_rule_view_list" model="ir.ui.view">
        <field name="name">armora.gst.rcm.rule.list</field>
        <field name="model">armora.gst.rcm.rule</field>
        <field name="arch" type="xml">
            <list string="RCM Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="section"/>
                <field name="supplier_condition"/>
                <field name="tax_intra_id"/>
                <field name="tax_inter_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="armora_gst_rcm_rule_view_form" model="ir.ui.view">
        <field name="name">armora.gst.rcm.rule.form</field>
        <field name="model">armora.gst.rcm.rule</field>
        <field name="arch" type="xml">
            <form string="RCM Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Legal services by an advocate"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="section"/>
                            <field name="supplier_condition"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="tax_intra_id"/>
                            <field name="tax_inter_id"/>
                        </group>
                    </group>
                    <group string="Applies to bill lines with">
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="categ_ids" widget="many2many_tags"/>
                        <field name="account_ids" widget="many2many_tags"/>
                    </group>
                    <field name="note" placeholder="Conditions, e.g. the notification entry, or when the supplier may opt for forward charge."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="armora_gst_rcm_rule_action" model="ir.actions.act_window">
        <field name="name">RCM Rules</field>
        <field name="res_model">armora.gst.rcm.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up reverse charge rules</p>
            <p>Link each reverse charge supply to your products, categories or expense accounts and pick its taxes.
               Vendor bills then warn when a line needs reverse charge.</p>
        </field>
    </record>
</odoo>
