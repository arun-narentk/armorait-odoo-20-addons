<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_armora_gst_debit_note_reason_list" model="ir.ui.view">
        <field name="name">armora.gst.debit.note.reason.list</field>
        <field name="model">armora.gst.debit.note.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="require_original_invoice"/>
                <field name="gst_applicable"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_armora_gst_debit_note_reason_form" model="ir.ui.view">
        <field name="name">armora.gst.debit.note.reason.form</field>
        <field name="model">armora.gst.debit.note.reason</field>
        <field name="arch" type="xml">
            <form string="Debit Note Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="require_original_invoice"/>
                        <field name="require_quantity"/>
                        <field name="gst_applicable"/>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_armora_gst_debit_note_reason" model="ir.actions.act_window">
        <field name="name">Debit Note Reasons</field>
        <field name="res_model">armora.gst.debit.note.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
