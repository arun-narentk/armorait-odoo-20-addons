<odoo>
    <!--
        Filing security groups under the shared Armora GST category.

        Roles (Prompt 12 baseline already in place):
        - Filing User: create/load/validate/generate
        - Filing Manager: regenerate, submitted/filed transitions
        - Filing Administrator: template management + delete generated filings

        Multi-company record rules isolate filings, lines, validation results,
        and Offline Tool templates. Do not add unrestricted sudo() for business
        transitions.
    -->
    <record id="res_groups_privilege_rn_gst_filing" model="res.groups.privilege">
        <field name="name">Filing</field>
        <field name="category_id" ref="rn_gst_base.module_category_rn_gst"/>
    </record>

    <record id="group_rn_gst_filing_user" model="res.groups">
        <field name="name">Filing User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_filing"/>
        <field name="implied_ids" eval="[(4, ref('rn_gst_base.group_rn_gst_user'))]"/>
    </record>

    <record id="group_rn_gst_filing_manager" model="res.groups">
        <field name="name">Filing Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_filing"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_filing_user')), (4, ref('rn_gst_base.group_rn_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_rn_gst_filing_administrator" model="res.groups">
        <field name="name">Filing Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst_filing"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_filing_manager')), (4, ref('rn_gst_base.group_rn_gst_administrator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
