<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_gst_filing_list" model="ir.ui.view">
        <field name="name">rn.gst.filing.list</field>
        <field name="model">rn.gst.filing</field>
        <field name="arch" type="xml">
            <list string="GST Returns">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="gst_registration_id" optional="hide"/>
                <field name="gstin"/>
                <field name="filing_type"/>
                <field name="return_period"/>
                <field name="financial_year"/>
                <field name="document_count"/>
                <field name="amount_taxable"/>
                <field name="amount_cgst"/>
                <field name="amount_sgst"/>
                <field name="amount_igst"/>
                <field name="validation_status"/>
                <field name="state" widget="badge"
                        decoration-info="state in ('draft', 'data_loaded')"
                        decoration-warning="state in ('validated', 'generated', 'submitted')"
                        decoration-success="state == 'filed'"
                        decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_rn_gst_filing_form" model="ir.ui.view">
        <field name="name">rn.gst.filing.form</field>
        <field name="model">rn.gst.filing</field>
        <field name="arch" type="xml">
            <form string="GST Return">
                <header>
                    <button name="action_load_data" type="object" string="Load GST Data"
                            invisible="state in ('submitted', 'filed', 'cancelled')"
                            class="btn-primary"/>
                    <button name="action_regenerate_snapshot" type="object" string="Regenerate Snapshot"
                            invisible="state in ('submitted', 'filed', 'cancelled')"
                            groups="rn_gst_filing.group_rn_gst_filing_manager"
                            confirm="This will delete and rebuild snapshot lines. Continue?"/>
                    <button name="action_validate" type="object" string="Validate"
                            invisible="state in ('submitted', 'filed', 'cancelled')"
                            class="btn-secondary"/>
                    <button name="action_fix_and_regenerate" type="object" string="Fix Errors"
                            invisible="validation_error_count == 0 or state in ('submitted', 'filed', 'cancelled')"
                            class="btn-warning"
                            title="Open blocking validation issues. Fix the source invoice, then Regenerate Snapshot."/>
                    <button name="action_generate_excel" type="object" string="Generate GSTN Excel"
                            invisible="state in ('submitted', 'filed', 'cancelled')"
                            class="btn-primary"
                            title="Populate the official GSTN Returns Offline Tool Excel workbook. Import that file into the Offline Tool to produce JSON for GST Portal upload."/>
                    <button name="action_download_excel" type="object" string="Download GSTN Excel"
                            invisible="not generated_file"
                            title="Download the Offline Tool Excel workbook for import into the GSTN Returns Offline Tool."/>
                    <button name="action_mark_submitted" type="object" string="Mark Submitted"
                            invisible="state != 'generated'"
                            groups="rn_gst_filing.group_rn_gst_filing_manager"
                            title="Mark after importing the Excel into the Offline Tool and uploading the JSON to the GST Portal (or after Odoo GST API filing)."/>
                    <button name="action_mark_filed" type="object" string="Mark Filed"
                            invisible="state not in ('generated', 'submitted')"
                            groups="rn_gst_filing.group_rn_gst_filing_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft', 'filed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('filed', 'cancelled')"
                            confirm="Cancel this filing?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,data_loaded,validated,generated,submitted,filed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="format_list_bulleted">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_view_validation" type="object" class="oe_stat_button" icon="warning">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="validation_error_count"/> / <field name="validation_warning_count"/>
                                </span>
                                <span class="o_stat_text">Errors / Warnings</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="payments" disabled="1">
                            <field name="amount_taxable" widget="statinfo" string="Taxable"/>
                        </button>
                        <button class="oe_stat_button" icon="payments" disabled="1">
                            <field name="amount_cgst" widget="statinfo" string="CGST"/>
                        </button>
                        <button class="oe_stat_button" icon="payments" disabled="1">
                            <field name="amount_sgst" widget="statinfo" string="SGST"/>
                        </button>
                        <button class="oe_stat_button" icon="payments" disabled="1">
                            <field name="amount_igst" widget="statinfo" string="IGST"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                     readonly="state != 'draft'"/>
                            <field name="gst_registration_id" readonly="state != 'draft'"/>
                            <field name="gstin" readonly="state != 'draft'"/>
                            <field name="state_id" readonly="state != 'draft'"/>
                            <field name="filing_type" readonly="state != 'draft'"/>
                            <field name="filing_frequency" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="financial_year" readonly="state != 'draft'"/>
                            <field name="return_period" readonly="state != 'draft'"/>
                            <field name="period_start" readonly="1"/>
                            <field name="period_end" readonly="1"/>
                            <field name="validation_status"/>
                            <field name="is_readonly_state" invisible="1"/>
                            <field name="is_snapshot_locked" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <group>
                                <group string="Documents">
                                    <field name="document_count"/>
                                    <field name="line_count"/>
                                    <field name="count_b2b"/>
                                    <field name="count_b2cl"/>
                                    <field name="count_b2cs"/>
                                    <field name="count_export"/>
                                    <field name="count_credit_note"/>
                                    <field name="count_debit_note"/>
                                    <field name="count_nil"/>
                                    <field name="count_hsn"/>
                                </group>
                                <group string="Amounts">
                                    <field name="amount_taxable"/>
                                    <field name="amount_cgst"/>
                                    <field name="amount_sgst"/>
                                    <field name="amount_igst"/>
                                    <field name="amount_cess"/>
                                    <field name="amount_total_tax"/>
                                    <field name="amount_invoice"/>
                                </group>
                            </group>
                        </page>
                        <page string="GST Lines" name="lines">
                            <field name="line_ids" readonly="is_snapshot_locked">
                                <list>
                                    <field name="invoice_date"/>
                                    <field name="invoice_number"/>
                                    <field name="partner_name"/>
                                    <field name="partner_gstin"/>
                                    <field name="document_type"/>
                                    <field name="gst_table"/>
                                    <field name="supply_type"/>
                                    <field name="hsn_code"/>
                                    <field name="taxable_value"/>
                                    <field name="gst_rate"/>
                                    <field name="cgst_amount"/>
                                    <field name="sgst_amount"/>
                                    <field name="igst_amount"/>
                                    <field name="validation_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Validation" name="validation">
                            <field name="validation_result_ids" readonly="1">
                                <list>
                                    <field name="severity"
                                              decoration-danger="severity == 'error'"
                                              decoration-warning="severity == 'warning'"/>
                                    <field name="error_type"/>
                                    <field name="move_id"/>
                                    <field name="partner_id"/>
                                    <field name="message"/>
                                    <field name="hint" optional="show"/>
                                    <button name="action_open_invoice" type="object" string="Invoice"
                                            icon="open_in_new" invisible="not move_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reconciliation" name="reconciliation">
                            <group>
                                <group string="Accounting Totals">
                                    <field name="recon_taxable_value"/>
                                    <field name="recon_cgst"/>
                                    <field name="recon_sgst"/>
                                    <field name="recon_igst"/>
                                    <field name="recon_cess"/>
                                    <field name="recon_total_tax"/>
                                    <field name="recon_invoice_value"/>
                                </group>
                                <group string="Differences (Snapshot - Accounting)">
                                    <field name="diff_taxable_value"/>
                                    <field name="diff_cgst"/>
                                    <field name="diff_sgst"/>
                                    <field name="diff_igst"/>
                                    <field name="diff_cess"/>
                                    <field name="diff_total_tax"/>
                                    <field name="diff_invoice_value"/>
                                </group>
                            </group>
                        </page>
                        <page string="GST Upload File" name="excel">
                            <div class="alert alert-info" role="alert">
                                This GST upload file is the official GSTN Returns Offline Tool Excel workbook.
                                Import it into the Offline Tool to create the JSON uploaded to the GST Portal.
                            </div>
                            <group string="Offline Tool Template">
                                <field name="template_id" readonly="is_readonly_state"/>
                                <field name="template_version" readonly="1"/>
                            </group>
                            <group string="Generated Upload File">
                                <field name="generated_filename" readonly="1"/>
                                <field name="generated_at" readonly="1"/>
                                <field name="generated_by" readonly="1"/>
                                <field name="generated_file" filename="generated_filename" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" readonly="state in ('filed', 'cancelled')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rn_gst_filing_search" model="ir.ui.view">
        <field name="name">rn.gst.filing.search</field>
        <field name="model">rn.gst.filing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="gstin"/>
                <field name="gst_registration_id"/>
                <field name="return_period"/>
                <field name="financial_year"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Data Loaded" name="data_loaded" domain="[('state', '=', 'data_loaded')]"/>
                <filter string="My Filings" name="my_filings" domain="[('create_uid', '=', uid)]"/>
                <filter string="With Errors" name="with_errors" domain="[('validation_error_count', '>', 0)]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'return_period'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="GST Registration" name="group_registration" context="{'group_by': 'gst_registration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rn_gst_filing" model="ir.actions.act_window">
        <field name="name">GST Returns</field>
        <field name="res_model">rn.gst.filing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_rn_gst_filing_my" model="ir.actions.act_window">
        <field name="name">My Filings</field>
        <field name="res_model">rn.gst.filing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_filings': 1}</field>
    </record>

    <record id="action_rn_gst_filing_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">rn.gst.filing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
