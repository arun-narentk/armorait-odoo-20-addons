<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_gstr9c_view_list" model="ir.ui.view">
        <field name="name">rn.gst.gstr9c.list</field>
        <field name="model">rn.gst.gstr9c</field>
        <field name="arch" type="xml">
            <list string="GSTR-9C Reconciliation Statements">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="gstin"/>
                <field name="financial_year"/>
                <field name="gstr9_id"/>
                <field name="filled_at"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'computed'" decoration-success="state == 'filed'"/>
            </list>
        </field>
    </record>

    <record id="rn_gst_gstr9c_view_form" model="ir.ui.view">
        <field name="name">rn.gst.gstr9c.form</field>
        <field name="model">rn.gst.gstr9c</field>
        <field name="arch" type="xml">
            <form string="GSTR-9C Reconciliation Statement">
                <header>
                    <button name="action_fill_from_books" type="object" string="Fill from Books" class="btn-primary"
                            invisible="state == 'filed'"
                            title="Fill turnover, tax and ITC from the ledger and the year's GSTR-9. Adjustments and reasons are kept."/>
                    <button name="%(rn_gst_filing_action_report_gstr9c)d" type="action" string="Print GSTR-9C" icon="print"/>
                    <button name="action_mark_filed" type="object" string="Mark Filed" invisible="state != 'computed'"
                            groups="rn_gst_filing.group_rn_gst_filing_manager"
                            confirm="Mark this GSTR-9C as filed? It becomes read-only."/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'filed'"
                            groups="rn_gst_filing.group_rn_gst_filing_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,filed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="gstin" readonly="state != 'draft'"/>
                            <field name="financial_year" readonly="state != 'draft'" placeholder="2025-26"/>
                            <field name="gstr9_id" readonly="state == 'filed'"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="filled_at"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not fill_warning">
                        <field name="fill_warning"/>
                    </div>
                    <div class="text-muted mb-2">
                        Books and GSTR-9 rows are refilled each time. Enter the adjustments in the Manual rows and the reasons
                        below each part. Totals update when you change a row.
                    </div>
                    <notebook>
                        <page string="Part II: Turnover (5 to 8)" name="part2">
                            <field name="part2_line_ids" readonly="state == 'filed'">
                                <list editable="bottom" create="0" delete="0" decoration-bf="source == 'computed'" decoration-muted="source == 'computed'">
                                    <field name="code" string="Row"/>
                                    <field name="label"/>
                                    <field name="value" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'itc'"/>
                                    <field name="igst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="cgst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="sgst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="cess" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="source" optional="show"/>
                                    <field name="kind" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <field name="reason_turnover" readonly="state == 'filed'"/>
                                <field name="reason_taxable" readonly="state == 'filed'"/>
                            </group>
                        </page>
                        <page string="Part III: Tax Paid (9 to 11)" name="part3">
                            <separator string="Table 9: tax liability as per books, by rate"/>
                            <field name="rate_ids" readonly="state == 'filed'">
                                <list editable="bottom">
                                    <field name="rate"/>
                                    <field name="taxable_value" sum="Total"/>
                                    <field name="igst" sum="Total"/>
                                    <field name="cgst" sum="Total"/>
                                    <field name="sgst" sum="Total"/>
                                    <field name="cess" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <field name="part3_line_ids" readonly="state == 'filed'">
                                <list editable="bottom" create="0" delete="0" decoration-bf="source == 'computed'" decoration-muted="source == 'computed'">
                                    <field name="code" string="Row"/>
                                    <field name="label"/>
                                    <field name="value" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'itc'"/>
                                    <field name="igst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="cgst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="sgst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="cess" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="source" optional="show"/>
                                    <field name="kind" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <field name="reason_tax" readonly="state == 'filed'"/>
                            </group>
                        </page>
                        <page string="Part IV: ITC (12 to 16)" name="part4">
                            <field name="part4_line_ids" readonly="state == 'filed'">
                                <list editable="bottom" create="0" delete="0" decoration-bf="source == 'computed'" decoration-muted="source == 'computed'">
                                    <field name="code" string="Row"/>
                                    <field name="label"/>
                                    <field name="value" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'itc'"/>
                                    <field name="igst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="cgst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="sgst" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="cess" readonly="source in ('computed', 'books', 'gstr9')" invisible="kind == 'value'"/>
                                    <field name="source" optional="show"/>
                                    <field name="kind" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <separator string="Table 14: ITC on expenses as per books, by expense account"/>
                            <field name="expense_ids" readonly="state == 'filed'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="account_id" optional="hide"/>
                                    <field name="expense_value" sum="Total"/>
                                    <field name="itc_amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <field name="reason_itc" readonly="state == 'filed'"/>
                                <field name="reason_expense_itc" readonly="state == 'filed'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rn_gst_gstr9c_view_search" model="ir.ui.view">
        <field name="name">rn.gst.gstr9c.search</field>
        <field name="model">rn.gst.gstr9c</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="gstin"/>
                <field name="financial_year"/>
                <filter string="Filed" name="filed" domain="[('state', '=', 'filed')]"/>
                <filter string="Not Filed" name="not_filed" domain="[('state', '!=', 'filed')]"/>
            </search>
        </field>
    </record>

    <record id="rn_gst_gstr9c_action" model="ir.actions.act_window">
        <field name="name">GSTR-9C Reconciliation</field>
        <field name="res_model">rn.gst.gstr9c</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Prepare your GSTR-9C reconciliation statement</p>
            <p>Fill your GSTR-9 first, then create a GSTR-9C for the same year and press Fill from Books. It compares the
               turnover, tax and ITC in your books with the annual return.</p>
        </field>
    </record>

    <menuitem id="rn_gst_gstr9c_menu"
              name="GSTR-9C Reconciliation"
              parent="menu_rn_gst_filing_root"
              action="rn_gst_gstr9c_action"
              sequence="36"/>
</odoo>
