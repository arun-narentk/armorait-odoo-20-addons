<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_filing_action_report_gstr9" model="ir.actions.report">
        <field name="name">GSTR-9 Annual Return</field>
        <field name="model">rn.gst.gstr9</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_gst_filing.report_gstr9</field>
        <field name="print_report_name">'GSTR-9 - %s - %s' % (object.gstin, object.financial_year)</field>
        <field name="binding_model_id" ref="model_rn_gst_gstr9"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_gstr9_rows">
        <table class="table table-sm table-bordered mb-4">
            <thead class="table-light">
                <tr t-if="pay">
                    <th class="w-50">Details</th>
                    <th class="text-end">Tax payable</th>
                    <th class="text-end">Paid in cash</th>
                    <th class="text-end">Paid via IGST</th>
                    <th class="text-end">Paid via CGST</th>
                    <th class="text-end">Paid via SGST</th>
                    <th class="text-end">Paid via Cess</th>
                </tr>
                <tr t-else="">
                    <th class="w-50">Details</th>
                    <th class="text-end">Value</th>
                    <th class="text-end">IGST</th>
                    <th class="text-end">CGST</th>
                    <th class="text-end">SGST/UTGST</th>
                    <th class="text-end">Cess</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="lines" t-as="line" t-attf-class="{{'fw-bold' if line.source == 'computed' else ''}}">
                    <td><strong t-out="line.code"/> <span t-out="line.label"/></td>
                    <t t-if="line.kind == 'itc'"><td class="text-end text-muted">-</td></t>
                    <t t-else=""><td class="text-end" t-out="line.value" t-options="money"/></t>
                    <td t-if="pay" class="text-end" t-out="line.cash" t-options="money"/>
                    <t t-if="line.kind == 'value'">
                        <td class="text-end text-muted">-</td><td class="text-end text-muted">-</td>
                        <td class="text-end text-muted">-</td><td class="text-end text-muted">-</td>
                    </t>
                    <t t-else="">
                        <td class="text-end" t-out="line.igst" t-options="money"/>
                        <td class="text-end" t-out="line.cgst" t-options="money"/>
                        <td class="text-end" t-out="line.sgst" t-options="money"/>
                        <td class="text-end" t-out="line.cess" t-options="money"/>
                    </t>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_gstr9_hsn">
        <table class="table table-sm table-bordered mb-4">
            <thead class="table-light">
                <tr>
                    <th>HSN/SAC</th>
                    <th>UQC</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Rate %</th>
                    <th class="text-end">Taxable value</th>
                    <th class="text-end">IGST</th>
                    <th class="text-end">CGST</th>
                    <th class="text-end">SGST/UTGST</th>
                    <th class="text-end">Cess</th>
                </tr>
            </thead>
            <tbody>
                <tr t-if="not hsn_lines">
                    <td colspan="9" class="text-center text-muted">No lines.</td>
                </tr>
                <tr t-foreach="hsn_lines" t-as="line">
                    <td t-out="line.hsn_code"/>
                    <td t-out="line.uqc or '-'"/>
                    <td class="text-end" t-out="line.quantity" t-options="{'widget': 'float', 'precision': 2}"/>
                    <td class="text-end" t-out="line.rate" t-options="{'widget': 'float', 'precision': 2}"/>
                    <td class="text-end" t-out="line.taxable_value" t-options="money"/>
                    <td class="text-end" t-out="line.igst" t-options="money"/>
                    <td class="text-end" t-out="line.cgst" t-options="money"/>
                    <td class="text-end" t-out="line.sgst" t-options="money"/>
                    <td class="text-end" t-out="line.cess" t-options="money"/>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_gstr9_document">
        <t t-call="web.external_layout">
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
            <div class="page o_rn_gst_report">
                <h3 class="mb-1">GSTR-9 Annual Return</h3>
                <p class="text-muted mb-3">Prepared from Odoo books and the year's GSTR-3B and GSTR-2B records. Check against the GST Portal before you file.</p>
                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td class="w-25"><strong>GSTIN</strong></td>
                        <td class="w-25" t-out="doc.gstin"/>
                        <td class="w-25"><strong>Reference</strong></td>
                        <td class="w-25" t-out="doc.name"/>
                    </tr>
                    <tr>
                        <td><strong>Legal name</strong></td>
                        <td t-out="doc.company_id.name"/>
                        <td><strong>Financial year</strong></td>
                        <td t-out="doc.financial_year"/>
                    </tr>
                    <tr>
                        <td><strong>Status</strong></td>
                        <td><span t-field="doc.state"/></td>
                        <td><strong>GSTR-3B months found</strong></td>
                        <td><span t-out="doc.gstr3b_months"/> of 12</td>
                    </tr>
                </table>
                <div t-if="doc.fill_warning" class="alert alert-warning small" t-out="doc.fill_warning"/>

                <t t-foreach="[('2', 'Part II: Details of outward and inward supplies (Tables 4 and 5)'), ('3', 'Part III: Input tax credit (Tables 6, 7 and 8)'), ('4', 'Part IV: Tax paid as declared in returns (Table 9)'), ('5', 'Part V: Transactions of this year declared in the next year (Tables 10 to 14)'), ('6', 'Part VI: Other information (Tables 15, 16 and 19)')]" t-as="part">
                    <h5 t-out="part[1]"/>
                    <t t-call="rn_gst_filing.report_gstr9_rows"
                       lines="doc.line_ids.filtered(lambda l: l.part == part[0])" pay="part[0] == '4'" money="money"/>
                </t>

                <h5>HSN-wise summary of outward supplies (Table 17)</h5>
                <t t-call="rn_gst_filing.report_gstr9_hsn" hsn_lines="doc.hsn_outward_ids" money="money"/>
                <h5>HSN-wise summary of inward supplies (Table 18)</h5>
                <t t-call="rn_gst_filing.report_gstr9_hsn" hsn_lines="doc.hsn_inward_ids" money="money"/>
            </div>
        </t>
    </template>

    <template id="report_gstr9">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="rn_gst_filing.report_gstr9_document"/>
            </t>
        </t>
    </template>
</odoo>
