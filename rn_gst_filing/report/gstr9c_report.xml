<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_filing_action_report_gstr9c" model="ir.actions.report">
        <field name="name">GSTR-9C Reconciliation Statement</field>
        <field name="model">rn.gst.gstr9c</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_gst_filing.report_gstr9c</field>
        <field name="print_report_name">'GSTR-9C - %s - %s' % (object.gstin, object.financial_year)</field>
        <field name="binding_model_id" ref="model_rn_gst_gstr9c"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_gstr9c_rows">
        <table class="table table-sm table-bordered mb-3">
            <thead class="table-light">
                <tr>
                    <th class="w-50">Details</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">IGST</th>
                    <th class="text-end">CGST</th>
                    <th class="text-end">SGST/UTGST</th>
                    <th class="text-end">Cess</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="lines" t-as="line" t-attf-class="{{'fw-bold' if line.source == 'computed' else ''}}">
                    <td><strong t-out="line.code"/> <span t-out="line.label"/></td>
                    <t t-if="line.kind == 'itc'"><td class="text-end text-muted">-</td></t>
                    <t t-else=""><td class="text-end" t-out="line.value" t-options="money"/></t>
                    <t t-if="line.kind == 'value'">
                        <td class="text-end text-muted">-</td><td class="text-end text-muted">-</td>
                        <td class="text-end text-muted">-</td><td class="text-end text-muted">-</td>
                    </t>
                    <t t-else="">
                        <td class="text-end" t-out="line.igst" t-options="money"/>
                        <td class="text-end" t-out="line.cgst" t-options="money"/>
                        <td class="text-end" t-out="line.sgst" t-options="money"/>
                        <td class="text-end" t-out="line.cess" t-options="money"/>
                    </t>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_gstr9c_reason">
        <p t-if="text" class="small mb-4"><strong t-out="title"/>: <span t-out="text"/></p>
    </template>

    <template id="report_gstr9c_document">
        <t t-call="web.external_layout">
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
            <div class="page o_rn_gst_report">
                <h3 class="mb-1">GSTR-9C Reconciliation Statement</h3>
                <p class="text-muted mb-3">Self-certified reconciliation of the audited books with the GSTR-9 annual return. Check against the GST Portal before you file.</p>
                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td class="w-25"><strong>GSTIN</strong></td>
                        <td class="w-25" t-out="doc.gstin"/>
                        <td class="w-25"><strong>Reference</strong></td>
                        <td class="w-25" t-out="doc.name"/>
                    </tr>
                    <tr>
                        <td><strong>Legal name</strong></td>
                        <td t-out="doc.company_id.name"/>
                        <td><strong>Financial year</strong></td>
                        <td t-out="doc.financial_year"/>
                    </tr>
                    <tr>
                        <td><strong>GSTR-9</strong></td>
                        <td t-out="doc.gstr9_id.name or 'Not linked'"/>
                        <td><strong>Status</strong></td>
                        <td><span t-field="doc.state"/></td>
                    </tr>
                </table>
                <div t-if="doc.fill_warning" class="alert alert-warning small" t-out="doc.fill_warning"/>

                <h5>Part II: Reconciliation of turnover (Tables 5 and 7)</h5>
                <t t-call="rn_gst_filing.report_gstr9c_rows" lines="doc.part2_line_ids" money="money"/>
                <t t-call="rn_gst_filing.report_gstr9c_reason" title="'Table 6 reasons'" text="doc.reason_turnover"/>
                <t t-call="rn_gst_filing.report_gstr9c_reason" title="'Table 8 reasons'" text="doc.reason_taxable"/>

                <h5>Part III: Reconciliation of tax paid (Tables 9 and 11)</h5>
                <table class="table table-sm table-bordered mb-3">
                    <thead class="table-light">
                        <tr>
                            <th>Rate %</th>
                            <th class="text-end">Taxable value</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST/UTGST</th>
                            <th class="text-end">Cess</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="not doc.rate_ids"><td colspan="6" class="text-center text-muted">No taxable supplies.</td></tr>
                        <tr t-foreach="doc.rate_ids" t-as="rate">
                            <td t-out="rate.rate" t-options="{'widget': 'float', 'precision': 2}"/>
                            <td class="text-end" t-out="rate.taxable_value" t-options="money"/>
                            <td class="text-end" t-out="rate.igst" t-options="money"/>
                            <td class="text-end" t-out="rate.cgst" t-options="money"/>
                            <td class="text-end" t-out="rate.sgst" t-options="money"/>
                            <td class="text-end" t-out="rate.cess" t-options="money"/>
                        </tr>
                    </tbody>
                </table>
                <t t-call="rn_gst_filing.report_gstr9c_rows" lines="doc.part3_line_ids" money="money"/>
                <t t-call="rn_gst_filing.report_gstr9c_reason" title="'Table 10 reasons'" text="doc.reason_tax"/>

                <h5>Part IV: Reconciliation of input tax credit (Tables 12, 14 and 16)</h5>
                <t t-call="rn_gst_filing.report_gstr9c_rows" lines="doc.part4_line_ids" money="money"/>
                <table class="table table-sm table-bordered mb-3">
                    <thead class="table-light">
                        <tr>
                            <th>Expense head (Table 14)</th>
                            <th class="text-end">Value</th>
                            <th class="text-end">Eligible ITC</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="not doc.expense_ids"><td colspan="3" class="text-center text-muted">No ITC on expenses.</td></tr>
                        <tr t-foreach="doc.expense_ids" t-as="expense">
                            <td t-out="expense.name"/>
                            <td class="text-end" t-out="expense.expense_value" t-options="money"/>
                            <td class="text-end" t-out="expense.itc_amount" t-options="money"/>
                        </tr>
                    </tbody>
                </table>
                <t t-call="rn_gst_filing.report_gstr9c_reason" title="'Table 13 reasons'" text="doc.reason_itc"/>
                <t t-call="rn_gst_filing.report_gstr9c_reason" title="'Table 15 reasons'" text="doc.reason_expense_itc"/>
            </div>
        </t>
    </template>

    <template id="report_gstr9c">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="rn_gst_filing.report_gstr9c_document"/>
            </t>
        </t>
    </template>
</odoo>
