<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_resume_parser" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.resume.parser</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_recruitment.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='recruitment_process_div']" position="inside">
                <setting id="resume_parser_auto_skills" string="Auto-create skills from resume" help="When parsing resumes, create new skills for unknown skill names instead of skipping them.">
                    <field name="hr_resume_ai_parser_auto_create_skills"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
