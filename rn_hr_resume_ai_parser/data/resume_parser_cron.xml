<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_resume_parser_process" model="ir.cron">
        <field name="name">HR Resume Parser: Process Pending</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_resume_parsing()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_resume_similarity" model="ir.cron">
        <field name="name">HR Resume Parser: Compute Similarities</field>
        <field name="model_id" ref="rn_hr_resume_ai_parser.model_hr_resume_similarity"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_similarities(limit=30)</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
