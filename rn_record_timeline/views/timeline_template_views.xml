<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_timeline_template_list" model="ir.ui.view">
        <field name="name">rn.timeline.template.list</field>
        <field name="model">rn.timeline.template</field>
        <field name="arch" type="xml">
            <list string="Timeline Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="state_from"/>
                <field name="state_to"/>
                <field name="event_label"/>
                <field name="event_type"/>
                <field name="filter_category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_timeline_template_form" model="ir.ui.view">
        <field name="name">rn.timeline.template.form</field>
        <field name="model">rn.timeline.template</field>
        <field name="arch" type="xml">
            <form string="Timeline Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="state_from"/>
                            <field name="state_to"/>
                            <field name="event_label"/>
                        </group>
                        <group>
                            <field name="event_type"/>
                            <field name="filter_category"/>
                            <field name="icon"/>
                            <field name="color" widget="color"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_timeline_template" model="ir.actions.act_window">
        <field name="name">Timeline Templates</field>
        <field name="res_model">rn.timeline.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
