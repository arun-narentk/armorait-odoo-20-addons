<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sale order -->
    <record id="timeline_template_so_sent" model="rn.timeline.template">
        <field name="name">Sale: Quotation Sent</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state_from">draft</field>
        <field name="state_to">sent</field>
        <field name="event_type">sent</field>
        <field name="event_label">Quotation Sent</field>
        <field name="icon">fa-paper-plane</field>
        <field name="color">#2563eb</field>
        <field name="filter_category">general</field>
        <field name="sequence">20</field>
    </record>
    <record id="timeline_template_so_confirmed" model="rn.timeline.template">
        <field name="name">Sale: Quotation Confirmed</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state_to">sale</field>
        <field name="event_type">confirmed</field>
        <field name="event_label">Quotation Confirmed</field>
        <field name="icon">fa-check-circle</field>
        <field name="color">#16a34a</field>
        <field name="filter_category">approval</field>
        <field name="sequence">30</field>
    </record>
    <record id="timeline_template_so_cancel" model="rn.timeline.template">
        <field name="name">Sale: Cancelled</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state_to">cancel</field>
        <field name="event_type">cancelled</field>
        <field name="event_label">Cancelled</field>
        <field name="icon">fa-ban</field>
        <field name="color">#dc2626</field>
        <field name="filter_category">general</field>
        <field name="sequence">90</field>
    </record>

    <!-- Purchase order -->
    <record id="timeline_template_po_sent" model="rn.timeline.template">
        <field name="name">Purchase: RFQ Sent</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state_from">draft</field>
        <field name="state_to">sent</field>
        <field name="event_type">sent</field>
        <field name="event_label">RFQ Sent</field>
        <field name="icon">fa-paper-plane</field>
        <field name="color">#2563eb</field>
        <field name="filter_category">general</field>
        <field name="sequence">20</field>
    </record>
    <record id="timeline_template_po_purchase" model="rn.timeline.template">
        <field name="name">Purchase: Confirmed</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state_to">purchase</field>
        <field name="event_type">confirmed</field>
        <field name="event_label">Purchase Confirmed</field>
        <field name="icon">fa-check-circle</field>
        <field name="color">#16a34a</field>
        <field name="filter_category">approval</field>
        <field name="sequence">30</field>
    </record>
    <record id="timeline_template_po_done" model="rn.timeline.template">
        <field name="name">Purchase: Received</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state_to">done</field>
        <field name="event_type">received</field>
        <field name="event_label">Received</field>
        <field name="icon">fa-box-open</field>
        <field name="color">#0891b2</field>
        <field name="filter_category">logistics</field>
        <field name="sequence">50</field>
    </record>

    <!-- Customer invoice -->
    <record id="timeline_template_inv_posted" model="rn.timeline.template">
        <field name="name">Invoice: Posted</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state_from">draft</field>
        <field name="state_to">posted</field>
        <field name="event_type">posted</field>
        <field name="event_label">Invoice Posted</field>
        <field name="icon">fa-file-invoice</field>
        <field name="color">#7c3aed</field>
        <field name="filter_category">financial</field>
        <field name="sequence">30</field>
    </record>
    <record id="timeline_template_inv_cancel" model="rn.timeline.template">
        <field name="name">Invoice: Cancelled</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state_to">cancel</field>
        <field name="event_type">cancelled</field>
        <field name="event_label">Invoice Cancelled</field>
        <field name="icon">fa-ban</field>
        <field name="color">#dc2626</field>
        <field name="filter_category">financial</field>
        <field name="sequence">90</field>
    </record>
</odoo>
