<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="rn_mobile_platform.Dashboard"><div class="o_rn_mobile_platform_dashboard o_action p-3"><h2>Mobile Platform</h2><div t-if="this.state.loading" class="text-muted">Loading mobile platform metrics...</div><div t-else=""><div class="row g-3 mb-4"><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Apps</div><h3 t-out="this.state.data.apps"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Published</div><h3 t-out="this.state.data.published_apps"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Offline</div><h3 t-out="this.state.data.offline_enabled_apps"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Barcode</div><h3 t-out="this.state.data.barcode_apps"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Push</div><h3 t-out="this.state.data.push_enabled_apps"/></div></div></div><div class="card p-3"><h5>Recent Apps</h5><div t-if="this.state.data.recent_apps.length" class="list-group list-group-flush"><div class="list-group-item" t-foreach="this.state.data.recent_apps" t-as="item" t-key="item.id"><strong t-out="item.name"/> - <t t-out="item.scope"/> - <t t-out="item.state"/></div></div><div t-else="" class="text-muted">No mobile apps yet.</div></div></div></div></t></templates>
