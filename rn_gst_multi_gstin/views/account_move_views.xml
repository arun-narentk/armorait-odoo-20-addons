<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rn.gst.multi.gstin</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not rn_gst_tax_mismatch">
                    <field name="rn_gst_tax_mismatch" invisible="1"/>
                    <field name="rn_gst_tax_warning" readonly="1"/>
                </div>
            </xpath>
            <field name="l10n_in_gst_treatment" position="after">
                <field name="rn_gst_registration_id" options="{'no_create': True}"
                       invisible="country_code != 'IN' or move_type not in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund', 'in_receipt')"
                       readonly="state != 'draft'"/>
                <field name="rn_gst_supply_type" invisible="not rn_gst_supply_type"/>
            </field>
        </field>
    </record>

    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">account.invoice.list.inherit.rn.gst.multi.gstin</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="rn_gst_registration_id" optional="hide"/>
                <field name="rn_gst_tax_mismatch" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.invoice.select.inherit.rn.gst.multi.gstin</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rn_gst_registration_id"/>
            </field>
            <xpath expr="//filter[@name='late']" position="after">
                <separator/>
                <filter string="GST Tax Type Warning" name="rn_gst_tax_mismatch" domain="[('rn_gst_tax_mismatch', '=', True)]"/>
                <filter string="Inter-state" name="rn_gst_inter" domain="[('rn_gst_supply_type', '=', 'inter')]"/>
                <filter string="Intra-state" name="rn_gst_intra" domain="[('rn_gst_supply_type', '=', 'intra')]"/>
            </xpath>
            <xpath expr="//filter[@name='duedate']" position="after">
                <filter string="Our GSTIN" name="group_rn_gst_registration" context="{'group_by': 'rn_gst_registration_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
