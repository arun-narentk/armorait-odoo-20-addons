<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rn.gst.export</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="rn_exp_check_state != 'error'">
                    <strong>GST export check</strong>
                    <field name="rn_exp_check_messages" readonly="1"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="rn_exp_check_state != 'warning'">
                    <strong>GST export check</strong>
                    <field name="rn_exp_check_messages" readonly="1"/>
                </div>
                <field name="rn_exp_check_state" invisible="1"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']/group[@id='other_tab_group']" position="after">
                <group string="Export Compliance" name="rn_exp" invisible="not rn_exp_kind">
                    <group>
                        <field name="rn_exp_kind"/>
                        <field name="rn_exp_lut_id" invisible="rn_exp_kind == 'igst'"/>
                        <field name="rn_exp_refund_ready" invisible="rn_exp_kind != 'igst'"/>
                        <field name="rn_exp_has_goods" invisible="1"/>
                    </group>
                    <group>
                        <field name="rn_exp_realised_amount"/>
                        <field name="rn_exp_realised_date"/>
                        <field name="rn_exp_brc_number"/>
                        <field name="rn_exp_brc_date"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="rn_exp_register_view_list" model="ir.ui.view">
        <field name="name">account.move.list.rn.exp.register</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Export Register" create="false" decoration-danger="rn_exp_check_state == 'error'"
                  decoration-warning="rn_exp_check_state == 'warning'">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="l10n_in_gst_treatment" optional="show"/>
                <field name="rn_exp_kind"/>
                <field name="rn_exp_lut_id" optional="show"/>
                <field name="currency_id" optional="show"/>
                <field name="amount_total" sum="Total" optional="show"/>
                <field name="amount_total_signed" string="Total (INR)" sum="Total" optional="hide"/>
                <field name="l10n_in_shipping_bill_number" optional="show"/>
                <field name="l10n_in_shipping_bill_date" optional="show"/>
                <field name="l10n_in_shipping_port_code_id" optional="hide"/>
                <field name="payment_state" widget="badge" optional="show"/>
                <field name="rn_exp_brc_number" optional="hide"/>
                <field name="rn_exp_refund_ready" optional="hide"/>
                <field name="rn_exp_check_messages" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="rn_exp_check_state" widget="badge" decoration-success="rn_exp_check_state == 'ok'"
                       decoration-warning="rn_exp_check_state == 'warning'" decoration-danger="rn_exp_check_state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="rn_exp_register_view_search" model="ir.ui.view">
        <field name="name">account.move.search.rn.exp.register</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="l10n_in_shipping_bill_number"/>
                <field name="rn_exp_lut_id"/>
                <filter string="Under LUT" name="lut" domain="[('rn_exp_kind', '=', 'lut')]"/>
                <filter string="IGST Paid" name="igst" domain="[('rn_exp_kind', '=', 'igst')]"/>
                <separator/>
                <filter string="Errors" name="errors" domain="[('rn_exp_check_state', '=', 'error')]"/>
                <filter string="Warnings" name="warnings" domain="[('rn_exp_check_state', '=', 'warning')]"/>
                <separator/>
                <filter string="Exports" name="overseas" domain="[('l10n_in_gst_treatment', '=', 'overseas')]"/>
                <filter string="SEZ" name="sez" domain="[('l10n_in_gst_treatment', '=', 'special_economic_zone')]"/>
                <separator/>
                <filter string="Not Paid" name="not_paid" domain="[('payment_state', 'not in', ('paid', 'in_payment', 'reversed'))]"/>
                <filter string="Refund Ready" name="refund_ready" domain="[('rn_exp_refund_ready', '=', True)]"/>
                <filter string="Invoice Date" name="invoice_date" date="invoice_date"/>
                <group>
                    <filter string="Export Type" name="group_kind" context="{'group_by': 'rn_exp_kind'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rn_exp_register_action" model="ir.actions.act_window">
        <field name="name">Export Register</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="rn_exp_register_view_list"/>
        <field name="search_view_id" ref="rn_exp_register_view_search"/>
        <field name="domain">[('rn_exp_kind', '!=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No export or SEZ invoices</p>
            <p>Invoices with GST treatment Overseas or Special Economic Zone show here with their checks.</p>
        </field>
    </record>
</odoo>
