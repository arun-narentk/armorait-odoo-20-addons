<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_textile_factory_list" model="ir.ui.view">
        <field name="name">rn.textile.factory.list</field>
        <field name="model">rn.textile.factory</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="unit_type"/>
                <field name="city"/>
                <field name="department_count"/>
                <field name="machine_count"/>
                <field name="yarn_spec_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_textile_factory_form" model="ir.ui.view">
        <field name="name">rn.textile.factory.form</field>
        <field name="model">rn.textile.factory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_departments" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="department_count" widget="statinfo" string="Departments"/>
                        </button>
                        <button name="action_open_machines" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="machine_count" widget="statinfo" string="Machines"/>
                        </button>
                        <button name="action_open_yarn_specs" type="object" class="oe_stat_button" icon="fa-database">
                            <field name="yarn_spec_count" widget="statinfo" string="Yarn Specs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="unit_type"/>
                            <field name="legal_name"/>
                            <field name="registration_no"/>
                            <field name="gstin"/>
                            <field name="iec_code"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                            <field name="timezone"/>
                            <field name="established_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Departments" name="departments">
                            <field name="department_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="department_type"/>
                                    <field name="manager_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_textile_factory" model="ir.actions.act_window">
        <field name="name">Factories</field>
        <field name="res_model">rn.textile.factory</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
