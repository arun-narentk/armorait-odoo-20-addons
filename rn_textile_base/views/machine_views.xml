<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_textile_machine_list" model="ir.ui.view">
        <field name="name">rn.textile.machine.list</field>
        <field name="model">rn.textile.machine</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'breakdown'" decoration-warning="state == 'maintenance'">
                <field name="code"/>
                <field name="name"/>
                <field name="factory_id"/>
                <field name="department_id"/>
                <field name="machine_type"/>
                <field name="capacity_per_day"/>
                <field name="state"/>
                <field name="operator_id"/>
            </list>
        </field>
    </record>
    <record id="view_rn_textile_machine_form" model="ir.ui.view">
        <field name="name">rn.textile.machine.form</field>
        <field name="model">rn.textile.machine</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,maintenance,breakdown,retired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="factory_id"/>
                            <field name="department_id"/>
                            <field name="machine_type"/>
                        </group>
                        <group>
                            <field name="manufacturer"/>
                            <field name="model_no"/>
                            <field name="serial_no"/>
                            <field name="capacity_per_day"/>
                            <field name="capacity_uom_id"/>
                            <field name="operator_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_textile_machine" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">rn.textile.machine</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
