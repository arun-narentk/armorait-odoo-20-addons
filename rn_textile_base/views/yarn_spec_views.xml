<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_textile_yarn_spec_list" model="ir.ui.view">
        <field name="name">rn.textile.yarn.spec.list</field>
        <field name="model">rn.textile.yarn.spec</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="factory_id"/>
                <field name="yarn_count"/>
                <field name="blend_type"/>
                <field name="blend_ratio"/>
                <field name="gsm"/>
                <field name="color_name"/>
                <field name="supplier_id"/>
            </list>
        </field>
    </record>
    <record id="view_rn_textile_yarn_spec_form" model="ir.ui.view">
        <field name="name">rn.textile.yarn.spec.form</field>
        <field name="model">rn.textile.yarn.spec</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="factory_id"/>
                            <field name="yarn_count"/>
                            <field name="blend_type"/>
                            <field name="blend_ratio"/>
                        </group>
                        <group>
                            <field name="gsm"/>
                            <field name="color_name"/>
                            <field name="lot_prefix"/>
                            <field name="supplier_id"/>
                            <field name="uom_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_textile_yarn_spec" model="ir.actions.act_window">
        <field name="name">Yarn Specifications</field>
        <field name="res_model">rn.textile.yarn.spec</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
