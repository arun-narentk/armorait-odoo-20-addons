<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_conversational_erp">
        <field name="name">Conversational ERP</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_conversational_erp_user" model="res.groups">
        <field name="name">Conversational ERP User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_conversational_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_conversational_erp_manager" model="res.groups">
        <field name="name">Conversational ERP Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_conversational_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_conversational_erp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
