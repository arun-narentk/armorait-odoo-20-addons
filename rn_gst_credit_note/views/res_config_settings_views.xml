<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rn.gst.credit.note</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rn_gst_base.view_rn_gst_base_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='rn_gst_base_settings']" position="inside">
                <setting string="Credit Note GST Errors" help="Stop posting a credit note that breaks a GST rule (time limit, more than the invoice, other rates).">
                    <field name="rn_gst_cn_block_on_error"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
