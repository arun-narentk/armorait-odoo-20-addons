<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_reversal" model="ir.ui.view">
        <field name="name">account.move.reversal.form.inherit.rn.gst.credit.note</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <field name="reason" position="before">
                <field name="rn_cn_reason_id" options="{'no_create': True}"
                       invisible="country_code != 'IN' or move_type == 'entry'"/>
            </field>
        </field>
    </record>
</odoo>
