<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_inherit_whatsapp" model="ir.ui.view">
            <field name="name">stock.picking.form.whatsapp</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_cancel']" position="before">
                    <button name="action_send_whatsapp" type="object" string="Send via WhatsApp"
                            class="oe_highlight" invisible="not can_send_whatsapp" groups="stock.group_stock_user"/>
                </xpath>
                <xpath expr="//form/sheet" position="inside">
                    <field name="can_send_whatsapp" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
