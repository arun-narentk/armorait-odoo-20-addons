<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="whatsapp_reminder_view_tree" model="ir.ui.view">
            <field name="name">whatsapp.reminder.tree</field>
            <field name="model">whatsapp.reminder</field>
            <field name="arch" type="xml">
                <list string="WhatsApp Reminders" create="0" delete="1" multi_edit="1">
                    <field name="res_model"/>
                    <field name="res_id"/>
                    <field name="partner_id"/>
                    <field name="reminder_type"/>
                    <field name="state"/>
                    <field name="scheduled_date"/>
                    <field name="sent_at"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <button name="action_open_document" type="object" string="Open" icon="fa-external-link"/>
                    <button name="action_send_whatsapp" type="object" string="Send via WhatsApp" icon="fa-whatsapp"
                        invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'pending'"/>
                </list>
            </field>
        </record>
        <record id="whatsapp_reminder_view_search" model="ir.ui.view">
            <field name="name">whatsapp.reminder.search</field>
            <field name="model">whatsapp.reminder</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                    <filter name="filter_sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                    <separator/>
                    <filter name="filter_invoice" string="Invoices" domain="[('reminder_type', 'in', ['invoice_followup', 'payment_reminder'])]"/>
                    <filter name="filter_sales" string="Sales" domain="[('reminder_type', '=', 'sales_followup')]"/>
                    <filter name="filter_delivery" string="Delivery" domain="[('reminder_type', '=', 'delivery_alert')]"/>
                </search>
            </field>
        </record>
        <record id="whatsapp_reminder_view_form" model="ir.ui.view">
            <field name="name">whatsapp.reminder.form</field>
            <field name="model">whatsapp.reminder</field>
            <field name="arch" type="xml">
                <form string="WhatsApp Reminder">
                    <sheet>
                        <group>
                            <group>
                                <field name="reminder_type"/>
                                <field name="state"/>
                                <field name="partner_id"/>
                                <field name="scheduled_date"/>
                                <field name="sent_at" invisible="state != 'sent'"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="res_model"/>
                                <field name="res_id"/>
                            </group>
                        </group>
                        <group string="Message" invisible="not message_text">
                            <field name="message_text" nolabel="1" readonly="1" style="height: 120px;"/>
                        </group>
                        <footer>
                            <button name="action_open_document" type="object" string="Open Document" class="btn-primary"/>
                            <button name="action_send_whatsapp" type="object" string="Send via WhatsApp" class="oe_highlight" invisible="state != 'pending'"/>
                            <button name="action_cancel" type="object" string="Cancel" invisible="state != 'pending'"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_whatsapp_reminder" model="ir.actions.act_window">
            <field name="name">WhatsApp Reminders</field>
            <field name="res_model">whatsapp.reminder</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_filter_pending': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No WhatsApp reminders</p>
                <p>Reminders are created automatically when you enable WhatsApp Automation in Settings (Invoicing &gt; WhatsApp Automation).</p>
                <p>Pending reminders can be sent via WhatsApp from this list or from the related document.</p>
            </field>
        </record>
        <menuitem id="menu_whatsapp_reminder"
            name="WhatsApp Reminders"
            parent="account.menu_finance_receivables"
            action="action_whatsapp_reminder"
            sequence="50"/>
    </data>
</odoo>
