<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Send via WhatsApp button on invoice form (after Print) -->
        <record id="account_move_form_inherit_whatsapp" model="ir.ui.view">
            <field name="name">account.move.form.whatsapp</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_print_pdf'][2]" position="after">
                    <button name="action_send_whatsapp"
                            type="object"
                            string="Send via WhatsApp"
                            class="oe_highlight"
                            invisible="not can_send_whatsapp"
                            groups="account.group_account_invoice"/>
                </xpath>
                <xpath expr="//form/sheet" position="inside">
                    <field name="can_send_whatsapp" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
