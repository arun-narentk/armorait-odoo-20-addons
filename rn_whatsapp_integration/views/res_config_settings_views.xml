<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.whatsapp</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='account']" position="inside">
                    <block title="WhatsApp Automation" name="whatsapp_automation" string="WhatsApp Automation">
                        <setting id="whatsapp_invoice_followup" string="Unpaid invoice follow-up" company_dependent="1"
                            help="Create WhatsApp reminders for overdue unpaid customer invoices. Process them from Accounting &gt; WhatsApp Reminders.">
                            <field name="whatsapp_invoice_followup"/>
                            <div class="content-group mt16" invisible="not whatsapp_invoice_followup">
                                <div class="row">
                                    <label for="whatsapp_invoice_followup_days" class="col-lg-6 o_light_label"/>
                                    <field name="whatsapp_invoice_followup_days" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="whatsapp_payment_reminder" string="Payment reminder" company_dependent="1"
                            help="Create WhatsApp reminders for partially paid invoices.">
                            <field name="whatsapp_payment_reminder"/>
                        </setting>
                        <setting id="whatsapp_sales_followup" string="Sales follow-up" company_dependent="1"
                            help="Create WhatsApp follow-up reminders for quotations sent but not confirmed.">
                            <field name="whatsapp_sales_followup"/>
                            <div class="content-group mt16" invisible="not whatsapp_sales_followup">
                                <div class="row">
                                    <label for="whatsapp_sales_followup_days" class="col-lg-6 o_light_label"/>
                                    <field name="whatsapp_sales_followup_days" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="whatsapp_delivery_alert" string="Delivery status alert" company_dependent="1"
                            help="Create WhatsApp reminder when a delivery order is validated (done).">
                            <field name="whatsapp_delivery_alert"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
