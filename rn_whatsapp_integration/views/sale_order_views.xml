<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_form_inherit_whatsapp" model="ir.ui.view">
            <field name="name">sale.order.form.whatsapp</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@id='quotation_send']" position="after">
                    <button name="action_send_whatsapp" type="object" string="Send via WhatsApp"
                            class="oe_highlight" invisible="not can_send_whatsapp"/>
                </xpath>
                <xpath expr="//form/sheet" position="inside">
                    <field name="can_send_whatsapp" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
