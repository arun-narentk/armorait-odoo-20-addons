<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form_inherit_whatsapp" model="ir.ui.view">
            <field name="name">purchase.order.form.whatsapp</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_cancel']" position="before">
                    <button name="action_send_whatsapp" type="object" string="Send via WhatsApp"
                            class="oe_highlight" invisible="not can_send_whatsapp"/>
                </xpath>
                <xpath expr="//form/sheet" position="inside">
                    <field name="can_send_whatsapp" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
