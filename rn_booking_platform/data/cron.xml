<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
<record id="ir_cron_rn_booking_reminders" model="ir.cron">
<field name="name">Booking: Send Reminders</field>
<field name="model_id" ref="model_rn_booking_scheduler_service"/>
<field name="state">code</field>
<field name="code">model.cron_send_reminders()</field>
<field name="interval_number">1</field>
<field name="interval_type">hours</field>
<field name="active" eval="True"/>
</record>
<record id="ir_cron_rn_booking_no_show" model="ir.cron">
<field name="name">Booking: Mark No Shows</field>
<field name="model_id" ref="model_rn_booking_scheduler_service"/>
<field name="state">code</field>
<field name="code">model.cron_mark_no_shows()</field>
<field name="interval_number">1</field>
<field name="interval_type">days</field>
<field name="active" eval="True"/>
</record>
</data></odoo>
