<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_booking_location_list" model="ir.ui.view">
        <field name="name">rn.booking.location.list</field>
        <field name="model">rn.booking.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="industry_id"/>
                <field name="is_online"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_booking_location_form" model="ir.ui.view">
        <field name="name">rn.booking.location.form</field>
        <field name="model">rn.booking.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="industry_id"/>
                            <field name="is_online"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="timezone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="staff_ids" widget="many2many_tags"/>
                        <field name="note"/>
                    </group>
                    <field name="resource_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="resource_type"/>
                            <field name="capacity"/>
                            <field name="active"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_booking_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">rn.booking.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
