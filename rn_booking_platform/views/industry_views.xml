<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_booking_industry_list" model="ir.ui.view">
        <field name="name">rn.booking.industry.list</field>
        <field name="model">rn.booking.industry</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_booking_industry_form" model="ir.ui.view">
        <field name="name">rn.booking.industry.form</field>
        <field name="model">rn.booking.industry</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_booking_industry" model="ir.actions.act_window">
        <field name="name">Industries</field>
        <field name="res_model">rn.booking.industry</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
