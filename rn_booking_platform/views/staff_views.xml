<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_booking_staff_list" model="ir.ui.view">
        <field name="name">rn.booking.staff.list</field>
        <field name="model">rn.booking.staff</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="industry_id"/>
                <field name="commission_pct"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_booking_staff_form" model="ir.ui.view">
        <field name="name">rn.booking.staff.form</field>
        <field name="model">rn.booking.staff</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="industry_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="commission_pct"/>
                            <field name="timezone"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="location_ids" widget="many2many_tags"/>
                        <field name="service_ids" widget="many2many_tags"/>
                        <field name="note"/>
                    </group>
                    <field name="working_hour_ids">
                        <list editable="bottom">
                            <field name="dayofweek"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_booking_staff" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">rn.booking.staff</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
