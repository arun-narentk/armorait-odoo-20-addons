<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_booking_settings_form" model="ir.ui.view">
        <field name="name">rn.booking.settings.form</field>
        <field name="model">rn.booking.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="industry_id"/>
                        <field name="slot_interval_minutes"/>
                        <field name="default_buffer_minutes"/>
                        <field name="allow_guest_booking"/>
                        <field name="require_login"/>
                        <field name="advance_payment_required"/>
                        <field name="advance_payment_pct"/>
                        <field name="reminder_hours"/>
                        <field name="auto_invoice"/>
                        <field name="enable_email"/>
                        <field name="enable_sms"/>
                        <field name="enable_whatsapp"/>
                        <field name="timezone"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_booking_settings" model="ir.actions.act_window">
        <field name="name">Booking Settings</field>
        <field name="res_model">rn.booking.settings</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="res_config_settings_view_form_rn_booking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rn.booking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Appointment Booking" name="rn_booking_platform" groups="rn_booking_platform.group_rn_booking_manager">
                    <block title="General">
                        <setting string="Enable Booking Platform"><field name="rn_booking_enabled"/></setting>
                        <setting string="Slot Interval"><field name="rn_booking_slot_interval"/></setting>
                        <setting string="Allow Guest Booking"><field name="rn_booking_guest"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_rn_booking_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'rn_booking_platform'}</field>
    </record>
</odoo>
