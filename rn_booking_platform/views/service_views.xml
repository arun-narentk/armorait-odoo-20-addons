<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_booking_service_list" model="ir.ui.view">
        <field name="name">rn.booking.service.list</field>
        <field name="model">rn.booking.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="industry_id"/>
                <field name="duration_minutes"/>
                <field name="list_price"/>
                <field name="online_meeting"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rn_booking_service_form" model="ir.ui.view">
        <field name="name">rn.booking.service.form</field>
        <field name="model">rn.booking.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="industry_id"/>
                            <field name="duration_minutes"/>
                            <field name="buffer_before"/>
                            <field name="buffer_after"/>
                            <field name="list_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="online_meeting"/>
                            <field name="meeting_provider"/>
                            <field name="requires_resource"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="location_ids" widget="many2many_tags"/>
                        <field name="staff_ids" widget="many2many_tags"/>
                        <field name="resource_ids" widget="many2many_tags"/>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_booking_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">rn.booking.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
