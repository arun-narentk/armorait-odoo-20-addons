<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_booking">
        <field name="name">Appointment Booking</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_booking_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_booking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_booking_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_booking_readonly'))]"/>
    </record>
    <record id="group_rn_booking_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_booking_user'))]"/>
    </record>
    <record id="group_rn_booking_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_booking_staff'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
