<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Payroll to portal breadcrumbs when on payroll pages -->
    <template id="portal_breadcrumbs_payroll" name="Portal Breadcrumbs: Payroll" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//li[hasclass('breadcrumb-item')][1]" position="after">
            <li t-if="page_name == 'payroll'" class="breadcrumb-item">
                <a href="/my/payroll">Payroll</a>
            </li>
        </xpath>
    </template>


    <!-- Shown when HR Payroll is not installed -->
    <template id="portal_payroll_no_payroll" name="Payroll Portal: Payroll module required">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <div class="container py-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <h4 class="card-title">Payroll &amp; Payslips</h4>
                        <p class="text-muted mb-4">
                            To view your payslips here, your administrator needs to install the <strong>HR Payroll</strong> module
                            (Odoo Enterprise or a community payroll addon) and then install the <strong>Payroll Portal Pro (Payroll)</strong> extension.
                        </p>
                        <a href="/my" class="btn btn-primary">Back to My Account</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Dashboard: KPI cards, FY filter, monthly payslip cards -->
    <template id="portal_payroll_dashboard" name="Payroll Portal Dashboard">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True" no_breadcrumbs="False">
            <div class="o_portal_payroll_dashboard">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <h3 class="mb-0">Payroll &amp; Payslips</h3>
                    <form method="get" action="/my/payroll" class="d-flex gap-2 align-items-center flex-wrap">
                        <label class="form-label mb-0 small text-muted">Financial year</label>
                        <select name="fy_start" class="form-select form-select-sm" style="max-width: 8rem;" onchange="this.form.submit()">
                            <t t-foreach="financial_years" t-as="fy">
                                <option t-att-value="fy['date_start'].isoformat()"
                                    t-att-selected="date_start == fy['date_start']"
                                    t-out="fy['name']"/>
                            </t>
                        </select>
                    </form>
                </div>

                <!-- KPI cards -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm h-100 o_payroll_card o_payroll_card_gross">
                            <div class="card-body">
                                <div class="small text-muted text-uppercase mb-1">Gross Pay</div>
                                <div class="fs-4 fw-bold">
                                    <t t-out="format_value(selected_month_gross, currency)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm h-100 o_payroll_card o_payroll_card_net">
                            <div class="card-body">
                                <div class="small text-muted text-uppercase mb-1">Take Home</div>
                                <div class="fs-4 fw-bold">
                                    <t t-out="format_value(selected_month_net, currency)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm h-100 o_payroll_card o_payroll_card_ded">
                            <div class="card-body">
                                <div class="small text-muted text-uppercase mb-1">Deductions</div>
                                <div class="fs-4 fw-bold">
                                    <t t-out="format_value(selected_month_ded, currency)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tax summary -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="mb-0">Tax Summary (YTD)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6 col-md-4">
                                <span class="small text-muted">Taxable Income</span>
                                <div class="fw-bold"><t t-out="format_value(ytd_taxable_income, currency)"/></div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="small text-muted">Tax Paid</span>
                                <div class="fw-bold"><t t-out="format_value(ytd_tax_paid, currency)"/></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Monthly payslip cards -->
                <h5 class="mb-3">Payslips</h5>
                <t t-if="not months_list">
                    <p class="text-muted">No payslips for the selected financial year.</p>
                </t>
                <t t-else="">
                    <div class="row g-3">
                        <t t-foreach="months_list" t-as="mdata">
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card border-0 shadow-sm h-100 o_payroll_month_card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="card-title mb-0" t-out="mdata['month_name']"/> <t t-out="mdata['year']"/>
                                            <a t-att-href="'/my/payroll/%s' % mdata['payslips'][0].id" class="btn btn-sm btn-outline-primary">View</a>
                                        </div>
                                        <div class="small text-muted mb-2">Gross: <t t-out="format_value(mdata['gross'], currency)"/></div>
                                        <div class="o_payroll_progress_circle mb-2" t-att-style="'--o-payroll-pct: %s' % mdata.get('net_pct', 0)">
                                            <span class="o_payroll_progress_value" t-out="'%s%%' % int(mdata.get('net_pct', 0))"/>
                                        </div>
                                        <a t-att-href="'/my/payroll/%s' % mdata['payslips'][0].id" class="small">View breakdown</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Single payslip detail -->
    <template id="portal_payroll_detail" name="Payroll Payslip Detail">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <div class="o_portal_payroll_detail">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <a href="/my/payroll" class="btn btn-link btn-sm px-0">← Back to Payroll</a>
                </div>
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Payslip: <t t-out="payslip.name"/></h5>
                        <span class="badge bg-success" t-out="payslip.state"/>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            <t t-out="payslip.date_from"/> – <t t-out="payslip.date_to"/>
                        </p>
                        <div class="row mb-4">
                            <div class="col-6 col-md-3">
                                <div class="small text-muted">Gross</div>
                                <div class="fw-bold" t-out="format_value(totals['gross'], currency)"/>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-muted">Deductions</div>
                                <div class="fw-bold" t-out="format_value(totals['deductions'], currency)"/>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-muted">Tax</div>
                                <div class="fw-bold" t-out="format_value(totals['tax'], currency)"/>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-muted">Net</div>
                                <div class="fw-bold fs-5 text-success" t-out="format_value(totals['net'], currency)"/>
                            </div>
                        </div>
                        <t t-if="earnings">
                            <h6 class="mt-3">Earnings</h6>
                            <table class="table table-sm table-borderless">
                                <t t-foreach="earnings" t-as="line">
                                    <tr>
                                        <td t-out="line.name"/>
                                        <td class="text-end" t-out="format_value(line.total, currency)"/>
                                    </tr>
                                </t>
                            </table>
                        </t>
                        <t t-if="deductions">
                            <h6 class="mt-3">Deductions</h6>
                            <table class="table table-sm table-borderless">
                                <t t-foreach="deductions" t-as="line">
                                    <tr>
                                        <td t-out="line.name"/>
                                        <td class="text-end" t-out="format_value(line.total, currency)"/>
                                    </tr>
                                </t>
                            </table>
                        </t>
                        <t t-if="tax_lines">
                            <h6 class="mt-3">Tax</h6>
                            <table class="table table-sm table-borderless">
                                <t t-foreach="tax_lines" t-as="line">
                                    <tr>
                                        <td t-out="line.name"/>
                                        <td class="text-end" t-out="format_value(line.total, currency)"/>
                                    </tr>
                                </t>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
