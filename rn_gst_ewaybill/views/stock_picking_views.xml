<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_rn_gst_ewaybill" model="ir.ui.view">
        <field name="name">stock.picking.form.rn.gst.ewaybill</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="l10n_in_ewaybill_stock.view_picking_form_inherit_ewaybill"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_rn_open_close_ewaybill_wizard"
                        type="object"
                        string="Close EWB"
                        invisible="country_code != 'IN' or not l10n_in_ewaybill_ids"
                        groups="rn_gst_base.group_rn_gst_user"/>
            </xpath>
        </field>
    </record>
</odoo>
