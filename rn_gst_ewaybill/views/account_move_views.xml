<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_rn_gst_ewaybill" model="ir.ui.view">
        <field name="name">account.move.form.rn.gst.ewaybill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="rn_gst_einvoice.view_move_form_rn_gst_einvoice"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='rn_gst_einvoice']" position="inside">
                <group string="E-Way Bill Lifecycle">
                    <group>
                        <field name="rn_ewb_number"/>
                        <field name="rn_ewb_irn"/>
                        <field name="rn_ewb_status"/>
                        <field name="rn_ewb_generation_date"/>
                        <field name="rn_ewb_validity_date"/>
                        <field name="rn_ewb_vehicle_no"/>
                        <field name="rn_ewb_transporter_id"/>
                        <field name="rn_ewb_delivery_status"/>
                    </group>
                    <group string="Closure">
                        <field name="rn_ewb_closure_status"/>
                        <field name="rn_ewb_closure_requested"/>
                        <field name="rn_ewb_closure_date"/>
                        <field name="rn_ewb_closure_remarks"/>
                        <field name="rn_ewb_closure_user_id"/>
                        <field name="rn_ewb_closure_timestamp"/>
                        <field name="rn_ewb_closure_api_reference"/>
                        <field name="rn_ewb_closure_error"/>
                    </group>
                </group>
                <div class="oe_button_box">
                    <button name="action_rn_open_close_ewaybill_wizard"
                            type="object"
                            string="Close E-Way Bill"
                            class="btn-secondary"
                            invisible="not rn_ewb_number or rn_ewb_closure_status == 'closed' or rn_ewb_status in ('cancelled', 'discarded')"
                            groups="rn_gst_base.group_rn_gst_user"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
