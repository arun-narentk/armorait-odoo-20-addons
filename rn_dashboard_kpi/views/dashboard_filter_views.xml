<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rn_kpi_dashboard_filter" model="ir.actions.act_window">
        <field name="name">Dashboard Filters</field>
        <field name="res_model">rn.kpi.dashboard.filter</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_kpi_dashboard_filter_list" model="ir.ui.view">
        <field name="name">rn.kpi.dashboard.filter.list</field>
        <field name="model">rn.kpi.dashboard.filter</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="dashboard_id"/>
                <field name="filter_type"/>
                <field name="field_name"/>
                <field name="date_filter_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_kpi_dashboard_filter_form" model="ir.ui.view">
        <field name="name">rn.kpi.dashboard.filter.form</field>
        <field name="model">rn.kpi.dashboard.filter</field>
        <field name="arch" type="xml">
            <form string="Dashboard Filter">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="dashboard_id"/>
                            <field name="filter_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="field_id"/>
                            <field name="field_name"/>
                            <field name="operator"/>
                            <field name="value"/>
                            <field name="value_from"/>
                            <field name="value_to"/>
                            <field name="date_filter_type"/>
                            <field name="model_mapping"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
