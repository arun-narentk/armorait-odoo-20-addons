<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rn_kpi_dashboard_bookmark" model="ir.actions.act_window">
        <field name="name">Bookmarks</field>
        <field name="res_model">rn.kpi.dashboard.bookmark</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_kpi_dashboard_bookmark_list" model="ir.ui.view">
        <field name="name">rn.kpi.dashboard.bookmark.list</field>
        <field name="model">rn.kpi.dashboard.bookmark</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="dashboard_id"/>
                <field name="user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_kpi_dashboard_bookmark_form" model="ir.ui.view">
        <field name="name">rn.kpi.dashboard.bookmark.form</field>
        <field name="model">rn.kpi.dashboard.bookmark</field>
        <field name="arch" type="xml">
            <form string="Dashboard Bookmark">
                <sheet>
                    <group>
                        <field name="dashboard_id"/>
                        <field name="user_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
