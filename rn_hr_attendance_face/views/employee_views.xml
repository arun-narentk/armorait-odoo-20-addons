<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rn_hr_employee_face_list" model="ir.ui.view">
        <field name="name">rn.hr.employee.face.list</field>
        <field name="model">rn.hr.employee.face</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="status"/>
                <field name="photo_count"/>
                <field name="embedding_version"/>
                <field name="confidence"/>
                <field name="last_verified"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_hr_employee_face_form" model="ir.ui.view">
        <field name="name">rn.hr.employee.face.form</field>
        <field name="model">rn.hr.employee.face</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_enrollment" type="object" string="Register Face" class="btn-primary"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,enrolling,active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="registration_date"/>
                            <field name="photo_count"/>
                            <field name="angle_coverage"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="embedding_version"/>
                            <field name="confidence"/>
                            <field name="last_verified"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="face_embedding" groups="rn_hr_attendance_face.group_rn_face_admin" password="True"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rn_hr_employee_face" model="ir.actions.act_window">
        <field name="name">Employee Faces</field>
        <field name="res_model">rn.hr.employee.face</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
