<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rn_hr_register_face_wizard_form" model="ir.ui.view">
        <field name="name">rn.hr.register.face.wizard.form</field>
        <field name="model">rn.hr.register.face.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Face">
                <group>
                    <field name="employee_id"/>
                    <field name="face_id"/>
                    <field name="pose"/>
                    <field name="capture_count"/>
                    <field name="target_count"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_open_capture" type="object" string="Open Capture" class="btn-primary"/>
                    <button name="action_finalize" type="object" string="Save Profile"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_rn_hr_verify_face_wizard_form" model="ir.ui.view">
        <field name="name">rn.hr.verify.face.wizard.form</field>
        <field name="model">rn.hr.verify.face.wizard</field>
        <field name="arch" type="xml">
            <form string="Verify Face">
                <group>
                    <field name="employee_id"/>
                    <field name="face_id"/>
                    <field name="result"/>
                    <field name="confidence"/>
                </group>
                <footer>
                    <button name="action_verify" type="object" string="Verify" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rn_hr_register_face_wizard" model="ir.actions.act_window">
        <field name="name">Register Face</field>
        <field name="res_model">rn.hr.register.face.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
