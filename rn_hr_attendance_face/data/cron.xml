<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_rn_face_cleanup_images" model="ir.cron">
            <field name="name">Face Attendance: Cleanup Old Images</field>
            <field name="model_id" ref="model_rn_hr_face_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_old_images()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rn_face_archive_logs" model="ir.cron">
            <field name="name">Face Attendance: Archive Logs</field>
            <field name="model_id" ref="model_rn_hr_face_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_archive_logs()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rn_face_device_health" model="ir.cron">
            <field name="name">Face Attendance: Device Health Check</field>
            <field name="model_id" ref="model_rn_hr_face_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_device_health()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rn_face_embedding_optimize" model="ir.cron">
            <field name="name">Face Attendance: Embedding Optimization</field>
            <field name="model_id" ref="model_rn_hr_face_scheduler_service"/>
            <field name="state">code</field>
            <field name="code">model.cron_embedding_optimize()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
