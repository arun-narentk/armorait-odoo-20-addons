<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_smart_search" model="ir.ui.view">
        <field name="name">sale.order.form.smart.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <widget name="rn_smart_search_tracker" groups="rn_smart_search.group_rn_smart_search_user"/>
            </xpath>
        </field>
    </record>

