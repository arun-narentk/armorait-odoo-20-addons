<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_search_history_list" model="ir.ui.view">
        <field name="name">rn.search.history.list</field>
        <field name="model">rn.search.history</field>
        <field name="arch" type="xml">
            <list string="Search History" create="false">
                <field name="history_type"/>
                <field name="label"/>
                <field name="model_label"/>
                <field name="search_query"/>
                <field name="last_opened"/>
                <field name="open_count"/>
                <field name="is_favorite"/>
            </list>
        </field>
    </record>

    <record id="view_rn_search_history_form" model="ir.ui.view">
        <field name="name">rn.search.history.form</field>
        <field name="model">rn.search.history</field>
        <field name="arch" type="xml">
            <form string="Search History" create="false">
                <header>
                    <button name="action_toggle_favorite" type="object" string="Toggle Favorite" class="btn-secondary"/>
                    <button name="action_open_record" type="object" string="Open" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="history_type"/>
                            <field name="label"/>
                            <field name="model"/>
                            <field name="model_label"/>
                            <field name="record_id"/>
                            <field name="search_query"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="last_opened"/>
                            <field name="open_count"/>
                            <field name="is_favorite"/>
                            <field name="entry_key" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rn_search_history_search" model="ir.ui.view">
        <field name="name">rn.search.history.search</field>
        <field name="model">rn.search.history</field>
        <field name="arch" type="xml">
            <search string="Search History">
                <field name="label"/>
                <field name="search_query"/>
                <field name="model"/>
                <field name="model_label"/>
                <filter name="filter_favorites" string="Favorites" domain="[('is_favorite', '=', True)]"/>
                <filter name="filter_views" string="Views" domain="[('history_type', '=', 'view')]"/>
                <filter name="filter_searches" string="Searches" domain="[('history_type', '=', 'search')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'history_type'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rn_search_history" model="ir.actions.act_window">
        <field name="name">Search History</field>
        <field name="res_model">rn.search.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rn_search_history_search"/>
        <field name="context">{'search_default_filter_favorites': 0}</field>
    </record>

    <record id="action_rn_smart_search_workspace" model="ir.actions.client">
        <field name="name">Smart Search Workspace</field>
        <field name="tag">rn_smart_search.workspace</field>
    </record>
</odoo>
