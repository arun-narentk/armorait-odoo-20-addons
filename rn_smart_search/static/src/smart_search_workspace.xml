<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_smart_search.Workspace">
        <div class="o_rn_smart_search_workspace o_action p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="mb-1">Smart Search Workspace</h2>
                    <p class="text-muted mb-0">Recent records, searches, and favorites in one place.</p>
                </div>
                <button class="btn btn-primary" t-on-click="this.refresh" t-att-disabled="this.state.loading">
                    Refresh
                </button>
            </div>

            <div t-if="this.state.loading" class="text-muted">Loading workspace...</div>

            <div t-else="" class="row g-3">
                <div class="col-lg-4">
                    <div class="o_rn_smart_search_card card h-100">
                        <div class="card-header fw-bold">Favorites</div>
                        <ul class="list-group list-group-flush">
                            <t t-foreach="this.state.favorites" t-as="item" t-key="item.id">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <button class="btn btn-link p-0 text-start" t-on-click="() => this.openItem(item.id)">
                                        <t t-out="item.label"/>
                                    </button>
                                    <span class="badge text-bg-light" t-out="item.model_label || item.history_type"/>
                                </li>
                            </t>
                            <li t-if="!this.state.favorites.length" class="list-group-item text-muted">No favorites yet.</li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="o_rn_smart_search_card card h-100">
                        <div class="card-header fw-bold">Recent Views</div>
                        <ul class="list-group list-group-flush">
                            <t t-foreach="this.state.recent_views" t-as="item" t-key="item.id">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <button class="btn btn-link p-0 text-start" t-on-click="() => this.openItem(item.id)">
                                        <t t-out="item.label"/>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.toggleFavorite(item.id)">
                                        <i t-attf-class="fa #{item.is_favorite ? 'fa-star' : 'fa-star-o'}"/>
                                    </button>
                                </li>
                            </t>
                            <li t-if="!this.state.recent_views.length" class="list-group-item text-muted">Open a record to build history.</li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="o_rn_smart_search_card card h-100">
                        <div class="card-header fw-bold">Recent Searches</div>
                        <ul class="list-group list-group-flush">
                            <t t-foreach="this.state.recent_searches" t-as="item" t-key="item.id">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <button class="btn btn-link p-0 text-start" t-on-click="() => this.openItem(item.id)">
                                        <t t-out="item.search_query || item.label"/>
                                    </button>
                                    <span class="badge text-bg-light" t-out="item.open_count"/>
                                </li>
                            </t>
                            <li t-if="!this.state.recent_searches.length" class="list-group-item text-muted">Use Ctrl+K to save searches.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
