<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_smart_search.Systray">
        <div class="o_rn_smart_search_systray">
            <Dropdown position="'bottom-end'" menuClass="'o_rn_smart_search_systray_menu p-0'">
                <button class="btn btn-link o_nav_entry" title="Smart Search">
                    <i class="fa fa-history"/>
                </button>
                <t t-set-slot="content">
                    <div class="o_rn_smart_search_systray_panel">
                        <div class="o_rn_smart_search_systray_header px-3 py-2 border-bottom fw-bold">
                            Smart Search
                        </div>
                        <div class="o_rn_smart_search_systray_body">
                            <div t-if="this.state.loading" class="px-3 py-2 text-muted">Loading...</div>
                            <div t-else="">
                                <div class="px-3 py-2 small text-muted">Recent views</div>
                                <t t-foreach="this.state.recentViews" t-as="item" t-key="item.id">
                                    <button class="dropdown-item" t-on-click="() => this.openItem(item.id)">
                                        <t t-out="item.label"/>
                                    </button>
                                </t>
                                <div t-if="!this.state.recentViews.length" class="px-3 py-2 text-muted small">
                                    No recent records yet.
                                </div>
                                <div class="dropdown-divider"/>
                                <button class="dropdown-item fw-bold" t-on-click="this.openWorkspace">
                                    Open workspace
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
            </Dropdown>
        </div>
    </t>
</templates>
