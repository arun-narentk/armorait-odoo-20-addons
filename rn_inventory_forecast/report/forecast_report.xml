<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_rn_inv_forecast" model="ir.actions.report">
        <field name="name">Inventory Forecast Report</field>
        <field name="model">rn.inv.forecast.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_inventory_forecast.report_inv_forecast_document</field>
        <field name="binding_model_id" ref="model_rn_inv_forecast_run"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_inv_forecast_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>Inventory Forecast Report</h2>
                    <p><strong>Name:</strong> <span t-field="doc.name"/></p>
                    <p><strong>Period:</strong> <span t-field="doc.date_from"/> to <span t-field="doc.date_to"/></p>
                    <p><strong>Horizon:</strong> <span t-field="doc.horizon_days"/> days</p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Forecast</th>
                                <th>Safety</th>
                                <th>Reorder</th>
                                <th>Purchase Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.line_ids" t-as="line">
                                <td><span t-field="line.product_id"/></td>
                                <td><span t-field="line.forecast_qty"/></td>
                                <td><span t-field="line.safety_stock"/></td>
                                <td><span t-field="line.reorder_point"/></td>
                                <td><span t-field="line.recommended_purchase_qty"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
