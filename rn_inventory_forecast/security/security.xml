<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_inv_forecast">
        <field name="name">ARMORA Inventory Forecast</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_rn_inv_forecast_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_inv_forecast"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_inv_forecast_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_inv_forecast"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_inv_forecast_readonly'))]"/>
    </record>
    <record id="group_rn_inv_forecast_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_inv_forecast"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_inv_forecast_user'))]"/>
    </record>
    <record id="group_rn_inv_forecast_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_inv_forecast"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_inv_forecast_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    </odoo>
