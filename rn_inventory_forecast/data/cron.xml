<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
<record id="ir_cron_rn_inv_auto_forecast" model="ir.cron">
<field name="name">ARMORA Inventory Forecast: Auto Forecast</field>
<field name="model_id" ref="model_rn_inv_scheduler_service"/>
<field name="state">code</field>
<field name="code">model.cron_auto_forecast()</field>
<field name="interval_number">1</field>
<field name="interval_type">weeks</field>
<field name="active" eval="True"/>
</record>
<record id="ir_cron_rn_inv_analysis" model="ir.cron">
<field name="name">ARMORA Inventory Forecast: Analysis</field>
<field name="model_id" ref="model_rn_inv_scheduler_service"/>
<field name="state">code</field>
<field name="code">model.cron_run_analysis()</field>
<field name="interval_number">1</field>
<field name="interval_type">days</field>
<field name="active" eval="True"/>
</record>
<record id="ir_cron_rn_inv_alerts" model="ir.cron">
<field name="name">ARMORA Inventory Forecast: Scan Alerts</field>
<field name="model_id" ref="model_rn_inv_scheduler_service"/>
<field name="state">code</field>
<field name="code">model.cron_scan_alerts()</field>
<field name="interval_number">6</field>
<field name="interval_type">hours</field>
<field name="active" eval="True"/>
</record>
</data></odoo>
