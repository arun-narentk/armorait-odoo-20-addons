<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_inv_forecast_run_list" model="ir.ui.view">
        <field name="name">rn.inv.forecast.run.list</field>
        <field name="model">rn.inv.forecast.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="horizon_days"/>
                <field name="warehouse_id"/>
                <field name="line_count"/>
                <field name="accuracy_pct"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_rn_inv_forecast_run_form" model="ir.ui.view">
        <field name="name">rn.inv.forecast.run.form</field>
        <field name="model">rn.inv.forecast.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancel', 'done')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="period_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="horizon_days"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="accuracy_pct"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="history_qty"/>
                            <field name="avg_daily_demand"/>
                            <field name="forecast_qty"/>
                            <field name="qty_available"/>
                            <field name="coverage_days"/>
                            <field name="safety_stock"/>
                            <field name="reorder_point"/>
                            <field name="recommended_purchase_qty"/>
                            <field name="abc_class"/>
                            <field name="xyz_class"/>
                            <field name="fsn_class"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_inv_forecast_run" model="ir.actions.act_window">
        <field name="name">Forecast Runs</field>
        <field name="res_model">rn.inv.forecast.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_inv_forecast_line_list" model="ir.ui.view">
        <field name="name">rn.inv.forecast.line.list</field>
        <field name="model">rn.inv.forecast.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="run_id"/>
                <field name="product_id"/>
                <field name="forecast_qty"/>
                <field name="safety_stock"/>
                <field name="reorder_point"/>
                <field name="recommended_purchase_qty"/>
                <field name="recommended_purchase_date"/>
                <field name="vendor_id"/>
                <field name="abc_class"/>
                <field name="xyz_class"/>
                <field name="fsn_class"/>
                <field name="is_dead_stock"/>
            </list>
        </field>
    </record>
    <record id="action_rn_inv_forecast_line" model="ir.actions.act_window">
        <field name="name">Forecast Lines</field>
        <field name="res_model">rn.inv.forecast.line</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rn_inv_generate_forecast_wizard_form" model="ir.ui.view">
        <field name="name">rn.inv.generate.forecast.wizard.form</field>
        <field name="model">rn.inv.generate.forecast.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Forecast">
                <group>
                    <field name="period_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="horizon_days"/>
                    <field name="warehouse_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rn_inv_generate_forecast_wizard" model="ir.actions.act_window">
        <field name="name">Generate Forecast</field>
        <field name="res_model">rn.inv.generate.forecast.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_rn_inv_reorder_list" model="ir.ui.view">
        <field name="name">rn.inv.reorder.suggestion.list</field>
        <field name="model">rn.inv.reorder.suggestion</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="qty_to_order"/>
                <field name="recommended_date"/>
                <field name="vendor_id"/>
                <field name="safety_refill"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_inv_reorder_form" model="ir.ui.view">
        <field name="name">rn.inv.reorder.suggestion.form</field>
        <field name="model">rn.inv.reorder.suggestion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_ordered" type="object" string="Mark Ordered" class="btn-primary" invisible="state != 'recommended'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="warehouse_id"/>
                        <field name="vendor_id"/>
                        <field name="qty_to_order"/>
                        <field name="recommended_date"/>
                        <field name="lead_time_days"/>
                        <field name="safety_refill"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_inv_reorder_suggestion" model="ir.actions.act_window">
        <field name="name">Purchase Suggestions</field>
        <field name="res_model">rn.inv.reorder.suggestion</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rn_inv_safety_stock" model="ir.actions.act_window">
        <field name="name">Safety Stock</field>
        <field name="res_model">rn.inv.safety.stock</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
