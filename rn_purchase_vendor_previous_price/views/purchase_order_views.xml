<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_rn_previous_vendor_price" model="ir.ui.view">
        <field name="name">purchase.order.form.rn.previous.vendor.price</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="previous_vendor_price" optional="show" readonly="1"/>
                <field name="previous_vendor_price_date" optional="hide" readonly="1"/>
                <field name="previous_vendor_order_id" optional="hide" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="previous_vendor_price" readonly="1"/>
                <field name="previous_vendor_price_date" readonly="1"/>
                <field name="previous_vendor_order_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
