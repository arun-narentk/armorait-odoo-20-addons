<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_document_idp_settings_form" model="ir.ui.view">
        <field name="name">rn.document.idp.settings.form</field>
        <field name="model">rn.document.idp.settings</field>
        <field name="arch" type="xml">
            <form string="IDP Settings">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="credit_balance"/>
                        <field name="auto_post_confidence"/>
                    </group>
                    <group string="Validation">
                        <field name="enable_gst_india"/>
                        <field name="enable_duplicate_check"/>
                        <field name="enable_three_way_match"/>
                        <field name="qty_tolerance_percent"/>
                        <field name="price_tolerance_percent"/>
                        <field name="fraud_alert_threshold"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_document_idp_settings" model="ir.actions.act_window">
        <field name="name">IDP Settings</field>
        <field name="res_model">rn.document.idp.settings</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
