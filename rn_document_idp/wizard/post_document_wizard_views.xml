<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_document_idp_post_wizard_form" model="ir.ui.view">
        <field name="name">rn.document.idp.post.wizard.form</field>
        <field name="model">rn.document.idp.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Post to ERP">
                <group>
                    <field name="document_id" readonly="1"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm_post" type="object" string="Post" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
