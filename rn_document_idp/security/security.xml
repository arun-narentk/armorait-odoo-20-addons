<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_document_idp">
        <field name="name">AI Document Processing</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_document_idp_user" model="res.groups">
        <field name="name">IDP User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_document_idp"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_rn_document_idp_manager" model="res.groups">
        <field name="name">IDP Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_document_idp"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_document_idp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
