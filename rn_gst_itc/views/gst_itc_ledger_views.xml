<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rn_gst_itc_ledger_view_list" model="ir.ui.view">
        <field name="name">rn.gst.itc.ledger.list</field>
        <field name="model">rn.gst.itc.ledger</field>
        <field name="arch" type="xml">
            <list string="ITC Ledgers">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="gstin"/>
                <field name="financial_year"/>
                <field name="return_period"/>
                <field name="net_igst" optional="show"/>
                <field name="net_cgst" optional="show"/>
                <field name="net_sgst" optional="show"/>
                <field name="interest_total" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'computed'" decoration-success="state == 'locked'"/>
            </list>
        </field>
    </record>

    <record id="rn_gst_itc_ledger_view_form" model="ir.ui.view">
        <field name="name">rn.gst.itc.ledger.form</field>
        <field name="model">rn.gst.itc.ledger</field>
        <field name="arch" type="xml">
            <form string="ITC Ledger">
                <header>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"
                            invisible="state == 'locked'"
                            title="Read the month's vendor bills, apply Rules 37 and 42 and blocked credit, and reclaim paid Rule 37 reversals."/>
                    <button name="action_lock" type="object" string="Lock" invisible="state != 'computed'"
                            confirm="Lock this month? Later months use its reversals and closing balance."/>
                    <button name="action_unlock" type="object" string="Unlock" invisible="state != 'locked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,locked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="gstin" readonly="state != 'draft'"/>
                            <field name="financial_year" readonly="state != 'draft'" placeholder="2025-26"/>
                            <field name="return_period" readonly="state != 'draft'" placeholder="04"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="computed_at"/>
                            <field name="interest_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <group>
                            <group string="IGST">
                                <field name="availed_igst" string="Availed (4A)"/>
                                <field name="blocked_igst" string="Blocked 17(5)"/>
                                <field name="rule42_igst" string="Rule 42 reversal"/>
                                <field name="rule37_igst" string="Rule 37 reversal"/>
                                <field name="reclaimed_igst" string="Reclaimed (4D1)"/>
                                <field name="net_igst" string="Net ITC"/>
                            </group>
                            <group string="CGST">
                                <field name="availed_cgst" string="Availed (4A)"/>
                                <field name="blocked_cgst" string="Blocked 17(5)"/>
                                <field name="rule42_cgst" string="Rule 42 reversal"/>
                                <field name="rule37_cgst" string="Rule 37 reversal"/>
                                <field name="reclaimed_cgst" string="Reclaimed (4D1)"/>
                                <field name="net_cgst" string="Net ITC"/>
                            </group>
                            <group string="SGST/UTGST">
                                <field name="availed_sgst" string="Availed (4A)"/>
                                <field name="blocked_sgst" string="Blocked 17(5)"/>
                                <field name="rule42_sgst" string="Rule 42 reversal"/>
                                <field name="rule37_sgst" string="Rule 37 reversal"/>
                                <field name="reclaimed_sgst" string="Reclaimed (4D1)"/>
                                <field name="net_sgst" string="Net ITC"/>
                            </group>
                            <group string="Cess">
                                <field name="availed_cess" string="Availed (4A)"/>
                                <field name="blocked_cess" string="Blocked 17(5)"/>
                                <field name="rule42_cess" string="Rule 42 reversal"/>
                                <field name="rule37_cess" string="Rule 37 reversal"/>
                                <field name="reclaimed_cess" string="Reclaimed (4D1)"/>
                                <field name="net_cess" string="Net ITC"/>
                            </group>
                            </group>
                        </page>
                        <page string="Electronic Credit Ledger" name="credit_ledger">
                            <div class="text-muted mb-2">
                                Opening is the closing of the previous computed month. Credit used comes from this month's GSTR-3B.
                            </div>
                            <group>
                            <group string="IGST">
                                <field name="opening_igst" string="Opening"/>
                                <field name="net_igst" string="Net ITC"/>
                                <field name="utilized_igst" string="Used in GSTR-3B"/>
                                <field name="closing_igst" string="Closing"/>
                            </group>
                            <group string="CGST">
                                <field name="opening_cgst" string="Opening"/>
                                <field name="net_cgst" string="Net ITC"/>
                                <field name="utilized_cgst" string="Used in GSTR-3B"/>
                                <field name="closing_cgst" string="Closing"/>
                            </group>
                            <group string="SGST/UTGST">
                                <field name="opening_sgst" string="Opening"/>
                                <field name="net_sgst" string="Net ITC"/>
                                <field name="utilized_sgst" string="Used in GSTR-3B"/>
                                <field name="closing_sgst" string="Closing"/>
                            </group>
                            <group string="Cess">
                                <field name="opening_cess" string="Opening"/>
                                <field name="net_cess" string="Net ITC"/>
                                <field name="utilized_cess" string="Used in GSTR-3B"/>
                                <field name="closing_cess" string="Closing"/>
                            </group>
                            </group>
                            <group string="Opening balance for the first month" invisible="previous_ledger_id">
                                <field name="previous_ledger_id" invisible="1"/>
                                <field name="opening_manual_igst" string="IGST"/>
                                <field name="opening_manual_cgst" string="CGST"/>
                                <field name="opening_manual_sgst" string="SGST/UTGST"/>
                                <field name="opening_manual_cess" string="Cess"/>
                            </group>
                        </page>
                        <page string="ITC Register" name="register">
                            <field name="bill_ids" readonly="1">
                                <list>
                                    <field name="invoice_date"/>
                                    <field name="move_id"/>
                                    <field name="partner_id"/>
                                    <field name="vendor_gstin" optional="show"/>
                                    <field name="bill_total" sum="Total"/>
                                    <field name="paid_amount" sum="Total"/>
                                    <field name="itc_total" sum="Total"/>
                                    <field name="blocked_total" sum="Total" optional="show"/>
                                    <field name="common_total" sum="Total" optional="show"/>
                                    <field name="gstr2b_status" widget="badge"
                                           decoration-success="gstr2b_status == 'matched'"
                                           decoration-warning="gstr2b_status == 'mismatch'"
                                           decoration-danger="gstr2b_status == 'not_in_2b'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rule 37 Reversals and Reclaims" name="entries">
                            <field name="entry_ids" readonly="1">
                                <list>
                                    <field name="entry_type"/>
                                    <field name="move_id"/>
                                    <field name="partner_id"/>
                                    <field name="invoice_date"/>
                                    <field name="bill_total"/>
                                    <field name="unpaid_amount"/>
                                    <field name="igst" sum="Total"/>
                                    <field name="cgst" sum="Total"/>
                                    <field name="sgst" sum="Total"/>
                                    <field name="cess" sum="Total" optional="hide"/>
                                    <field name="interest" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rule 42" name="rule42">
                            <div class="text-muted mb-2">
                                Common credit is reversed in the share of exempt, nil rated and non-GST turnover in the
                                month's total turnover. Mark common credit with the ITC Type column on the bill lines.
                            </div>
                            <group>
                                <group>
                                    <field name="turnover_exempt"/>
                                    <field name="turnover_total"/>
                                    <field name="rule42_ratio"/>
                                </group>
                                <group>
                                    <field name="common_igst"/>
                                    <field name="common_cgst"/>
                                    <field name="common_sgst"/>
                                    <field name="common_cess"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rn_gst_itc_ledger_view_search" model="ir.ui.view">
        <field name="name">rn.gst.itc.ledger.search</field>
        <field name="model">rn.gst.itc.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="gstin"/>
                <field name="financial_year"/>
                <filter string="Locked" name="locked" domain="[('state', '=', 'locked')]"/>
                <group>
                    <filter string="Financial Year" name="group_fy" context="{'group_by': 'financial_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rn_gst_itc_ledger_action" model="ir.actions.act_window">
        <field name="name">ITC Ledger</field>
        <field name="res_model">rn.gst.itc.ledger</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the ITC ledger of a month</p>
            <p>Compute it after posting the month's vendor bills. It applies Rules 37 and 42 and blocked credit,
               and keeps the electronic credit ledger balance from month to month.</p>
        </field>
    </record>

    <record id="rn_gst_itc_entry_view_list" model="ir.ui.view">
        <field name="name">rn.gst.itc.entry.list</field>
        <field name="model">rn.gst.itc.entry</field>
        <field name="arch" type="xml">
            <list string="Rule 37 Reversals and Reclaims">
                <field name="reversal_date"/>
                <field name="ledger_id"/>
                <field name="entry_type"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="unpaid_amount"/>
                <field name="total" sum="Total"/>
                <field name="interest" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="rn_gst_itc_entry_view_search" model="ir.ui.view">
        <field name="name">rn.gst.itc.entry.search</field>
        <field name="model">rn.gst.itc.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="partner_id"/>
                <filter string="Reversals" name="reversals" domain="[('entry_type', '=', 'rule37')]"/>
                <filter string="Reclaims" name="reclaims" domain="[('entry_type', '=', 'reclaim')]"/>
                <group>
                    <filter string="Supplier" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rn_gst_itc_entry_action" model="ir.actions.act_window">
        <field name="name">Rule 37 Reversals and Reclaims</field>
        <field name="res_model">rn.gst.itc.entry</field>
        <field name="view_mode">list</field>
    </record>

    <record id="rn_gst_itc_bill_view_list" model="ir.ui.view">
        <field name="name">rn.gst.itc.bill.list</field>
        <field name="model">rn.gst.itc.bill</field>
        <field name="arch" type="xml">
            <list string="ITC Register">
                <field name="ledger_id"/>
                <field name="invoice_date"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="bill_total" sum="Total"/>
                <field name="paid_amount" sum="Total"/>
                <field name="itc_total" sum="Total"/>
                <field name="blocked_total" sum="Total" optional="show"/>
                <field name="common_total" sum="Total" optional="show"/>
                <field name="gstr2b_status"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="rn_gst_itc_bill_view_search" model="ir.ui.view">
        <field name="name">rn.gst.itc.bill.search</field>
        <field name="model">rn.gst.itc.bill</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="partner_id"/>
                <filter string="Not in GSTR-2B" name="not_in_2b" domain="[('gstr2b_status', '=', 'not_in_2b')]"/>
                <filter string="2B Mismatch" name="mismatch" domain="[('gstr2b_status', '=', 'mismatch')]"/>
                <group>
                    <filter string="Ledger" name="group_ledger" context="{'group_by': 'ledger_id'}"/>
                    <filter string="Supplier" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rn_gst_itc_bill_action" model="ir.actions.act_window">
        <field name="name">ITC Register</field>
        <field name="res_model">rn.gst.itc.bill</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
