<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_rn_formula_fields" model="ir.ui.view">
        <field name="name">product.template.form.rn.formula.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Formula Fields" groups="rn_formula_fields.group_rn_formula_user">
                    <group><field name="x_rn_formula_margin" readonly="1"/><field name="x_rn_formula_profit_pct" readonly="1"/></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
