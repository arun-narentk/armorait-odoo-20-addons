<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_formula_field_list" model="ir.ui.view">
        <field name="name">rn.formula.field.list</field><field name="model">rn.formula.field</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="model_name"/><field name="field_name"/><field name="field_type"/><field name="active"/></list></field>
    </record>
    <record id="view_rn_formula_field_form" model="ir.ui.view">
        <field name="name">rn.formula.field.form</field><field name="model">rn.formula.field</field>
        <field name="arch" type="xml"><form><header><button name="action_open_test_wizard" type="object" string="Test Formula" class="btn-primary"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="model_id"/><field name="field_name"/><field name="field_type"/><field name="active"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="ir_field_id" readonly="1"/></group></group><group><field name="expression" widget="text"/><field name="field_dependencies"/></group><div class="alert alert-info" role="alert">Use field names, numeric values, arithmetic operators, comparisons, and approved functions: abs, min, max, round, floor, ceil.</div></sheet><chatter/></form></field>
    </record>
    <record id="action_rn_formula_field" model="ir.actions.act_window"><field name="name">Formula Fields</field><field name="res_model">rn.formula.field</field><field name="view_mode">list,form</field></record>
</odoo>
