<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_name_batch_wizard_form" model="ir.ui.view">
        <field name="name">rn.name.batch.wizard.form</field>
        <field name="model">rn.name.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Name Generation">
                <group invisible="state == 'done'">
                    <field name="res_model" readonly="1"/>
                    <field name="res_ids" readonly="1"/>
                    <field name="max_suggestions"/>
                </group>
                <field name="state" invisible="1"/>
                <field name="result_ids" invisible="state != 'done'">
                    <list create="0" delete="0">
                        <field name="res_id"/>
                        <field name="current_name"/>
                        <field name="suggested_name"/>
                        <field name="all_suggestions"/>
                    </list>
                </field>
                <group invisible="not export_file">
                    <field name="export_filename" invisible="1"/>
                    <field name="export_file" filename="export_filename"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_export_csv" type="object" string="Export CSV" class="btn-secondary" invisible="state != 'done'"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
