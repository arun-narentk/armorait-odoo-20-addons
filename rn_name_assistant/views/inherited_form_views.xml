<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_name_assistant" model="ir.ui.view">
        <field name="name">product.template.form.name.assistant</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_suggest_name"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-magic"
                        string="Suggest Name"
                        groups="rn_name_assistant.group_rn_name_assistant_user"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Naming" groups="rn_name_assistant.group_rn_name_assistant_user">
                    <group>
                        <group>
                            <field name="rn_brand"/>
                            <field name="rn_series"/>
                            <field name="rn_model_number"/>
                            <field name="rn_color"/>
                        </group>
                        <group>
                            <field name="rn_capacity"/>
                            <field name="rn_material"/>
                            <field name="rn_variant_label"/>
                            <field name="rn_size"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_tree_name_assistant" model="ir.ui.view">
        <field name="name">product.template.tree.name.assistant</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_product_batch_suggest_names" model="ir.actions.server">
        <field name="name">Generate Suggested Names</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_suggest_names()</field>
        <field name="group_ids" eval="[(4, ref('rn_name_assistant.group_rn_name_assistant_user'))]"/>
    </record>

    <record id="view_res_partner_form_name_assistant" model="ir.ui.view">
        <field name="name">res.partner.form.name.assistant</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_suggest_name"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-magic"
                        string="Suggest Name"
                        groups="rn_name_assistant.group_rn_name_assistant_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_form_name_assistant" model="ir.ui.view">
        <field name="name">crm.lead.form.name.assistant</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_suggest_name"
                        type="object"
                        string="Suggest Name"
                        class="btn-secondary"
                        icon="fa-magic"
                        groups="rn_name_assistant.group_rn_name_assistant_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_project_form_name_assistant" model="ir.ui.view">
        <field name="name">project.project.form.name.assistant</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_suggest_name"
                        type="object"
                        string="Suggest Name"
                        class="btn-secondary"
                        icon="fa-magic"
                        groups="rn_name_assistant.group_rn_name_assistant_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_form_name_assistant" model="ir.ui.view">
        <field name="name">project.task.form.name.assistant</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_suggest_name"
                        type="object"
                        string="Suggest Name"
                        class="btn-secondary"
                        icon="fa-magic"
                        groups="rn_name_assistant.group_rn_name_assistant_user"/>
            </xpath>
        </field>
    </record>
</odoo>
