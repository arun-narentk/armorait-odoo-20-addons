<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_name_template_tree" model="ir.ui.view">
        <field name="name">rn.name.template.tree</field>
        <field name="model">rn.name.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="template_body"/>
                <field name="priority"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rn_name_template_form" model="ir.ui.view">
        <field name="name">rn.name.template.form</field>
        <field name="model">rn.name.template</field>
        <field name="arch" type="xml">
            <form string="Name Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="template_body" placeholder="{Brand} {Series} {Model} {Category}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="condition_domain" widget="domain" options="{'model': 'model_name'}"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Variant Templates">
                            <field name="variant_template_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="template_body"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_name_template" model="ir.actions.act_window">
        <field name="name">Name Templates</field>
        <field name="res_model">rn.name.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rn_name_abbreviation_tree" model="ir.ui.view">
        <field name="name">rn.name.abbreviation.tree</field>
        <field name="model">rn.name.abbreviation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="short_form"/>
                <field name="expansion"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_rn_name_abbreviation" model="ir.actions.act_window">
        <field name="name">Abbreviations</field>
        <field name="res_model">rn.name.abbreviation</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
