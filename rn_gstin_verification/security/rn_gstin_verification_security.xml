<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_rn_gstin_verification" model="res.groups.privilege">
        <field name="name">GSTIN Verification</field>
        <field name="category_id" ref="rn_gst_base.module_category_rn_gst"/>
    </record>

    <record id="group_rn_gstin_verification_user" model="res.groups">
        <field name="name">GSTIN Verification User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gstin_verification"/>
        <field name="implied_ids" eval="[(4, ref('rn_gst_base.group_rn_gst_user'))]"/>
    </record>

    <record id="group_rn_gstin_verification_manager" model="res.groups">
        <field name="name">GSTIN Verification Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gstin_verification"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gstin_verification_user')), (4, ref('rn_gst_base.group_rn_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
