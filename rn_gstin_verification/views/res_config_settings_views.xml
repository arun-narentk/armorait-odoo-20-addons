<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rn.gstin.verification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rn_gst_base.view_rn_gst_base_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='rn_gst_base_settings']" position="inside">
                <setting string="GSTIN Re-check" help="Days after which a customer or vendor GSTIN is due for a new portal or manual check.">
                    <field name="rn_gstin_recheck_days"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
