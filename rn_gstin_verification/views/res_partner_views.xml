<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.rn.gstin.verification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_rn_gstin_view_checks" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        invisible="not rn_gstin_check_count" groups="rn_gstin_verification.group_rn_gstin_verification_user">
                    <field name="rn_gstin_check_count" widget="statinfo" string="GSTIN Checks"/>
                </button>
            </div>
            <xpath expr="//div[@name='identifiers']" position="after">
                <label for="rn_gstin_status" string="GSTIN Check" invisible="rn_gstin_status == 'no_gstin' or parent_id"
                       groups="rn_gstin_verification.group_rn_gstin_verification_user"/>
                <div class="o_row" invisible="rn_gstin_status == 'no_gstin' or parent_id"
                     groups="rn_gstin_verification.group_rn_gstin_verification_user">
                    <field name="rn_gstin_status" widget="badge" nolabel="1"
                           decoration-success="rn_gstin_status == 'active'" decoration-info="rn_gstin_status == 'format_ok'"
                           decoration-danger="rn_gstin_status in ('inactive', 'format_invalid')"
                           decoration-warning="rn_gstin_status in ('unavailable', 'not_checked')"/>
                    <button name="action_rn_gstin_check" type="object" string="Check" class="btn btn-link p-0"
                            icon="fa-search"/>
                    <button name="action_rn_gstin_manual_check" type="object" string="Record portal check"
                            class="btn btn-link p-0" icon="fa-pencil"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.rn.gstin.verification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="rn_gstin_status" optional="hide" widget="badge"
                       decoration-success="rn_gstin_status == 'active'" decoration-info="rn_gstin_status == 'format_ok'"
                       decoration-danger="rn_gstin_status in ('inactive', 'format_invalid')"
                       decoration-warning="rn_gstin_status in ('unavailable', 'not_checked')"/>
                <field name="rn_gstin_verified_on" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">res.partner.select.inherit.rn.gstin.verification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="GSTIN Re-check Due" name="rn_gstin_recheck_due" domain="[('rn_gstin_recheck_due', '=', True)]"/>
                <filter string="GSTIN Not Checked" name="rn_gstin_not_checked" domain="[('rn_gstin_status', '=', 'not_checked')]"/>
                <filter string="GSTIN Not Active or Invalid" name="rn_gstin_bad"
                        domain="[('rn_gstin_status', 'in', ('inactive', 'format_invalid'))]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="GSTIN Check Status" name="group_rn_gstin_status" context="{'group_by': 'rn_gstin_status'}"/>
            </xpath>
        </field>
    </record>

    <record id="rn_gstin_partner_view_list" model="ir.ui.view">
        <field name="name">res.partner.list.rn.gstin.verification</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Partners by GSTIN Status" create="false">
                <header>
                    <button name="action_rn_gstin_check" type="object" string="Check GSTIN"/>
                </header>
                <field name="complete_name" string="Name"/>
                <field name="vat" string="GSTIN"/>
                <field name="state_id" optional="show"/>
                <field name="rn_gstin_checked_on" optional="show"/>
                <field name="rn_gstin_verified_on" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="rn_gstin_status" widget="badge"
                       decoration-success="rn_gstin_status == 'active'" decoration-info="rn_gstin_status == 'format_ok'"
                       decoration-danger="rn_gstin_status in ('inactive', 'format_invalid')"
                       decoration-warning="rn_gstin_status in ('unavailable', 'not_checked')"/>
            </list>
        </field>
    </record>

    <record id="rn_gstin_partner_action" model="ir.actions.act_window">
        <field name="name">Partners by GSTIN Status</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('rn_gstin_status', '!=', 'no_gstin'), ('parent_id', '=', False)]</field>
        <field name="context">{'search_default_rn_gstin_recheck_due': 1}</field>
        <field name="view_id" ref="rn_gstin_partner_view_list"/>
    </record>
</odoo>
