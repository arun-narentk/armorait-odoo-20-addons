<odoo>
    <record id="res_groups_privilege_armora_gst_dashboard" model="res.groups.privilege">
        <field name="name">Dashboard</field>
        <field name="category_id" ref="armora_gst_base.module_category_armora_gst"/>
    </record>

    <record id="group_armora_gst_dashboard_user" model="res.groups">
        <field name="name">Dashboard User</field>
        <field name="privilege_id" ref="res_groups_privilege_armora_gst_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('armora_gst_base.group_armora_gst_user'))]"/>
    </record>

    <record id="group_armora_gst_dashboard_manager" model="res.groups">
        <field name="name">Dashboard Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_armora_gst_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_armora_gst_dashboard_user')), (4, ref('armora_gst_base.group_armora_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_armora_gst_dashboard_administrator" model="res.groups">
        <field name="name">Dashboard Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_armora_gst_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_armora_gst_dashboard_manager')), (4, ref('armora_gst_base.group_armora_gst_administrator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
