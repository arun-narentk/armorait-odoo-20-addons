<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
    <record id="dup_rule_contacts" model="rn.dup.rule">
        <field name="name">Contacts by Email and Name</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="record_domain">[('is_company', '=', False)]</field>
        <field name="match_threshold">85</field>
        <field name="auto_scan" eval="True"/>
        <field name="field_line_ids" eval="[
            (0, 0, {'field_name': 'email', 'match_type': 'exact', 'weight': 60}),
            (0, 0, {'field_name': 'name', 'match_type': 'fuzzy', 'weight': 40}),
        ]"/>
    </record>

    <record id="dup_rule_products" model="rn.dup.rule">
        <field name="name">Products by Name and Reference</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="match_threshold">80</field>
        <field name="field_line_ids" eval="[
            (0, 0, {'field_name': 'name', 'match_type': 'fuzzy', 'weight': 70}),
            (0, 0, {'field_name': 'default_code', 'match_type': 'exact', 'weight': 30}),
        ]"/>
    </record>

    <record id="dup_rule_employees" model="rn.dup.rule">
        <field name="name">Employees by Email and Name</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="match_threshold">85</field>
        <field name="field_line_ids" eval="[
            (0, 0, {'field_name': 'work_email', 'match_type': 'exact', 'weight': 60}),
            (0, 0, {'field_name': 'name', 'match_type': 'fuzzy', 'weight': 40}),
        ]"/>
    </record>
</data></odoo>
