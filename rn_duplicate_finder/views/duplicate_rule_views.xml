<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_dup_rule_list" model="ir.ui.view">
        <field name="name">rn.dup.rule.list</field>
        <field name="model">rn.dup.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="match_threshold"/>
                <field name="auto_scan"/>
                <field name="last_match_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_rn_dup_rule_form" model="ir.ui.view">
        <field name="name">rn.dup.rule.form</field>
        <field name="model">rn.dup.rule</field>
        <field name="arch" type="xml">
            <form string="Duplicate Rule">
                <header>
                    <button name="action_run_scan" type="object" string="Run Scan" class="btn-primary"
                        groups="rn_duplicate_finder.group_rn_dup_finder_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_run_scan" type="object" class="oe_stat_button" icon="fa-search"
                            groups="rn_duplicate_finder.group_rn_dup_finder_manager">
                            <field name="scan_count" widget="statinfo" string="Scans"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rule name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="model_name" invisible="1"/>
                            <field name="match_threshold"/>
                            <field name="batch_limit"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="auto_scan"/>
                            <field name="active"/>
                            <field name="last_scan_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Filter">
                        <field name="record_domain" widget="domain" options="{'model': 'model_name'}"/>
                    </group>
                    <notebook>
                        <page string="Matching Fields">
                            <field name="field_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_name"/>
                                    <field name="match_type"/>
                                    <field name="weight"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scans">
                            <field name="scan_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="scan_date"/>
                                    <field name="state"/>
                                    <field name="record_count"/>
                                    <field name="match_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rn_dup_rule" model="ir.actions.act_window">
        <field name="name">Duplicate Rules</field>
        <field name="res_model">rn.dup.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
