<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rn_filter_folder_sales" model="rn.filter.folder">
        <field name="name">Sales</field>
        <field name="color">green</field>
        <field name="icon">fa-shopping-cart</field>
        <field name="sequence">10</field>
    </record>
    <record id="rn_filter_folder_invoices" model="rn.filter.folder">
        <field name="name">Invoices</field>
        <field name="color">blue</field>
        <field name="icon">fa-file-text-o</field>
        <field name="sequence">20</field>
    </record>
    <record id="rn_filter_folder_crm" model="rn.filter.folder">
        <field name="name">CRM</field>
        <field name="color">orange</field>
        <field name="icon">fa-users</field>
        <field name="sequence">30</field>
        <field name="is_team">True</field>
    </record>

    <record id="rn_filter_demo_confirmed_sales" model="ir.filters">
        <field name="name">FILTCAP Confirmed Sales</field>
        <field name="model_id">sale.order</field>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="context">{}</field>
        <field name="sort">[]</field>
        <field name="rn_folder_id" ref="rn_filter_folder_sales"/>
        <field name="rn_is_favorite">True</field>
        <field name="rn_is_pinned">True</field>
        <field name="rn_color">green</field>
        <field name="rn_share_type">favorite</field>
        <field name="rn_icon">fa-check</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="rn_filter_demo_draft_sales" model="ir.filters">
        <field name="name">FILTCAP Draft Sales</field>
        <field name="model_id">sale.order</field>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="context">{}</field>
        <field name="sort">[]</field>
        <field name="rn_folder_id" ref="rn_filter_folder_sales"/>
        <field name="rn_is_favorite">True</field>
        <field name="rn_color">blue</field>
        <field name="rn_share_type">private</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="rn_filter_demo_overdue_invoices" model="ir.filters">
        <field name="name">FILTCAP Overdue Invoices</field>
        <field name="model_id">account.move</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('payment_state', '!=', 'paid')]</field>
        <field name="context">{}</field>
        <field name="sort">[]</field>
        <field name="rn_folder_id" ref="rn_filter_folder_invoices"/>
        <field name="rn_is_pinned">True</field>
        <field name="rn_color">red</field>
        <field name="rn_share_type">company</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
