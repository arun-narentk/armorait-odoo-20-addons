<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_filter_folder_list" model="ir.ui.view">
        <field name="name">rn.filter.folder.list</field>
        <field name="model">rn.filter.folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="color"/>
                <field name="filter_count"/>
                <field name="is_team"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rn_filter_folder_form" model="ir.ui.view">
        <field name="name">rn.filter.folder.form</field>
        <field name="model">rn.filter.folder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_filters" type="object" string="Open Filters" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_filters" type="object" class="oe_stat_button" icon="fa-filter">
                            <field name="filter_count" widget="statinfo" string="Filters"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="is_team"/>
                            <field name="owner_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="child_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="filter_count"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rn_filter_folder_kanban" model="ir.ui.view">
        <field name="name">rn.filter.folder.kanban</field>
        <field name="model">rn.filter.folder</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="color"/>
                <field name="filter_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="filter_count"/> filters</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_rn_filter_folder" model="ir.actions.act_window">
        <field name="name">Filter Folders</field>
        <field name="res_model">rn.filter.folder</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
