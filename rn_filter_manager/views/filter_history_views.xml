<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_filter_history_list" model="ir.ui.view">
        <field name="name">rn.filter.history.list</field>
        <field name="model">rn.filter.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="used_at desc">
                <field name="used_at"/>
                <field name="filter_id"/>
                <field name="model_id"/>
                <field name="source"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_rn_filter_recent" model="ir.actions.act_window">
        <field name="name">Recent Filters</field>
        <field name="res_model">rn.filter.history</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
</odoo>
