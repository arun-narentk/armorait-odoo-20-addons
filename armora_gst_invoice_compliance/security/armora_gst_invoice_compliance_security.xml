<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_armora_gst_invoice_compliance" model="res.groups.privilege">
        <field name="name">Invoice Compliance</field>
        <field name="category_id" ref="armora_gst_base.module_category_armora_gst"/>
    </record>

    <record id="group_armora_gst_invoice_compliance_user" model="res.groups">
        <field name="name">Invoice Compliance User</field>
        <field name="privilege_id" ref="res_groups_privilege_armora_gst_invoice_compliance"/>
        <field name="implied_ids" eval="[(4, ref('armora_gst_base.group_armora_gst_user'))]"/>
    </record>

    <record id="group_armora_gst_invoice_compliance_manager" model="res.groups">
        <field name="name">Invoice Compliance Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_armora_gst_invoice_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_armora_gst_invoice_compliance_user')), (4, ref('armora_gst_base.group_armora_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
