<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_hospital_core.HospitalDashboard">
        <div class="o_rn_hospital_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2 class="mb-0">Hospital Dashboard</h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="" class="row g-3">
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">OPD Today</div><div class="fs-3" t-out="this.state.opdToday"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">IP Admissions</div><div class="fs-3" t-out="this.state.ipAdmissions"/></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Bed Occupancy</div><div class="fs-3"><t t-out="this.formatNumber(this.state.bedOccupancy)"/>%</div></div></div>
                <div class="col-md-3"><div class="card p-3"><div class="text-muted">Revenue Today</div><div class="fs-3" t-out="this.formatNumber(this.state.revenueToday)"/></div></div>
                <div class="col-12"><div class="card p-3"><div class="text-muted">Waiting Patients</div><div class="fs-4" t-out="this.state.waitingPatients"/></div></div>
            </div>
        </div>
    </t>
</templates>
