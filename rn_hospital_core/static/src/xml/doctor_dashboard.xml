<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_hospital_core.DoctorDashboard">
        <div class="o_rn_doctor_dashboard o_action p-3">
            <div class="d-flex justify-content-between mb-3">
                <h2 class="mb-0">Doctor Dashboard <small t-if="this.state.doctorName" t-out="this.state.doctorName"/></h2>
                <button class="btn btn-secondary" t-on-click="this.refresh">Refresh</button>
            </div>
            <div t-if="this.state.loading">Loading...</div>
            <div t-else="">
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><div class="card p-3"><div class="text-muted">Appointments Today</div><div class="fs-3" t-out="this.state.appointmentsToday"/></div></div>
                    <div class="col-md-4"><div class="card p-3"><div class="text-muted">In Consultation</div><div class="fs-3" t-out="this.state.inConsultation"/></div></div>
                </div>
                <h4>OPD Queue</h4>
                <ul class="list-group">
                    <li class="list-group-item" t-foreach="this.state.queue" t-as="item" t-key="item.id">
                        Token <t t-out="item.token"/> - <t t-out="item.patient"/> (<t t-out="item.uhid"/>) - <t t-out="item.state"/>
                    </li>
                </ul>
            </div>
        </div>
    </t>
</templates>
