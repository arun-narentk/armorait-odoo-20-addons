<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hospital_encounter_tree" model="ir.ui.view">
        <field name="name">rn.hospital.emr.encounter.tree</field>
        <field name="model">rn.hospital.emr.encounter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="encounter_datetime"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hospital_encounter_form" model="ir.ui.view">
        <field name="name">rn.hospital.emr.encounter.form</field>
        <field name="model">rn.hospital.emr.encounter</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_ai_scribe" type="object" string="AI Scribe"/>
                    <button name="action_generate_discharge_summary" type="object" string="AI Discharge Draft"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="department_id"/>
                        <field name="encounter_datetime"/>
                        <field name="encounter_type"/>
                    </group>
                    <field name="chief_complaint"/>
                    <field name="consultation_notes"/>
                    <field name="ai_scribe_notes"/>
                    <notebook>
                        <page string="Diagnosis">
                            <field name="diagnosis_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prescription">
                            <field name="prescription_ids">
                                <list editable="bottom">
                                    <field name="medicine_name"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration_days"/>
                                    <field name="ai_warning"/>
                                </list>
                            </field>
                        </page>
                        <page string="Discharge">
                            <field name="discharge_summary"/>
                            <field name="ai_discharge_draft"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hospital_encounter" model="ir.actions.act_window">
        <field name="name">EMR Encounters</field>
        <field name="res_model">rn.hospital.emr.encounter</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
