<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hospital_settings_form" model="ir.ui.view">
        <field name="name">rn.hospital.settings.form</field>
        <field name="model">rn.hospital.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="uhid_prefix"/>
                        <field name="token_reset_daily"/>
                        <field name="ai_scribe_enabled"/>
                        <field name="ai_prescription_hints"/>
                        <field name="require_consent_on_admission"/>
                        <field name="default_consultation_product_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rn_hospital_settings" model="ir.actions.act_window">
        <field name="name">Hospital Settings</field>
        <field name="res_model">rn.hospital.settings</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
