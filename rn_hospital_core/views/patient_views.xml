<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hospital_patient_tree" model="ir.ui.view">
        <field name="name">rn.hospital.patient.tree</field>
        <field name="model">rn.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="uhid"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="age"/>
                <field name="gender"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hospital_patient_form" model="ir.ui.view">
        <field name="name">rn.hospital.patient.form</field>
        <field name="model">rn.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="uhid" readonly="1"/>
                        <field name="name"/>
                        <field name="gender"/>
                        <field name="date_of_birth"/>
                        <field name="age"/>
                        <field name="blood_group"/>
                        <field name="mobile"/>
                        <field name="email"/>
                    </group>
                    <group>
                        <field name="emergency_contact"/>
                        <field name="emergency_phone"/>
                        <field name="partner_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Allergies">
                            <field name="allergy_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Conditions">
                            <field name="condition_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="diagnosed_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Insurance">
                            <field name="insurance_ids">
                                <list editable="bottom">
                                    <field name="insurer_name"/>
                                    <field name="policy_number"/>
                                    <field name="valid_to"/>
                                </list>
                            </field>
                        </page>
                        <page string="Family">
                            <field name="family_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="relation"/>
                                    <field name="mobile"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">rn.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
