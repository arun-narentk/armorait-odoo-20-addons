<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_hospital_appointment_tree" model="ir.ui.view">
        <field name="name">rn.hospital.appointment.tree</field>
        <field name="model">rn.hospital.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_datetime"/>
                <field name="token_number"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rn_hospital_appointment_form" model="ir.ui.view">
        <field name="name">rn.hospital.appointment.form</field>
        <field name="model">rn.hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object" string="Check In" invisible="state not in ('draft','confirmed')"/>
                    <button name="action_start_consultation" type="object" string="Start Consultation" invisible="state != 'waiting'"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'in_consultation'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="department_id"/>
                        <field name="appointment_datetime"/>
                        <field name="token_number" readonly="1"/>
                        <field name="appointment_type"/>
                    </group>
                    <field name="chief_complaint"/>
                    <field name="encounter_id" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rn_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">rn.hospital.appointment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
