<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_doctor" model="ir.ui.view">
        <field name="name">hr.employee.form.hospital</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Clinical" groups="rn_hospital_core.group_rn_hospital_doctor">
                    <group>
                        <field name="is_doctor"/>
                        <field name="medical_registration"/>
                        <field name="specialization"/>
                        <field name="rn_hospital_department_id"/>
                        <field name="consultation_fee"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_rn_hospital_doctor_schedule" model="ir.actions.act_window">
        <field name="name">Doctor Schedules</field>
        <field name="res_model">rn.hospital.doctor.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
